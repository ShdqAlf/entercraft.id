---
---

<section class="contact-section" aria-labelledby="contact-form-title">
  <div class="contact-container">
    <div class="contact-context animate-contact" style="animation-delay: 120ms;">
      <div class="contact-eyebrow"><span class="eyebrow-dot">●</span> LET'S TALK</div>
      <h2>Mulai dari masalahnya.</h2>
      <p class="context-copy">
        Setiap bisnis memiliki tantangan yang berbeda. Ceritakan proses yang ingin Anda perbaiki, pekerjaan yang ingin diotomatisasi, atau sistem yang ingin dikembangkan.
      </p>

      <ul class="reassurance-list" aria-label="Our approach">
        <li><span class="check-mark" aria-hidden="true">✓</span> Business-first approach</li>
        <li><span class="check-mark" aria-hidden="true">✓</span> Solutions tailored to your needs</li>
        <li><span class="check-mark" aria-hidden="true">✓</span> Start with a conversation</li>
      </ul>

      <div class="context-note">
        <span class="note-line"></span>
        <p>No pressure. Just a conversation.</p>
      </div>
    </div>

    <div class="contact-form-card animate-contact" style="animation-delay: 220ms;">
      <div class="form-state" data-form-state="form">
        <div class="form-eyebrow">TELL US ABOUT YOUR CHALLENGE</div>
        <h2 id="contact-form-title">Ceritakan kebutuhan Anda.</h2>
        <p class="form-intro">Berikan gambaran singkat. Kami akan membantu mengurai langkah berikutnya.</p>

        <form data-contact-form novalidate>
          <div class="field-grid">
            <div class="field-group">
              <label for="contact-name">Nama <span aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Nama Anda" minlength="2" required aria-describedby="name-error" />
              <p class="field-error" id="name-error" data-error-for="name"></p>
            </div>
            <div class="field-group">
              <label for="contact-email">Email Bisnis <span aria-hidden="true">*</span></label>
              <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="nama@perusahaan.com" required aria-describedby="email-error" />
              <p class="field-error" id="email-error" data-error-for="email"></p>
            </div>
          </div>

          <div class="field-group">
            <label for="contact-company">Nama Perusahaan <span aria-hidden="true">*</span></label>
            <input id="contact-company" name="company" type="text" autocomplete="organization" placeholder="Nama perusahaan Anda" required aria-describedby="company-error" />
            <p class="field-error" id="company-error" data-error-for="company"></p>
          </div>

          <div class="field-grid">
            <div class="field-group">
              <label for="contact-role">Posisi / Jabatan</label>
              <select id="contact-role" name="role">
                <option value="">Pilih posisi Anda</option>
                <option>Owner / Founder</option>
                <option>Director / Executive</option>
                <option>Manager</option>
                <option>Operations</option>
                <option>Marketing</option>
                <option>IT / Technology</option>
                <option>Other</option>
                <option>Prefer not to say</option>
              </select>
            </div>
            <div class="field-group">
              <label for="contact-service">Apa yang sedang Anda butuhkan? <span aria-hidden="true">*</span></label>
              <select id="contact-service" name="service" required aria-describedby="service-help service-error">
                <option value="">Pilih kebutuhan Anda</option>
                <option value="Belum yakin / Ingin konsultasi">Belum yakin / Ingin konsultasi</option>
                <option>Website / Web Application</option>
                <option>Mobile Application</option>
                <option>AI & Automation</option>
                <option>System Integration</option>
                <option>Custom Information System</option>
                <option>Digital Marketing</option>
                <option>Business Process Improvement</option>
              </select>
              <p class="field-help" id="service-help">Pilih yang paling mendekati kebutuhan Anda.</p>
              <p class="field-error" id="service-error" data-error-for="service"></p>
            </div>
          </div>

          <div class="field-group">
            <label for="contact-challenge">Ceritakan sedikit tentang tantangannya <span aria-hidden="true">*</span></label>
            <textarea id="contact-challenge" name="challenge" rows="5" maxlength="1000" minlength="20" placeholder="Contoh: Saat ini proses approval masih dilakukan melalui spreadsheet dan WhatsApp sehingga membutuhkan banyak pekerjaan manual..." required aria-describedby="challenge-count challenge-error"></textarea>
            <div class="field-meta"><span class="field-error" id="challenge-error" data-error-for="challenge"></span><span class="character-count" id="challenge-count">0 / 1000</span></div>
          </div>

          <div class="field-grid">
            <div class="field-group">
              <label for="contact-timeline">Kapan kira-kira Anda ingin mulai?</label>
              <select id="contact-timeline" name="timeline">
                <option value="">Pilih timeline</option>
                <option>Secepatnya</option>
                <option>1–3 bulan</option>
                <option>3–6 bulan</option>
                <option>Masih eksplorasi</option>
              </select>
            </div>
            <div class="field-group">
              <label for="contact-whatsapp">Nomor WhatsApp</label>
              <input id="contact-whatsapp" name="whatsapp" type="tel" autocomplete="tel" placeholder="+62..." aria-describedby="whatsapp-help" />
              <p class="field-help" id="whatsapp-help">Opsional — jika Anda lebih nyaman dihubungi melalui WhatsApp.</p>
            </div>
          </div>

          <label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
          <label class="consent-control"><input name="consent" type="checkbox" required aria-describedby="consent-error" /><span>Dengan mengirimkan form ini, Anda menyetujui Entercraft.id menghubungi Anda terkait kebutuhan yang disampaikan.</span></label>
          <p class="field-error consent-error" id="consent-error" data-error-for="consent"></p>

          <div class="field-group turnstile-container" style="margin: 14px 0 6px;">
            <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA'} data-theme="auto"></div>
            <p class="field-error turnstile-error" id="turnstile-error" data-error-for="cf-turnstile-response" style="margin-top: 6px;"></p>
          </div>

          <button class="submit-button" type="submit">
            <span class="button-label">Diskusikan Kebutuhan Saya <span aria-hidden="true">→</span></span>
            <span class="button-loading" aria-hidden="true"><span class="spinner"></span> Sending...</span>
          </button>
          <div class="alternate-contact">
            <span class="alternate-divider"><span>atau</span></span>
            <a class="whatsapp-button" href="https://api.whatsapp.com/send?phone=62895344929185&amp;text=Halo%20Entercraft.id%2C%20saya%20ingin%20konsultasi%20mengenai%20layanan%20digital%20perusahaan" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.53 0 .2 5.32.2 11.87c0 2.09.55 4.13 1.59 5.93L.1 24l6.34-1.66a11.86 11.86 0 0 0 5.64 1.43h.01c6.55 0 11.87-5.32 11.87-11.87 0-3.17-1.23-6.14-3.44-8.42Zm-8.44 18.24h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.67-.23-.38a9.85 9.85 0 0 1-1.5-5.2C2.19 6.43 6.62 2 12.08 2c2.65 0 5.14 1.04 7.01 2.92a9.84 9.84 0 0 1 2.9 7c0 5.47-4.44 9.8-9.91 9.8Zm5.42-7.36c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.09 4.49.71.31 1.26.49 1.69.62.71.23 1.35.2 1.86.12.57-.09 1.76-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z" />
              </svg>
              Hubungi via WhatsApp
            </a>
          </div>
          <p class="form-error" role="alert" data-form-error></p>
          <p class="form-microcopy">Tanpa komitmen. Mulai dari percakapan.</p>
        </form>
      </div>

      <div class="form-state success-state" data-form-state="success" hidden>
        <div class="success-icon" aria-hidden="true">✓</div>
        <div class="form-eyebrow">MESSAGE RECEIVED</div>
        <h2>Thanks. We've Got It.</h2>
        <p>Terima kasih telah berbagi kebutuhan Anda. Tim Entercraft.id akan meninjau informasi yang Anda sampaikan dan menghubungi Anda untuk membahas langkah berikutnya.</p>
        <div class="success-actions">
          <a href="/" class="submit-button success-primary">Kembali ke Homepage <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="form-state error-state" data-form-state="error" hidden>
        <div class="form-eyebrow">SEND ERROR</div>
        <h2>Something went wrong.</h2>
        <p>Pesan Anda belum berhasil dikirim. Silakan coba lagi atau hubungi kami secara langsung.</p>
        <button class="text-link try-again" type="button">Try Again</button>
      </div>
    </div>
  </div>

  <div class="direct-contact animate-contact" style="animation-delay: 320ms;">
    <div>
      <div class="direct-eyebrow">PREFER TO TALK DIRECTLY?</div>
      <p>Tim kami siap mendengarkan kebutuhan bisnis Anda.</p>
    </div>
    <div class="direct-links">
      <a href="https://api.whatsapp.com/send?phone=62895344929185&amp;text=Halo%20Entercraft.id%2C%20saya%20ingin%20konsultasi%20mengenai%20layanan%20digital%20perusahaan" target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">→</span></a>
      <a href="mailto:admin@entercraft.id">Email <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
    padding: 92px 24px 110px;
    background: var(--bg-primary);
  }

  .contact-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.42;
    background-image: linear-gradient(rgba(57, 132, 255, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(57, 132, 255, 0.035) 1px, transparent 1px);
    background-size: 58px 58px;
  }

  .contact-container,
  .direct-contact { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; }
  .contact-container { display: grid; grid-template-columns: 0.62fr 1fr; gap: 76px; align-items: start; }
  .contact-context { padding-top: 28px; }
  .contact-eyebrow, .form-eyebrow, .direct-eyebrow { color: var(--accent-blue); font: 700 11px/1.2 'Plus Jakarta Sans', sans-serif; letter-spacing: 1.6px; }
  .eyebrow-dot { font-size: 8px; margin-right: 6px; }
  .contact-context h2, .contact-form-card h2 { margin: 18px 0 18px; color: var(--text-primary); font: 800 48px/1.06 'Plus Jakarta Sans', sans-serif; letter-spacing: -1.5px; }
  .context-copy { max-width: 390px; color: var(--text-secondary); font: 15px/1.75 'Inter', sans-serif; }
  .reassurance-list { display: grid; gap: 15px; list-style: none; padding: 0; margin: 34px 0 0; color: var(--text-primary); font: 600 13px/1.4 'Plus Jakarta Sans', sans-serif; }
  .check-mark { display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 8px; border: 1px solid var(--accent-blue); border-radius: 50%; color: var(--accent-blue); font-size: 12px; }
  .context-note { display: flex; gap: 12px; align-items: center; margin-top: 58px; color: var(--text-muted); }
  .note-line { width: 28px; height: 1px; background: var(--accent-blue); opacity: 0.7; }
  .context-note p { margin: 0; font: 11px/1.4 'Inter', sans-serif; letter-spacing: 0.3px; }

  .contact-form-card { min-width: 0; padding: 38px; border: 1px solid #1b2a42; border-radius: 12px; background: #080e19; box-shadow: 0 18px 55px rgba(0, 0, 0, 0.18); }
  .form-intro { margin: -6px 0 28px; color: var(--text-secondary); font: 14px/1.6 'Inter', sans-serif; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field-group { min-width: 0; margin-bottom: 18px; }
  .field-group label { display: block; margin-bottom: 8px; color: #d7e0f0; font: 600 12px/1.4 'Plus Jakarta Sans', sans-serif; }
  .field-group label > span { color: var(--accent-blue); }
  input, select, textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--border-color); border-radius: 8px; outline: none; background: #05070d; color: var(--text-primary); font: 14px/1.5 'Inter', sans-serif; transition: border-color 180ms ease, box-shadow 180ms ease; }
  input, select { min-height: 46px; padding: 11px 13px; }
  textarea { min-height: 140px; resize: vertical; padding: 12px 13px; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #7f95b8 50%), linear-gradient(135deg, #7f95b8 50%, transparent 50%); background-position: calc(100% - 17px) 20px, calc(100% - 12px) 20px; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; padding-right: 34px; }
  input::placeholder, textarea::placeholder { color: var(--text-muted); }
  input:focus, select:focus, textarea:focus { border-color: var(--accent-blue); box-shadow: 0 0 0 2px rgba(57, 132, 255, 0.1); }
  .field-group.has-error input, .field-group.has-error select, .field-group.has-error textarea { border-color: #ff7b7b; }
  .field-help, .field-error, .character-count { margin: 6px 0 0; font: 11px/1.4 'Inter', sans-serif; }
  .field-help, .character-count { color: var(--text-muted); }
  .field-error { min-height: 0; color: #ff7b7b; }
  .field-meta { display: flex; justify-content: space-between; gap: 12px; }
  .field-meta .field-error { flex: 1; }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .consent-control { display: flex; gap: 10px; align-items: flex-start; margin: 2px 0 6px; color: var(--text-muted); font: 11px/1.55 'Inter', sans-serif; }
  .consent-control input { width: 15px; min-height: 15px; margin-top: 1px; accent-color: var(--accent-blue); }
  .consent-error { margin-left: 25px; }
  .submit-button { display: inline-flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin-top: 14px; padding: 14px 22px; border: 0; border-radius: 8px; background: var(--accent-blue); color: #fff; cursor: pointer; font: 700 14px/1 'Plus Jakarta Sans', sans-serif; text-decoration: none; transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .submit-button:hover { background: var(--accent-bright); transform: translateY(-1px); box-shadow: 0 8px 22px rgba(57, 132, 255, 0.25); }
  .submit-button:disabled { cursor: wait; opacity: 0.72; transform: none; }
  .alternate-contact { display: grid; gap: 12px; margin-top: 18px; }
  .alternate-divider { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font: 11px/1 'Inter', sans-serif; text-align: center; }
  .alternate-divider::before, .alternate-divider::after { content: ''; height: 1px; flex: 1; background: var(--border-color); }
  .whatsapp-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 12px 18px; border: 1px solid #2f9e61; border-radius: 8px; background: transparent; color: #45c979; font: 700 13px/1 'Plus Jakarta Sans', sans-serif; text-decoration: none; transition: background 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease; }
  .whatsapp-button svg { width: 17px; height: 17px; fill: currentColor; }
  .whatsapp-button:hover { background: rgba(69, 201, 121, 0.1); border-color: #45c979; color: #67df94; transform: translateY(-1px); }
  .button-loading { display: none; align-items: center; gap: 9px; }
  .is-loading .button-label { display: none; }
  .is-loading .button-loading { display: inline-flex; }
  .spinner { width: 13px; height: 13px; border: 2px solid rgba(255,255,255,0.35); border-top-color: #fff; border-radius: 50%; animation: spin 700ms linear infinite; }
  .form-error { min-height: 17px; margin: 10px 0 0; color: #ff7b7b; font: 12px/1.4 'Inter', sans-serif; }
  .form-microcopy { margin: 13px 0 0; color: var(--text-muted); text-align: center; font: 11px/1.4 'Inter', sans-serif; }
  .direct-contact { display: flex; align-items: center; justify-content: space-between; gap: 30px; margin-top: 66px; padding-top: 27px; border-top: 1px solid var(--border-color); }
  .direct-contact p { margin: 9px 0 0; color: var(--text-secondary); font: 13px/1.5 'Inter', sans-serif; }
  .direct-links { display: flex; gap: 25px; }
  .direct-links a, .text-link { color: var(--accent-blue); font: 700 13px/1.5 'Plus Jakarta Sans', sans-serif; text-decoration: none; }
  .direct-links a:hover, .text-link:hover { color: var(--accent-bright); }
  .success-state, .error-state { min-height: 430px; display: flex; flex-direction: column; justify-content: center; }
  .form-state[hidden] { display: none !important; }
  .success-state h2, .error-state h2 { font-size: 38px; }
  .success-state p, .error-state p { max-width: 520px; color: var(--text-secondary); font: 15px/1.7 'Inter', sans-serif; }
  .success-icon { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 26px; border: 1px solid var(--accent-blue); border-radius: 50%; color: var(--accent-blue); font-size: 23px; animation: success-in 500ms ease both; }
  .success-actions { display: grid; gap: 16px; margin-top: 24px; max-width: 310px; }
  .success-primary { margin: 0; }
  .try-again { width: fit-content; margin-top: 20px; padding: 0; border: 0; background: none; cursor: pointer; }
  .animate-contact { opacity: 0; transform: translateY(15px); animation: contact-in 650ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  :global(html[data-theme="light"]) .contact-form-card {
    background: #ffffff;
    border-color: #e2e8f0;
    box-shadow: 0 18px 55px rgba(15, 23, 42, 0.08);
  }
  :global(html[data-theme="light"]) .contact-form-card .form-intro,
  :global(html[data-theme="light"]) .contact-form-card .success-state p,
  :global(html[data-theme="light"]) .contact-form-card .error-state p {
    color: #475569;
  }
  :global(html[data-theme="light"]) .contact-form-card .field-group label {
    color: #0f172a;
  }
  :global(html[data-theme="light"]) .contact-form-card input,
  :global(html[data-theme="light"]) .contact-form-card select,
  :global(html[data-theme="light"]) .contact-form-card textarea {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }
  :global(html[data-theme="light"]) .contact-form-card input::placeholder,
  :global(html[data-theme="light"]) .contact-form-card textarea::placeholder {
    color: #64748b;
  }
  :global(html[data-theme="light"]) .contact-form-card .consent-control,
  :global(html[data-theme="light"]) .contact-form-card .field-help,
  :global(html[data-theme="light"]) .contact-form-card .character-count,
  :global(html[data-theme="light"]) .contact-form-card .form-microcopy {
    color: #64748b;
  }
  :global(html[data-theme="light"]) .contact-form-card .alternate-divider { color: #64748b; }
  :global(html[data-theme="light"]) .contact-form-card .whatsapp-button { color: #168a4b; border-color: #36a765; }
  :global(html[data-theme="light"]) .contact-form-card .whatsapp-button:hover { color: #0f6f3b; background: #ecfdf3; border-color: #168a4b; }
  @keyframes contact-in { to { opacity: 1; transform: translateY(0); } }
  @keyframes success-in { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .animate-contact, .success-icon { animation: none; opacity: 1; transform: none; } .spinner { animation: none; } }
  @media (max-width: 900px) { .contact-container { grid-template-columns: 1fr; gap: 42px; } .contact-context { padding-top: 0; } .context-copy { max-width: 600px; } .context-note { margin-top: 30px; } }
  @media (max-width: 600px) { .contact-section { padding: 70px 20px 78px; } .contact-context h2, .contact-form-card h2 { font-size: 36px; } .contact-form-card { padding: 24px; } .field-grid { grid-template-columns: 1fr; gap: 0; } .direct-contact { align-items: flex-start; flex-direction: column; margin-top: 48px; } .direct-links { flex-direction: column; gap: 10px; } }
</style>

<script>
  const contactForm = document.querySelector('[data-contact-form]');
  const formCard = document.querySelector('.contact-form-card');

  if (contactForm && formCard) {
    const formElement = contactForm as HTMLFormElement;
    const submitButton = formElement.querySelector('.submit-button') as HTMLButtonElement;
    const textarea = formElement.querySelector('#contact-challenge') as HTMLTextAreaElement;
    const count = formElement.querySelector('#challenge-count');
    const formError = formElement.querySelector('[data-form-error]');
    const fields = Array.from(formElement.querySelectorAll('input, select, textarea')) as Array<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>;
    const touched = new Set<string>();

    const validators: Record<string, (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => string> = {
      name: (field) => field.value.trim().length >= 2 ? '' : 'Silakan masukkan nama Anda.',
      email: (field) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value.trim()) ? '' : 'Masukkan alamat email yang valid.',
      company: (field) => field.value.trim() ? '' : 'Silakan masukkan nama perusahaan.',
      service: (field) => field.value ? '' : 'Pilih kebutuhan yang paling mendekati.',
      challenge: (field) => field.value.trim().length >= 20 ? '' : 'Ceritakan sedikit tentang kebutuhan atau tantangan Anda.',
      consent: (field) => (field as HTMLInputElement).checked ? '' : 'Persetujuan diperlukan untuk melanjutkan.'
    };

    const updateCount = () => { if (count) count.textContent = `${textarea.value.length} / 1000`; };
    const showError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, message: string) => {
      const group = field.closest('.field-group');
      const error = formElement.querySelector(`[data-error-for="${field.name}"]`);
      group?.classList.toggle('has-error', Boolean(message));
      if (error) error.textContent = message;
      if (message) field.setAttribute('aria-invalid', 'true'); else field.removeAttribute('aria-invalid');
    };
    const validateField = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const validator = validators[field.name];
      const message = validator ? validator(field) : '';
      if (touched.has(field.name)) showError(field, message);
      return message;
    };
    const validateForm = () => {
      let firstInvalidName: string | null = null;
      let valid = true;
      for (const field of fields) {
        if (field.name === 'cf-turnstile-response') continue;
        if (validators[field.name]) touched.add(field.name);
        const message = validateField(field);
        if (message && !firstInvalidName) firstInvalidName = field.name;
        if (message) valid = false;
      }
      const invalidField = firstInvalidName ? fields.find((field) => field.name === firstInvalidName) : null;
      if (invalidField && firstInvalidName) { showError(invalidField, validators[firstInvalidName](invalidField)); invalidField.focus(); }

      const turnstileResponse = formElement.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      const turnstileError = formElement.querySelector('#turnstile-error');
      if (!turnstileResponse?.value) {
        if (turnstileError) turnstileError.textContent = 'Silakan selesaikan verifikasi keamanan.';
        valid = false;
      } else {
        if (turnstileError) turnstileError.textContent = '';
      }
      return valid;
    };

    fields.forEach((field) => {
      if (field.name === 'cf-turnstile-response') return;
      field.addEventListener('blur', () => { touched.add(field.name); validateField(field); });
      field.addEventListener('input', () => { if (field === textarea) updateCount(); if (touched.has(field.name)) validateField(field); });
      field.addEventListener('change', () => { if (touched.has(field.name)) validateField(field); });
    });
    updateCount();

const N8N_WEBHOOK_URL =
  import.meta.env.PUBLIC_N8N_WEBHOOK_URL || 'http://localhost:5678/webhook-test/entercraft-contact';

const submitLead = async (
  payload: Record<string, string | boolean>
) => {
  const response = await fetch(N8N_WEBHOOK_URL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(payload),
  });

  if (!response.ok) {
    throw new Error('Gagal mengirim data ke n8n');
  }

  return response.json().catch(() => null);
};

    formElement.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validateForm()) return;
      if ((formElement.elements.namedItem('website') as HTMLInputElement)?.value) return;
      formError!.textContent = '';
      submitButton.disabled = true;
      submitButton.classList.add('is-loading');
      const data = new FormData(formElement);
      const payload = Object.fromEntries(data.entries()) as Record<string, string | boolean>;
      payload.consent = (data.get('consent') === 'on');
      try {
        await submitLead(payload);
        formCard.querySelector('[data-form-state="form"]')?.setAttribute('hidden', 'true');
        formCard.querySelector('[data-form-state="success"]')?.removeAttribute('hidden');
        (window as any).turnstile?.reset();
      } catch {
        formCard.querySelector('[data-form-state="form"]')?.setAttribute('hidden', 'true');
        formCard.querySelector('[data-form-state="error"]')?.removeAttribute('hidden');
        (window as any).turnstile?.reset();
      } finally {
        submitButton.disabled = false;
        submitButton.classList.remove('is-loading');
      }
    });

    formCard.querySelector('.try-again')?.addEventListener('click', () => {
      formCard.querySelector('[data-form-state="error"]')?.setAttribute('hidden', 'true');
      formCard.querySelector('[data-form-state="form"]')?.removeAttribute('hidden');
    });
  }
</script>
