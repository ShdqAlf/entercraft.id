---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, heroImage, readingTime } = post.data;
const slug = post.id;
---

<section class="featured-insight-section">
  <div class="featured-card">
    <div class="featured-grid">
      <!-- Left: Large Image -->
      <a href={`/blog/${slug}/`} class="featured-image-link">
        <div class="featured-image-container">
          {heroImage ? (
            <img src={typeof heroImage === 'string' ? heroImage : heroImage.src} alt={title} class="featured-img" />
          ) : (
            <div class="placeholder-img" />
          )}
        </div>
      </a>

      <!-- Right: Content -->
      <div class="featured-content">
        <span class="featured-category">{category}</span>
        <h2 class="featured-title">
          <a href={`/blog/${slug}/`}>{title}</a>
        </h2>
        <p class="featured-description">{description}</p>
        <div class="featured-footer">
          <span class="featured-meta">
            <FormattedDate date={pubDate} /> · {readingTime}
          </span>
          <a href={`/blog/${slug}/`} class="featured-cta">Read Article <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-insight-section {
    margin-bottom: 60px;
    width: 100%;
    box-sizing: border-box;
  }

  .featured-card {
    background-color: #080E19;
    border: 1px solid #263653;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.30s ease, box-shadow 0.30s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .featured-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 4px 30px rgba(57, 132, 255, 0.08);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr; /* desktop split: around 55 / 45 */
    width: 100%;
    box-sizing: border-box;
  }

  .featured-image-link {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    overflow: hidden;
  }

  .featured-image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .featured-card:hover .featured-img {
    transform: scale(1.02);
  }

  .placeholder-img {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0b1424 0%, #102c50 100%);
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px;
    box-sizing: border-box;
  }

  .featured-category {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    margin-bottom: 16px;
  }

  .featured-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 16px 0;
  }

  .featured-title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-title a:hover {
    color: var(--accent-blue);
  }

  .featured-description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 28px 0;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid rgba(38, 54, 83, 0.4);
    margin-top: auto;
  }

  .featured-meta {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--text-muted);
  }

  .featured-cta {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .featured-card:hover .featured-cta {
    color: var(--accent-blue);
  }

  .featured-cta .arrow {
    transition: transform 0.2s ease;
  }

  .featured-cta:hover .arrow {
    transform: translateX(3px);
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
    .featured-image-link {
      min-height: auto;
    }
    .featured-content {
      padding: 30px;
    }
    .featured-title {
      font-size: 24px;
    }
  }

  /* Light theme overrides */
  :global(html[data-theme="light"]) .featured-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
  }
  :global(html[data-theme="light"]) .featured-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 10px 30px rgba(0, 85, 255, 0.06);
  }
  :global(html[data-theme="light"]) .featured-title a {
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .featured-title a:hover {
    color: var(--accent-blue);
  }
  :global(html[data-theme="light"]) .featured-description {
    color: #475569;
  }
  :global(html[data-theme="light"]) .featured-footer {
    border-top-color: #F1F5F9;
  }
  :global(html[data-theme="light"]) .featured-meta {
    color: #64748B;
  }
  :global(html[data-theme="light"]) .featured-cta {
    color: #334155;
  }
  :global(html[data-theme="light"]) .featured-card:hover .featured-cta {
    color: var(--accent-blue);
  }
</style>
