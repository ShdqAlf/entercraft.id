---
interface Props {
  title: string;
  url?: string;
}

const { title } = Astro.props;
---

<div class="share-container">
  <span class="share-label">Share this article:</span>
  <div class="share-buttons">
    <!-- LinkedIn -->
    <a 
      href="#" 
      class="share-btn linkedin-btn" 
      aria-label="Share on LinkedIn"
      target="_blank"
      data-share-type="linkedin"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
        <rect x="2" y="9" width="4" height="12"></rect>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a 
      href="#" 
      class="share-btn whatsapp-btn" 
      aria-label="Share on WhatsApp"
      target="_blank"
      data-share-type="whatsapp"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
    </a>

    <!-- Copy Link -->
    <button 
      class="share-btn copy-btn" 
      aria-label="Copy article link"
      id="copyLinkBtn"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <span class="copy-text">Copy Link</span>
    </button>
  </div>
</div>

<style>
  .share-container {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    margin: 40px 0;
  }

  .share-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--blue-dark-10);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: 6px;
    width: 34px;
    height: 34px;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    box-sizing: border-box;
  }

  .share-btn:hover {
    background: var(--blue-dark-1b);
    border-color: var(--accent-blue);
    color: #FFFFFF;
  }

  .share-btn.copy-btn {
    width: auto;
    padding: 0 14px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11.5px;
    font-weight: 700;
  }

  .share-btn.copy-btn.copied {
    background-color: rgba(57, 213, 232, 0.15) !important;
    border-color: #39D5E8 !important;
    color: #39D5E8 !important;
  }

  /* Light theme overrides */
  :global(html[data-theme="light"]) .share-container {
    border-top-color: #E2E8F0;
    border-bottom-color: #E2E8F0;
  }
  :global(html[data-theme="light"]) .share-label {
    color: #475569;
  }
  :global(html[data-theme="light"]) .share-btn {
    background: #FFFFFF;
    border-color: #E2E8F0;
    color: #475569;
  }
  :global(html[data-theme="light"]) .share-btn:hover {
    background: #F1F5F9;
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }
  :global(html[data-theme="light"]) .share-btn.copy-btn.copied {
    background-color: rgba(0, 163, 196, 0.08) !important;
    border-color: #008AA6 !important;
    color: #008AA6 !important;
  }
</style>

<script define:vars={{ articleTitle: title }}>
  // Dynamic link sharing helper
  document.addEventListener('DOMContentLoaded', () => {
    const url = window.location.href;
    const cleanTitle = encodeURIComponent(articleTitle);
    
    // Set up Dynamic Sharing Links
    const linkedinLink = document.querySelector('[data-share-type="linkedin"]');
    if (linkedinLink) {
      linkedinLink.setAttribute('href', `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`);
    }

    const whatsappLink = document.querySelector('[data-share-type="whatsapp"]');
    if (whatsappLink) {
      whatsappLink.setAttribute('href', `https://api.whatsapp.com/send?text=${cleanTitle}%20%0A%0A${encodeURIComponent(url)}`);
    }

    // Copy to clipboard mechanism
    const copyBtn = document.getElementById('copyLinkBtn');
    if (copyBtn) {
      const copyText = copyBtn.querySelector('.copy-text');
      
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(url).then(() => {
          // Success Feedback
          copyBtn.classList.add('copied');
          if (copyText) copyText.textContent = 'Copied!';
          
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            if (copyText) copyText.textContent = 'Copy Link';
          }, 2000);
        }).catch((err) => {
          console.error('Failed to copy text: ', err);
        });
      });
    }
  });
</script>
