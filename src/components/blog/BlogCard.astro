---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, heroImage, readingTime } = post.data;
const slug = post.id;
---

<article class="blog-card" data-category={category.toLowerCase()} data-title={title.toLowerCase()} data-description={description.toLowerCase()} data-tags={post.data.tags?.join(' ').toLowerCase()}>
  <a href={`/blog/${slug}/`} class="card-image-link">
    <div class="card-image-container">
      {heroImage ? (
        <img src={typeof heroImage === 'string' ? heroImage : heroImage.src} alt={title} loading="lazy" class="card-img" />
      ) : (
        <div class="placeholder-img" />
      )}
    </div>
  </a>
  <div class="card-content">
    <span class="card-category">{category}</span>
    <h3 class="card-title">
      <a href={`/blog/${slug}/`}>{title}</a>
    </h3>
    <p class="card-description">{description}</p>
    <div class="card-footer">
      <span class="card-meta">
        <FormattedDate date={pubDate} /> · {readingTime}
      </span>
      <a href={`/blog/${slug}/`} class="card-cta">Read Article <span class="arrow">→</span></a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: #080E19;
    border: 1px solid #1B2A42;
    border-radius: 10px;
    overflow: hidden;
    height: 100%;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
  }

  .blog-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 4px 20px rgba(57, 132, 255, 0.1);
  }

  .card-image-link {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: #05070D;
  }

  .card-image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .card-img {
    transform: scale(1.02);
  }

  .placeholder-img {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0b1424 0%, #102c50 100%);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    flex-grow: 1;
    box-sizing: border-box;
  }

  .card-category {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-blue);
    margin-bottom: 12px;
  }

  .card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 12px 0;
  }

  .card-title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--accent-blue);
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 0 20px 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(38, 54, 83, 0.4);
    margin-top: auto;
  }

  .card-meta {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: var(--text-muted);
  }

  .card-cta {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .blog-card:hover .card-cta {
    color: var(--accent-blue);
  }

  .card-cta .arrow {
    transition: transform 0.2s ease;
  }

  .card-cta:hover .arrow {
    transform: translateX(3px);
  }

  /* Light theme mapping override */
  :global(html[data-theme="light"]) .blog-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.02);
  }
  :global(html[data-theme="light"]) .blog-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 8px 25px rgba(0, 85, 255, 0.06);
  }
  :global(html[data-theme="light"]) .card-title a {
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .card-title a:hover {
    color: var(--accent-blue);
  }
  :global(html[data-theme="light"]) .card-description {
    color: #475569;
  }
  :global(html[data-theme="light"]) .card-footer {
    border-top-color: #F1F5F9;
  }
  :global(html[data-theme="light"]) .card-meta {
    color: #64748B;
  }
  :global(html[data-theme="light"]) .card-cta {
    color: #334155;
  }
  :global(html[data-theme="light"]) .blog-card:hover .card-cta {
    color: var(--accent-blue);
  }
</style>
