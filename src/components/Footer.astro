---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="footer-area">
  <!-- Subtle Radial Blue Glow (3%-6% opacity) -->
  <div class="footer-glow"></div>

  <div class="footer-container">
    
    <!-- Top Footer 4-Column Layout -->
    <div class="footer-grid">
      
      <!-- Column 1: Brand & Tagline -->
      <div class="footer-col col-brand">
        <a href="/" class="footer-logo-link">
          <span class="brand-logo">Entercraft.id</span>
        </a>
        <p class="brand-tagline">
          PT Enterkreasi Solusi Digital.
        </p>
        
        <!-- Social Media Icons -->
        <div class="footer-socials">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn Profile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
            </svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram Profile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"/>
            </svg>
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube Channel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
              <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Company -->
      <nav class="footer-col col-nav" aria-label="Company Links">
        <h3 class="col-title mobile-collapsible">
          COMPANY
          <svg class="mobile-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </h3>
        <div class="mobile-collapsible-content">
          <ul class="col-list">
            <li><a href="/about">About Us</a></li>
            <li><a href="#layanan">Services</a></li>
            <li><a href="#industri">Industries</a></li>
            <li><a href="#proses">How We Work</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </div>
      </nav>

      <!-- Column 3: Services -->
      <nav class="footer-col col-nav" aria-label="Services Links">
        <h3 class="col-title mobile-collapsible">
          SERVICES
          <svg class="mobile-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </h3>
        <div class="mobile-collapsible-content">
          <ul class="col-list">
            <li><a href="/layanan/system-web-mobile">Web & Mobile Development</a></li>
            <li><a href="/layanan/ai-automation">AI & Automation</a></li>
            <li><a href="/layanan/digital-marketing">Digital Marketing</a></li>
            <li><a href="/layanan/system-integration">System Integration</a></li>
            <li><a href="/layanan/custom-info-system">Custom Information System</a></li>
          </ul>
        </div>
      </nav>

      <!-- Column 4: Contact -->
      <div class="footer-col col-contact">
        <h3 class="col-title">LET'S TALK</h3>
        <p class="contact-prompt">Have a project in mind?</p>
        
        <a href="/contact/" class="contact-cta-link">
          Diskusikan Kebutuhan Anda <span class="contact-arrow">→</span>
        </a>
        
        <!-- Contact details -->
        <div class="contact-details">
          <span class="contact-item">
            <span class="contact-label">Email:</span> admin@entercraft.id
          </span>
          <span class="contact-item">
            <span class="contact-label">WhatsApp:</span> 0895344929185
          </span>
          <span class="contact-item">
            <span class="contact-label">Location:</span> Subang, Indonesia
          </span>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Policies Bar -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <span>© {currentYear} Entercraft.id. All rights reserved.</span>
      </div>
      <div class="bottom-right">
        <a href="/privacy" class="bottom-link">Privacy Policy</a>
        <span class="bottom-dot">·</span>
        <a href="/terms" class="bottom-link">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>

<style>
  /* Footer main section */
  footer.footer-area {
    position: relative;
    width: 100%;
    background-color: #05070D !important;
    border-top: 1px solid #18263B !important;
    padding-top: 80px !important;
    padding-bottom: 25px !important;
    overflow: hidden;
    box-sizing: border-box;
    text-align: left !important;
  }

  /* Subtle background radial glow */
  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle at top, rgba(57, 132, 255, 0.05) 0%, rgba(5, 7, 13, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  /* Grid 4 columns */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 1fr 1fr;
    gap: 50px;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Brand Area (Column 1) */
  .col-brand {
    max-width: 260px;
  }

  .footer-logo-link {
    text-decoration: none !important;
    display: inline-block;
    margin-bottom: 20px;
  }

  .brand-logo {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF !important;
    letter-spacing: 0.5px;
  }

  .brand-tagline {
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    color: #7187AA;
    margin: 0 0 24px 0;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-socials a {
    color: #7187AA;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .footer-socials a:hover {
    color: #3984FF;
    transform: translateY(-1px);
  }

  /* Navigation columns (Company, Services) */
  .col-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-chevron {
    display: none; /* Hidden on desktop */
  }

  .col-list {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .col-list li {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .col-list a {
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    color: #7187AA !important;
    text-decoration: none !important;
    transition: color 0.2s ease;
  }

  .col-list a:hover {
    color: #FFFFFF !important;
  }

  /* Contact Area (Column 4) */
  .contact-prompt {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #7187AA;
    margin: 0 0 10px 0;
  }

  .contact-cta-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: #3984FF !important;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 24px;
    transition: color 0.18s ease;
  }

  .contact-cta-link:hover {
    color: #39D5E8 !important;
  }

  .contact-arrow {
    transition: transform 0.2s ease;
  }

  .contact-cta-link:hover .contact-arrow {
    transform: translateX(3px);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-item {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #7187AA;
    display: block;
  }

  .contact-label {
    font-weight: 600;
    color: #52698F;
  }

  /* Bottom Copyright & Policies Bar */
  .footer-bottom {
    margin-top: 65px;
    padding-top: 24px;
    border-top: 1px solid #18263B;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .bottom-left span {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px;
    color: #52698F;
  }

  .bottom-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bottom-link {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px;
    color: #52698F !important;
    text-decoration: none !important;
    transition: color 0.2s ease;
  }

  .bottom-link:hover {
    color: #FFFFFF !important;
  }

  .bottom-dot {
    color: #52698F;
    font-size: 12px;
    user-select: none;
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .col-brand {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    /* MOBILE: Single-Column Collapsible Accordion Layout */
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .footer-col {
      border-bottom: 1px solid #18263B;
      padding-bottom: 16px;
    }

    .footer-col.col-brand, 
    .footer-col.col-contact {
      border-bottom: none;
      padding-bottom: 0;
    }

    /* Enable collapsible titles on mobile */
    .col-title.mobile-collapsible {
      cursor: pointer;
      margin-bottom: 0;
      padding: 10px 0;
      user-select: none;
    }

    .mobile-chevron {
      display: block;
      color: #7187AA;
      transition: transform 0.25s ease, color 0.25s ease;
    }

    /* Accordion collapsed details */
    .mobile-collapsible-content {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      overflow: hidden;
      transition: grid-template-rows 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease, padding-top 0.25s ease;
    }

    .mobile-collapsible-content .col-list {
      min-height: 0;
    }

    /* Active expanded state styling */
    .footer-col.expanded-active .mobile-collapsible-content {
      grid-template-rows: 1fr;
      opacity: 1;
      padding-top: 12px;
    }

    .footer-col.expanded-active .mobile-chevron {
      transform: rotate(180deg);
      color: var(--accent-blue);
    }

    .col-list a {
      display: block;
      padding: 6px 0; /* Increase touch target spacing */
    }

    /* Let's Talk Column Layout adjustment */
    .col-contact {
      margin-top: 10px;
    }

    .footer-bottom {
      margin-top: 45px;
      flex-direction: column;
      gap: 16px;
      text-align: left;
      align-items: flex-start;
    }

    .bottom-right {
      justify-content: flex-start;
      width: 100%;
    }
  }

  @media (max-width: 575px) {
    footer.footer-area {
      padding-top: 60px;
      padding-bottom: 20px;
    }

    .bottom-left span, .bottom-link {
      font-size: 10.5px;
    }
  }

  :global(html[data-theme="light"]) footer.footer-area {
    background-color: #ffffff !important;
    border-top-color: #e2e8f0 !important;
  }

  :global(html[data-theme="light"]) footer.footer-area .brand-logo,
  :global(html[data-theme="light"]) footer.footer-area .col-title {
    color: #0f172a !important;
  }

  :global(html[data-theme="light"]) footer.footer-area .brand-tagline,
  :global(html[data-theme="light"]) footer.footer-area .contact-prompt,
  :global(html[data-theme="light"]) footer.footer-area .contact-item,
  :global(html[data-theme="light"]) footer.footer-area .col-list a {
    color: #334155 !important;
  }

  :global(html[data-theme="light"]) footer.footer-area .footer-socials a,
  :global(html[data-theme="light"]) footer.footer-area .contact-label,
  :global(html[data-theme="light"]) footer.footer-area .bottom-left span,
  :global(html[data-theme="light"]) footer.footer-area .bottom-link,
  :global(html[data-theme="light"]) footer.footer-area .bottom-dot,
  :global(html[data-theme="light"]) footer.footer-area .mobile-chevron {
    color: #475569 !important;
  }

  :global(html[data-theme="light"]) footer.footer-area .footer-bottom,
  :global(html[data-theme="light"]) footer.footer-area .footer-col {
    border-color: #e2e8f0 !important;
  }

  :global(html[data-theme="light"]) footer.footer-area .col-list a:hover,
  :global(html[data-theme="light"]) footer.footer-area .footer-socials a:hover,
  :global(html[data-theme="light"]) footer.footer-area .bottom-link:hover {
    color: #0055ff !important;
  }
</style>

<script>
  // Mobile Footer accordion toggle scripts
  document.addEventListener('DOMContentLoaded', () => {
    const collapsibles = document.querySelectorAll('.col-title.mobile-collapsible');
    
    collapsibles.forEach(header => {
      header.addEventListener('click', () => {
        if (window.innerWidth > 768) return; // Only toggle on mobile viewports
        
        const parentCol = header.closest('.footer-col');
        if (parentCol) {
          parentCol.classList.toggle('expanded-active');
        }
      });
    });
  });
</script>
