---
// FeatureCapabilities.astro (Jasa Website Development)

const features = [
  {
    title: "Authentication",
    description: "Sistem login, registrasi, social login (Google/Facebook), integrasi OTP, dan reset password aman.",
    icon: "lock"
  },
  {
    title: "User Roles & Permissions",
    description: "Pembagian hak akses bertingkat (Admin, Editor, Sales, Pelanggan) sesuai struktur organisasi Anda.",
    icon: "shield"
  },
  {
    title: "Interactive Dashboard",
    description: "Halaman ringkasan analitik interaktif yang menampilkan grafik, data utama, dan metrik penting bisnis.",
    icon: "layout"
  },
  {
    title: "Data Management",
    description: "Kelola data (CRUD) dengan mudah, dilengkapi fungsi import/export format CSV/Excel secara langsung.",
    icon: "database"
  },
  {
    title: "Search & Filtering",
    description: "Fitur pencarian instan dan penyaringan multi-atribut dinamis untuk memudahkan pencarian data.",
    icon: "search"
  },
  {
    title: "Secure File Upload",
    description: "Sistem unggah file (dokumen, gambar, video) yang aman dan terintegrasi dengan CDN/cloud storage.",
    icon: "upload-cloud"
  },
  {
    title: "Smart Form & Validation",
    description: "Formulir interaktif dengan validasi data real-time baik di sisi client maupun server untuk keakuratan data.",
    icon: "check-square"
  },
  {
    title: "Booking & Scheduling",
    description: "Sistem kalender reservasi dengan pengaturan slot waktu dinamis dan penanganan konflik jadwal.",
    icon: "calendar"
  },
  {
    title: "Payment Gateway Integration",
    description: "Integrasi sistem pembayaran otomatis (Midtrans, Xendit, dll) lengkap dengan e-invoice instan.",
    icon: "credit-card"
  },
  {
    title: "Notification System",
    description: "Notifikasi otomatis via WhatsApp API, Email, atau Web Push Notification setiap ada pemicu (trigger).",
    icon: "bell"
  },
  {
    title: "Reporting & Exports",
    description: "Layanan generate dokumen PDF dinamis (invoice, sertifikat, laporan) dan grafik analisis.",
    icon: "bar-chart-2"
  },
  {
    title: "Custom CMS",
    description: "Dashboard pengelolaan konten yang dirancang khusus agar tim internal dapat mengedit teks tanpa keahlian IT.",
    icon: "edit-3"
  },
  {
    title: "API Integration",
    description: "Konektivitas dua arah dengan CRM, ERP, logistik pengiriman (JNE, Sicepat), atau sistem pihak ketiga lainnya.",
    icon: "git-commit"
  },
  {
    title: "Database Integration",
    description: "Arsitektur data relasional (SQL/NoSQL) yang dioptimasi untuk kecepatan kueri dan integritas data.",
    icon: "server"
  }
];
---

<section class="features-section" id="features">
  <div class="features-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> FEATURE CAPABILITIES
      </div>
      <h2 class="header-title">Fitur yang Dapat Dibangun Sesuai Kebutuhan</h2>
      <p class="header-intro">
        Berikut adalah modul fungsionalitas yang dapat kami implementasikan ke dalam sistem website Anda.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feat, index) => (
        <div class="feat-card animate-fade-scroll" style={`animation-delay: ${150 + (index * 50)}ms;`}>
          <div class="feat-icon">
            {feat.icon === 'lock' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>}
            {feat.icon === 'shield' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
            {feat.icon === 'layout' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>}
            {feat.icon === 'database' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
            {feat.icon === 'search' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>}
            {feat.icon === 'upload-cloud' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 16 12 12 8 16"></polyline><line x1="12" y1="12" x2="12" y2="21"></line><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"></path><polyline points="16 16 12 12 8 16"></polyline></svg>}
            {feat.icon === 'check-square' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>}
            {feat.icon === 'calendar' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>}
            {feat.icon === 'credit-card' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>}
            {feat.icon === 'bell' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>}
            {feat.icon === 'bar-chart-2' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
            {feat.icon === 'edit-3' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>}
            {feat.icon === 'git-commit' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><line x1="1.05" y1="12" x2="7" y2="12"></line><line x1="17.01" y1="12" x2="22.95" y2="12"></line></svg>}
            {feat.icon === 'server' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>}
          </div>
          <div class="feat-content">
            <h3 class="feat-title">{feat.title}</h3>
            <p class="feat-desc">{feat.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="features-microcopy animate-fade-scroll" style="animation-delay: 900ms;">
      <span class="microcopy-icon">i</span>
      <p class="microcopy-text">Fitur di atas merupakan opsi fungsionalitas yang dapat diimplementasikan ke dalam scope pengembangan sesuai kebutuhan project Anda.</p>
    </div>

  </div>
</section>

<style>
  .features-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 650px;
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .feat-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.2s ease;
  }

  .feat-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
    background-color: rgba(7, 16, 32, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .feat-icon {
    width: 40px;
    height: 40px;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feat-content {
    display: flex;
    flex-direction: column;
  }

  .feat-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .feat-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .features-microcopy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 12px 20px;
    max-width: 600px;
    margin: 0 auto;
  }

  .microcopy-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    font-family: monospace;
    font-weight: bold;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .microcopy-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6682B3;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .features-section {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .feat-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .feat-desc {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .feat-card {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .feat-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  :global(html[data-theme="light"]) .features-microcopy {
    background: #F8FAFC;
    border-color: #CBD5E1;
  }

  :global(html[data-theme="light"]) .microcopy-text {
    color: #64748B;
  }

  @media (max-width: 991px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .features-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
