---
// Portfolio.astro (Jasa Website Development)

const projects = [
  {
    name: "B2B Logistics Customer Portal",
    label: "SELECTED CONCEPT / PREVIEW",
    challenge: "Perusahaan logistik kesulitan melacak pesanan dan menangani pengajuan pengiriman massal dari puluhan partner bisnis secara manual.",
    solution: "Membangun portal klien custom terintegrasi yang memungkinkan partner mengunggah file manifest (Excel), melacak armada secara real-time via API peta, dan mengunduh invoice otomatis.",
    technology: "React, Next.js, Node.js, PostgreSQL, Google Maps API",
    outcome: "Memangkas waktu koordinasi tim operasional hingga 60% dan mempercepat proses invoicing.",
    badge: "Operations"
  },
  {
    name: "Enterprise Scheduling & Booking System",
    label: "SELECTED CONCEPT / PREVIEW",
    challenge: "Layanan jasa konsultasi profesional dengan ratusan agen sering mengalami tabrakan jadwal temu klien akibat sistem pemesanan manual.",
    solution: "Sistem booking dinamis dengan algoritma alokasi agen otomatis, penanganan konflik waktu, integrasi Google Calendar, dan auto-reminder WhatsApp API.",
    technology: "Astro, TailwindCSS, Laravel, MySQL, WhatsApp Cloud API",
    outcome: "Mengurangi kasus tidak hadir (no-show) klien sebesar 40% dan mengeliminasi tabrakan jadwal.",
    badge: "Scheduling"
  }
];
---

<section class="portfolio-section" id="portfolio">
  <div class="pf-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> PROJECT PREVIEW
      </div>
      <h2 class="header-title">Project Website yang Kami Kembangkan</h2>
      <p class="header-intro">
        Berikut adalah visualisasi konsep arsitektur dan sistem yang kami rancang untuk mempermudah operasional berbagai skala bisnis B2B.
      </p>
    </div>

    <div class="projects-list">
      {projects.map((proj, index) => (
        <div class="project-card animate-fade-scroll" style={`animation-delay: ${150 + (index * 150)}ms;`}>
          <!-- Left side: visual design details -->
          <div class="project-visual">
            <div class="concept-label">{proj.label}</div>
            <div class="concept-mockup">
              <div class="mock-header">
                <span class="m-dot"></span><span class="m-dot"></span><span class="m-dot"></span>
              </div>
              <div class="mock-content">
                <div class="mock-sidebar">
                  <span class="ms-bar"></span>
                  <span class="ms-bar short"></span>
                  <span class="ms-bar"></span>
                </div>
                <div class="mock-main">
                  <div class="mock-stat-grid">
                    <span class="ms-box"></span>
                    <span class="ms-box"></span>
                  </div>
                  <div class="mock-table">
                    <span class="mt-row"></span>
                    <span class="mt-row"></span>
                    <span class="mt-row"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right side: technical detail summary -->
          <div class="project-info">
            <span class="proj-badge">{proj.badge}</span>
            <h3 class="proj-name">{proj.name}</h3>
            
            <div class="info-block">
              <span class="block-lbl">CHALLENGE:</span>
              <p class="block-val">{proj.challenge}</p>
            </div>
            
            <div class="info-block">
              <span class="block-lbl">SOLUTION:</span>
              <p class="block-val">{proj.solution}</p>
            </div>
            
            <div class="info-block">
              <span class="block-lbl">TECHNOLOGY:</span>
              <p class="block-val tech-stack">{proj.technology}</p>
            </div>
            
            <div class="info-block">
              <span class="block-lbl">OUTCOME:</span>
              <p class="block-val outcome-text">{proj.outcome}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .portfolio-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .pf-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 20px auto;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 650px;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .project-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 50px;
    background: rgba(13, 20, 34, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 40px;
    box-sizing: border-box;
    align-items: center;
  }

  .project-card:hover {
    border-color: rgba(57, 132, 255, 0.2);
  }

  /* Visual mock styling */
  .project-visual {
    background: repeating-linear-gradient(45deg, #1e293b, #1e293b 10px, #172030 10px, #172030 20px);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 20px;
    box-sizing: border-box;
  }

  .concept-label {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.2);
    font-family: 'Inter', monospace;
    font-size: 9px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .concept-mockup {
    background: #0f172a;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    width: 90%;
    height: 80%;
    margin-top: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  }

  .mock-header {
    background: rgba(255,255,255,0.02);
    border-bottom: 1px solid var(--border-color);
    padding: 8px 12px;
    display: flex;
    gap: 4px;
  }

  .m-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #334155;
  }

  .mock-content {
    display: flex;
    flex-grow: 1;
    height: calc(100% - 23px);
  }

  .mock-sidebar {
    width: 60px;
    border-right: 1px solid var(--border-color);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: rgba(255,255,255,0.01);
  }

  .ms-bar {
    height: 6px;
    background: #334155;
    border-radius: 3px;
    width: 100%;
  }

  .ms-bar.short { width: 60%; }

  .mock-main {
    flex-grow: 1;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mock-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .ms-box {
    height: 36px;
    background: rgba(57, 132, 255, 0.05);
    border: 1px solid rgba(57, 132, 255, 0.1);
    border-radius: 4px;
  }

  .mock-table {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mt-row {
    height: 6px;
    background: #1e293b;
    border-radius: 3px;
    width: 100%;
  }

  /* Info cards styling */
  .project-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .proj-badge {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-blue);
    text-transform: uppercase;
    margin-bottom: 10px;
    letter-spacing: 0.5px;
  }

  .proj-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .info-block {
    margin-bottom: 14px;
    width: 100%;
  }

  .info-block:last-child {
    margin-bottom: 0;
  }

  .block-lbl {
    font-family: 'Inter', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #64748B;
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.5px;
  }

  .block-val {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  .block-val.tech-stack {
    font-family: 'Inter', monospace;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .block-val.outcome-text {
    color: #10b981;
    font-weight: 600;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .portfolio-section {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .project-card {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .project-visual {
    background: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 10px, #e2e8f0 10px, #e2e8f0 20px);
    border-color: #cbd5e1;
  }

  :global(html[data-theme="light"]) .concept-mockup {
    background: #FFFFFF;
    border-color: #cbd5e1;
  }

  :global(html[data-theme="light"]) .m-dot {
    background: #cbd5e1;
  }

  :global(html[data-theme="light"]) .ms-bar {
    background: #e2e8f0;
  }

  :global(html[data-theme="light"]) .ms-box {
    background: rgba(57, 132, 255, 0.05);
    border-color: rgba(57, 132, 255, 0.1);
  }

  :global(html[data-theme="light"]) .mt-row {
    background: #f1f5f9;
  }

  :global(html[data-theme="light"]) .proj-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .block-val {
    color: #475569;
  }

  @media (max-width: 991px) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 30px;
    }
  }

  @media (max-width: 767px) {
    .portfolio-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 30px;
    }
  }
</style>
