---
// Integration.astro (Jasa Website Development)

const integrations = [
  { name: "CRM", detail: "HubSpot, Zoho, Salesforce", category: "sales" },
  { name: "ERP Systems", detail: "SAP, Odoo, Oracle", category: "operations" },
  { name: "Payment Gateway", detail: "Midtrans, Xendit, Stripe", category: "finance" },
  { name: "WhatsApp API", detail: "WABA, Twilio, Custom API", category: "comms" },
  { name: "Email Services", detail: "SendGrid, Mailchimp", category: "comms" },
  { name: "Google Maps", detail: "Geolocation & Routing", category: "geo" },
  { name: "Analytics Tools", detail: "Google Analytics, Hotjar", category: "analytics" },
  { name: "Internal Database", detail: "MySQL, PostgreSQL, REST API", category: "data" }
];
---

<section class="integration-section" id="integration">
  <div class="int-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> ECOSYSTEM INTEGRATION
      </div>
      <h2 class="header-title">Hubungkan Website dengan Sistem yang Sudah Digunakan Bisnis Anda</h2>
      <p class="header-intro">
        Website custom dapat dirancang untuk bertukar data secara otomatis dengan berbagai software, database, dan layanan eksternal demi meminimalkan entri data manual.
      </p>
    </div>

    <!-- Graphical System Map -->
    <div class="integration-visual animate-fade-scroll" style="animation-delay: 250ms;">
      
      <!-- Core Layer (Center) -->
      <div class="visual-core">
        <div class="core-box">
          <div class="core-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <span class="core-title">CUSTOM WEBSITE</span>
        </div>
      </div>

      <!-- Mid Layer (API / Connection Layer) -->
      <div class="visual-mid">
        <div class="mid-ring">
          <span class="ring-label">API & INTEGRATION LAYER</span>
        </div>
      </div>

      <!-- Satellites (Outer Layer) -->
      <div class="satellites-grid">
        {integrations.map((item, idx) => (
          <div class={`satellite-card sat-${idx + 1}`}>
            <div class="sat-header">
              <span class="sat-dot"></span>
              <h4 class="sat-name">{item.name}</h4>
            </div>
            <p class="sat-detail">{item.detail}</p>
          </div>
        ))}
      </div>

    </div>

    <div class="integration-microcopy animate-fade-scroll" style="animation-delay: 750ms;">
      <span class="microcopy-icon">i</span>
      <p class="microcopy-text">Integrasi bergantung pada kemampuan teknis sistem, ketersediaan API, akses kredensial, dan kebutuhan project.</p>
    </div>

  </div>
</section>

<style>
  .integration-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .int-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 20px auto;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 650px;
  }

  /* Graphical Ecosystem Map */
  .integration-visual {
    position: relative;
    width: 100%;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  .visual-core {
    position: absolute;
    z-index: 10;
  }

  .core-box {
    background: #0f172a;
    border: 2px solid var(--accent-blue);
    border-radius: 16px;
    padding: 24px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    box-shadow: 0 0 40px rgba(57, 132, 255, 0.2);
    transition: all 0.3s ease;
  }

  .core-icon {
    color: var(--accent-blue);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .core-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #FFFFFF;
  }

  .visual-mid {
    position: absolute;
    width: 320px;
    height: 320px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mid-ring {
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(57, 132, 255, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    animation: rotateRing 60s infinite linear;
  }

  @keyframes rotateRing {
    to { transform: rotate(360deg); }
  }

  .ring-label {
    position: absolute;
    top: -10px;
    background: var(--bg-primary);
    padding: 2px 10px;
    font-family: 'Inter', monospace;
    font-size: 9px;
    font-weight: 700;
    color: var(--accent-blue);
    border: 1px solid rgba(57, 132, 255, 0.2);
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Satellites Grid placing outer elements around ring */
  .satellites-grid {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .satellite-card {
    position: absolute;
    background: rgba(13, 20, 34, 0.85);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 14px 18px;
    width: 170px;
    box-sizing: border-box;
    z-index: 8;
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
  }

  .satellite-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .sat-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .sat-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-blue);
    border-radius: 50%;
  }

  .sat-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .sat-detail {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: #7D96C5;
    margin: 0;
  }

  /* Positioning outer elements radially (mock positions) */
  .sat-1 { top: 30px; left: 10%; }
  .sat-2 { top: 30px; right: 10%; }
  .sat-3 { top: 220px; left: 2%; }
  .sat-4 { top: 220px; right: 2%; }
  .sat-5 { bottom: 30px; left: 10%; }
  .sat-6 { bottom: 30px; right: 10%; }
  .sat-7 { top: 120px; left: 25%; }
  .sat-8 { top: 120px; right: 25%; }

  .integration-microcopy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 12px 20px;
    max-width: 600px;
    margin: 0 auto;
  }

  .microcopy-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    font-family: monospace;
    font-weight: bold;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .microcopy-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6682B3;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .integration-section {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .core-box {
    background: #FFFFFF;
    color: #0f172a;
    box-shadow: 0 10px 30px rgba(57, 132, 255, 0.15);
  }

  :global(html[data-theme="light"]) .core-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .mid-ring {
    border-color: rgba(57, 132, 255, 0.15);
  }

  :global(html[data-theme="light"]) .ring-label {
    background: #FFFFFF;
  }

  :global(html[data-theme="light"]) .satellite-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .sat-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .sat-detail {
    color: #64748B;
  }

  :global(html[data-theme="light"]) .integration-microcopy {
    background: #F8FAFC;
    border-color: #CBD5E1;
  }

  :global(html[data-theme="light"]) .microcopy-text {
    color: #64748B;
  }

  /* Responsive layout for ecosystem visual map (make it vertical stacks on mobile) */
  @media (max-width: 991px) {
    .integration-visual {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 30px;
      padding: 40px 0;
    }

    .visual-core, .visual-mid {
      position: static;
    }

    .visual-mid {
      display: none; /* Hide rotation ring on mobile */
    }

    .satellites-grid {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      width: 100%;
      height: auto;
    }

    .satellite-card {
      position: static;
      width: 100%;
    }
  }

  @media (max-width: 767px) {
    .integration-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 30px;
    }

    .satellites-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
