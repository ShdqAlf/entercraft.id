---
// Problem.astro (Jasa Website Development)

const problems = [
  {
    title: "Fitur Terbatas",
    description: "Template website atau CMS instan seringkali tidak menyediakan modul atau fungsionalitas khusus yang krusial untuk operasional bisnis Anda.",
    icon: "slash"
  },
  {
    title: "Proses Bisnis Terhambat",
    description: "Website standar memaksa bisnis Anda menyesuaikan diri dengan sistem mereka, padahal seharusnya website yang mengikuti alur kerja dan aturan unik perusahaan.",
    icon: "git-branch"
  },
  {
    title: "Sistem Terisolasi",
    description: "Website tidak dapat berkomunikasi secara otomatis untuk bertukar data dengan CRM, ERP, payment gateway, database, atau API internal yang sudah Anda gunakan.",
    icon: "link-off"
  },
  {
    title: "Sulit Dikembangkan",
    description: "Kode berantakan dari website template yang asal jadi menyulitkan tim pengembang melakukan scale up atau menambahkan fitur baru di masa depan.",
    icon: "trending-down"
  }
];
---

<section class="problem-section" id="problem">
  <div class="problem-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Tidak Semua Kebutuhan Bisnis Bisa Diselesaikan dengan Website Template</h2>
      <p class="header-intro">
        Ketika bisnis membutuhkan fitur khusus, workflow tertentu, atau integrasi dengan sistem lain, website standar sering kali tidak lagi cukup.
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((prob, index) => (
        <div class="problem-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="problem-icon">
            {prob.icon === 'slash' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>}
            {prob.icon === 'git-branch' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>}
            {prob.icon === 'link-off' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.84 12.84l.79-.79a3 3 0 0 0-4.24-4.24l-3.18 3.18a3 3 0 0 0-.64 3.42M12 20.08L8.82 23.2a3 3 0 0 1-4.24-4.24l3.18-3.18a3 3 0 0 1 3.42-.64"></path><line x1="2" y1="2" x2="22" y2="22"></line></svg>}
            {prob.icon === 'trending-down' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>}
          </div>
          <h3 class="problem-title">{prob.title}</h3>
          <p class="problem-description">{prob.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .problem-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .problem-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6682B3;
    max-width: 650px;
    margin: 0;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .problem-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .problem-card:hover {
    transform: translateY(-4px);
    border-color: rgba(239, 68, 68, 0.4);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .problem-icon {
    width: 48px;
    height: 48px;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .problem-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .problem-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .problem-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .problem-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .problem-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .problem-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .problem-card:hover {
    border-color: rgba(239, 68, 68, 0.5);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 991px) {
    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .problem-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
