---
// TechStack.astro (Jasa Website Development)

const technologies = [
  { name: "Astro", use: "Static Site Generator & Islands Architecture", desc: "Sangat baik untuk website berkecepatan tinggi dengan kebutuhan SEO prima." },
  { name: "React", use: "Frontend UI Library", desc: "Digunakan untuk membangun komponen antarmuka dinamis dan kompleks yang interaktif." },
  { name: "Next.js", use: "React Framework for Production", desc: "Sempurna untuk platform web skala besar yang membutuhkan Server-Side Rendering." },
  { name: "Laravel", use: "PHP Web Framework", desc: "Menyediakan kestabilan dan keamanan tinggi untuk pengolahan logika backend B2B." },
  { name: "PHP", use: "Server-side Language", desc: "Bahasa pemrograman populer yang andal dan didukung ekosistem server yang sangat luas." },
  { name: "Node.js", use: "JavaScript Runtime", desc: "Sangat responsif untuk aplikasi real-time, microservices, dan skalabilitas tinggi." },
  { name: "MySQL", use: "Relational Database Management", desc: "Database andal untuk menyimpan data bisnis Anda secara rapi dan konsisten." },
  { name: "PostgreSQL", use: "Advanced Relational Database", desc: "Pilihan terbaik untuk pengolahan kueri database yang kompleks dan intensif." },
  { name: "REST API", use: "API Architecture", desc: "Standar protokol pertukaran data dua arah yang fleksibel untuk berbagai integrasi." }
];
---

<section class="techstack-section" id="tech-stack">
  <div class="ts-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> TECHNOLOGY STACK
      </div>
      <h2 class="header-title">Teknologi Dipilih Berdasarkan Kebutuhan Project</h2>
      <p class="header-intro">
        Kami memilih technology stack berdasarkan kebutuhan fitur, performance, maintainability, integration, dan rencana pengembangan jangka panjang bisnis Anda.
      </p>
    </div>

    <div class="ts-grid">
      {technologies.map((tech, index) => (
        <div class="tech-card animate-fade-scroll" style={`animation-delay: ${150 + (index * 50)}ms;`}>
          <div class="tech-info">
            <h4 class="tech-name">{tech.name}</h4>
            <span class="tech-use">{tech.use}</span>
            <p class="tech-desc">{tech.desc}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .techstack-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .ts-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 20px auto;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 650px;
  }

  .ts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .tech-card {
    background: rgba(13, 20, 34, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .tech-card:hover {
    border-color: var(--accent-blue);
    background: rgba(57, 132, 255, 0.03);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .tech-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 4px 0;
  }

  .tech-use {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .tech-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .techstack-section {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .tech-card {
    background: #F8FAFC;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);
  }

  :global(html[data-theme="light"]) .tech-card:hover {
    border-color: var(--accent-blue);
  }

  :global(html[data-theme="light"]) .tech-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .tech-desc {
    color: #64748B;
  }

  @media (max-width: 991px) {
    .ts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .techstack-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 30px;
    }

    .ts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
