---
// WhatWeBuild.astro (Jasa Website Development)

const useCases = [
  {
    title: "Custom Business Website",
    description: "Website dengan fungsionalitas kompleks yang melampaui company profile standar. Cocok untuk bisnis dengan kalkulator biaya, visualizer, atau katalog dinamis.",
    icon: "layers"
  },
  {
    title: "Customer Portal",
    description: "Portal interaktif yang dilengkapi fitur login, manajemen profil, dashboard pelanggan, riwayat transaksi, pengajuan permintaan, hingga status tracking.",
    icon: "users"
  },
  {
    title: "Internal Business Website",
    description: "Dashboard internal khusus untuk menyederhanakan data management, pengelolaan tugas (task management), tracking produktivitas, serta reporting real-time.",
    icon: "pie-chart"
  },
  {
    title: "Booking & Reservation",
    description: "Sistem reservasi custom dengan real-time availability check, pencatatan booking otomatis, konfirmasi instan, sinkronisasi jadwal, dan reminder notifikasi.",
    icon: "calendar"
  },
  {
    title: "Product / Service Platform",
    description: "Platform direktori atau katalog dengan fungsi search & filtering mutakhir, detail produk dinamis, interaksi user, dan integrasi form inquiry terarah.",
    icon: "grid"
  },
  {
    title: "Custom Web Platform",
    description: "Aplikasi berbasis web dengan business logic, alur persetujuan, user roles & permissions bertingkat, relasi database, dan integrasi API yang spesifik.",
    icon: "cpu"
  }
];
---

<section class="wwb-section" id="what-we-build">
  <div class="wwb-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Website Seperti Apa yang Bisa Kami Kembangkan?</h2>
      <p class="header-intro">
        Kami merancang dan mengembangkan berbagai jenis platform web custom yang sepenuhnya disesuaikan dengan kebutuhan operasional dan tujuan bisnis Anda.
      </p>
    </div>

    <div class="wwb-grid">
      {useCases.map((uc, index) => (
        <div class="wwb-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="wwb-icon">
            {uc.icon === 'layers' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>}
            {uc.icon === 'users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>}
            {uc.icon === 'pie-chart' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>}
            {uc.icon === 'calendar' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>}
            {uc.icon === 'grid' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>}
            {uc.icon === 'cpu' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>}
          </div>
          <h3 class="wwb-title">{uc.title}</h3>
          <p class="wwb-description">{uc.description}</p>
        </div>
      ))}
    </div>

    <div class="wwb-microcopy animate-fade-scroll" style="animation-delay: 850ms;">
      <span class="microcopy-icon">i</span>
      <p class="microcopy-text">Fitur dan scope disesuaikan dengan kebutuhan project secara spesifik.</p>
    </div>

  </div>
</section>

<style>
  .wwb-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .wwb-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 650px;
    margin: 0;
  }

  .wwb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .wwb-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .wwb-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
    background-color: rgba(7, 16, 32, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .wwb-icon {
    width: 48px;
    height: 48px;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .wwb-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .wwb-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .wwb-microcopy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    padding: 12px 20px;
    max-width: 500px;
    margin: 0 auto;
  }

  .microcopy-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    font-family: monospace;
    font-weight: bold;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .microcopy-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6682B3;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .wwb-section {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .wwb-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .wwb-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .wwb-card {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .wwb-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  :global(html[data-theme="light"]) .wwb-microcopy {
    background: #F8FAFC;
    border-color: #CBD5E1;
  }

  :global(html[data-theme="light"]) .microcopy-text {
    color: #64748B;
  }

  @media (max-width: 991px) {
    .wwb-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .wwb-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .wwb-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
