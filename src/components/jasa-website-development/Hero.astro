---
// Hero.astro (Jasa Website Development)
---

<section class="hero-section">
  <!-- Subtle Radial Glows -->
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>

  <!-- Background Grid -->
  <div class="hero-bg-decorations" aria-hidden="true"></div>

  <div class="hero-container">
    <!-- Left side: Text content -->
    <div class="hero-content">
      <!-- Badge -->
      <div class="hero-badge animate-fade-in" style="animation-delay: 100ms;">
        <svg class="badge-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" fill="currentColor"></path>
        </svg>
        <span class="badge-text">JASA WEBSITE DEVELOPMENT CUSTOM</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-heading animate-fade-in" style="animation-delay: 250ms;">
        Jasa Website Development untuk Membangun <span class="text-blue">Website Custom</span> Sesuai Kebutuhan Bisnis
      </h1>

      <!-- Description -->
      <p class="hero-description animate-fade-in" style="animation-delay: 400ms;">
        Bangun website dengan fitur, business logic, database, dan integrasi yang disesuaikan dengan proses bisnis Anda—mulai dari website dengan fitur khusus hingga platform web yang lebih kompleks.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions animate-fade-in" style="animation-delay: 550ms;">
        <a href="/contact/" class="cta-primary">Konsultasikan Project Website</a>
        <a href="#portfolio" class="cta-secondary">Lihat Portfolio</a>
      </div>
    </div>
    
    <!-- Right side: Visual System Architecture -->
    <div class="hero-visual animate-fade-in" style="animation-delay: 700ms;">
      <div class="architecture-flow">
        
        <!-- User Layer -->
        <div class="flow-layer user-layer">
          <div class="flow-card">
            <div class="card-icon blue">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div class="card-text">
              <span class="layer-name">User / Client</span>
              <span class="layer-detail">Interactive Access</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow"></span></div>

        <!-- Frontend Layer -->
        <div class="flow-layer frontend-layer">
          <div class="flow-card">
            <div class="card-icon cyan">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="card-text">
              <span class="layer-name">Web Interface (Frontend)</span>
              <span class="layer-detail">React / Next.js / Astro</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow delay-1"></span></div>

        <!-- Business Logic Layer -->
        <div class="flow-layer logic-layer">
          <div class="flow-card highlight">
            <div class="card-icon purple">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            </div>
            <div class="card-text">
              <span class="layer-name">Business Logic</span>
              <span class="layer-detail">Custom Workflows & Rules</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow delay-2"></span></div>

        <!-- Backend & API Layer -->
        <div class="flow-layer backend-layer">
          <div class="flow-card">
            <div class="card-icon pink">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
            </div>
            <div class="card-text">
              <span class="layer-name">API / Backend System</span>
              <span class="layer-detail">Node.js / Laravel / REST API</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow delay-3"></span></div>

        <!-- Split Bottom: DB & Third-Party -->
        <div class="flow-split">
          
          <!-- Database -->
          <div class="split-side">
            <div class="flow-card mini">
              <div class="card-icon emerald">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
              </div>
              <div class="card-text">
                <span class="layer-name small">Database Store</span>
                <span class="layer-detail small">MySQL / PostgreSQL</span>
              </div>
            </div>
          </div>

          <!-- Third Party Services -->
          <div class="split-side">
            <div class="flow-card mini">
              <div class="card-icon gold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 22 22 22"></polygon></svg>
              </div>
              <div class="card-text">
                <span class="layer-name small">External Services</span>
                <span class="layer-detail small">CRM / Payment / WA API</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* Hero Section Wrapper */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
    padding: 100px 24px 60px 24px;
    box-sizing: border-box;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(57, 132, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 132, 255, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
  }

  /* Radial Glow Backgrounds */
  .hero-glow {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 850px;
    height: 850px;
    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(57, 132, 255, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 20% 75%,
        rgba(57, 213, 232, 0.04) 0%,
        transparent 40%
      );
    pointer-events: none;
    z-index: 1;
  }

  .hero-glow-secondary {
    position: absolute;
    top: 70%;
    right: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Tech Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(57, 132, 255, 0.08);
    border: 1px solid rgba(57, 132, 255, 0.2);
    border-radius: 99px;
    padding: 6px 14px;
    margin-bottom: 24px;
  }

  .badge-icon {
    color: var(--accent-blue);
  }

  .badge-text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  /* Heading & Typography */
  .hero-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 46px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .text-blue {
    color: var(--accent-blue);
  }

  .hero-description {
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: #7D96C5;
    margin: 0 0 36px 0;
    max-width: 520px;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-blue);
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 48px;
    padding: 0 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cta-primary:hover {
    background: var(--accent-bright);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(57, 132, 255, 0.35);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 48px;
    padding: 0 28px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  /* Architecture Flow Diagram (Right Panel) */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .architecture-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 440px;
    background: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 30px;
    box-sizing: border-box;
  }

  .flow-layer {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .flow-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(13, 20, 34, 0.75);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px 20px;
    width: 100%;
    transition: all 0.3s ease;
  }

  .flow-card.highlight {
    border-color: var(--accent-blue);
    background: rgba(57, 132, 255, 0.05);
    box-shadow: 0 0 25px rgba(57, 132, 255, 0.15);
  }

  .flow-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .card-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon.blue { background: rgba(57, 132, 255, 0.1); color: var(--accent-blue); }
  .card-icon.cyan { background: rgba(57, 213, 232, 0.1); color: #39d5e8; }
  .card-icon.purple { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
  .card-icon.pink { background: rgba(236, 72, 153, 0.1); color: #ec4899; }
  .card-icon.emerald { background: rgba(16, 185, 129, 0.1); color: #10b981; }
  .card-icon.gold { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }

  .card-text {
    display: flex;
    flex-direction: column;
  }

  .layer-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .layer-detail {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #6682B3;
    margin-top: 2px;
  }

  .flow-arrow {
    height: 24px;
    width: 2px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    margin: 4px 0;
  }

  .arrow-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-blue);
  }

  .animate-flow {
    animation: flowDown 1.8s infinite linear;
  }

  .delay-1 { animation-delay: 0.45s; }
  .delay-2 { animation-delay: 0.9s; }
  .delay-3 { animation-delay: 1.35s; }

  @keyframes flowDown {
    0% {
      top: 0;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* Split Bottom Side */
  .flow-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
    margin-top: 4px;
  }

  .flow-card.mini {
    padding: 12px 14px;
    gap: 12px;
  }

  .layer-name.small {
    font-size: 12px;
  }

  .layer-detail.small {
    font-size: 10px;
  }

  /* Animations */
  .animate-fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .hero-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .hero-section::before {
    background-image:
      linear-gradient(rgba(57, 132, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57, 132, 255, 0.06) 1px, transparent 1px);
  }

  :global(html[data-theme="light"]) .hero-heading {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .hero-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .cta-secondary {
    color: #0f172a;
    border-color: #cbd5e1;
  }

  :global(html[data-theme="light"]) .cta-secondary:hover {
    background: #f1f5f9;
  }

  :global(html[data-theme="light"]) .architecture-flow {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  :global(html[data-theme="light"]) .flow-card {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .flow-card.highlight {
    background: rgba(57, 132, 255, 0.05);
    border-color: var(--accent-blue);
  }

  :global(html[data-theme="light"]) .layer-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .layer-detail {
    color: #64748B;
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .hero-content {
      align-items: center;
    }

    .hero-description {
      margin: 0 auto 30px auto;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding: 80px 16px 40px 16px;
    }

    .hero-heading {
      font-size: 34px;
    }

    .hero-description {
      font-size: 15px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-primary, .cta-secondary {
      width: 100%;
    }

    .architecture-flow {
      padding: 20px;
    }

    .flow-card {
      padding: 12px 16px;
      gap: 12px;
    }

    .flow-split {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
