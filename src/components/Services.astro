---
// Services.astro
---

<section class="services-section" id="keunggulan">
  <div class="services-container">
    
    <!-- Section Header (Left-aligned) -->
    <div class="services-header animate-fade-in" style="animation-delay: 100ms;">
      <h2 class="header-title">Layanan Unggulan Kami</h2>
      <p class="header-sub">
        Solusi digital end-to-end yang dirancang untuk memenuhi kebutuhan teknis dan operasional bisnis modern.
      </p>
    </div>

    <!-- Asymmetric Cards Grid -->
    <div class="services-grid">
      
      <!-- CARD 1: System Web & Mobile Development (Top Left - Large Card) -->
      <div class="service-card dev-card animate-fade-in" style="animation-delay: 250ms;">
        <div class="card-radial-glow bg-blue-glow"></div>
        
        <div class="card-icon-box blue-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3984FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
            <line x1="14" y1="4" x2="10" y2="20"/>
          </svg>
        </div>
        
        <h3 class="card-title">Sistem Web & Mobile Development</h3>
        <p class="card-desc">
          Bangun website, aplikasi, dan sistem informasi yang dirancang mengikuti proses bisnis, kebutuhan operasional, dan tujuan pertumbuhan perusahaan.
        </p>
        
        <!-- Service Pills -->
        <div class="service-tags dev-tags">
          <span class="service-tag tag-dev">Jasa Website Company Profile</span>
          <span class="service-tag tag-dev">Jasa Website Development</span>
          <span class="service-tag tag-dev">Jasa Mobile App Development</span>
          <span class="service-tag tag-dev">Jasa Sistem Informasi Custom</span>
          <span class="service-tag tag-dev">Jasa Integrasi Sistem</span>
          <span class="service-tag tag-dev">Jasa Migrasi Database</span>
        </div>
        
        <a href="/jasa-website-development" class="card-cta-link">
          Lihat Layanan Development
          <svg class="cta-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- CARD 2: Digital Marketing (Smaller Card - Top Right) -->
      <div class="service-card marketing-card animate-fade-in" style="animation-delay: 400ms;">
        <div class="card-radial-glow bg-cyan-glow"></div>
        
        <div class="card-icon-box cyan-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#39D5E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            <line x1="11" y1="8" x2="11" y2="14"/>
            <line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </div>
        
        <h3 class="card-title">Digital Marketing</h3>
        <p class="card-desc">
          Bangun visibilitas digital yang lebih kuat melalui strategi SEO dan konten yang dirancang untuk menjangkau calon pelanggan yang relevan.
        </p>
        
        <!-- Checklist items -->
        <ul class="checklist-items">
          <li>
            <svg class="check-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.5 6L4.5 8L9.5 3.5" stroke="#39D5E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="checklist-text">Jasa SEO Website</span>
          </li>
          <li>
            <svg class="check-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.5 6L4.5 8L9.5 3.5" stroke="#39D5E8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="checklist-text">Jasa Content SEO</span>
          </li>
        </ul>
        
        <a href="/layanan/seo-website" class="card-cta-link link-cyan">
          Lihat Layanan Marketing
          <svg class="cta-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- CARD 3: AI & Automation (Full Width - Bottom) -->
      <div class="service-card ai-card full-width-card animate-fade-in" style="animation-delay: 550ms;">
        
        <div class="dev-card-left">
          <div class="card-icon-box blue-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3984FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              <circle cx="12" cy="12" r="4"/>
            </svg>
          </div>
          
          <h3 class="card-title title-large">AI & Automation</h3>
          <p class="card-desc">
            Otomatisasi alur kerja dan integrasi AI untuk membantu bisnis mengurangi pekerjaan manual, mempercepat proses, dan meningkatkan efisiensi operasional.
          </p>
          
          <!-- AI Service tags -->
          <div class="service-tags ai-tags">
            <span class="service-tag tag-ai">Jasa AI Automation</span>
            <span class="service-tag tag-ai">Jasa WhatsApp Automation</span>
            <span class="service-tag tag-ai">Jasa AI Chatbot</span>
            <span class="service-tag tag-ai">Jasa Workflow Automation</span>
          </div>
          
          <a href="/layanan/ai-automation" class="card-cta-link">
            Lihat Layanan AI
            <svg class="cta-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <!-- RIGHT SIDE: Futuristic AI Enterprise Visual -->
        <div class="dev-card-right">
          <div class="tech-dashboard-wrapper">
            <!-- IDE Editor Mock representing AI Setup -->
            <div class="mock-ide">
              <div class="ide-dots">
                <span class="dot-btn red"></span>
                <span class="dot-btn yellow"></span>
                <span class="dot-btn green"></span>
                <span class="file-name">ai_agent_setup.py</span>
              </div>
              <pre class="ide-code"><code><span class="c-key">from</span> entercraft <span class="c-key">import</span> AIAgent, Workflow

agent = AIAgent(model=<span class="c-val">"gpt-4o-enterprise"</span>)
workflow = Workflow(trigger=<span class="c-val">"incoming_lead"</span>)

workflow.add_step(agent.analyze_intent)
workflow.add_step(agent.sync_crm)
workflow.add_step(agent.reply_whatsapp)

workflow.run() <span class="c-comment"># status: active</span></code></pre>
            </div>
            
            <!-- Nodes Flow Connection Mock (AI Agent Branching) -->
            <div class="mock-nodes">
              <svg width="100%" height="100%" viewBox="0 0 180 120" fill="none" class="mock-flow-svg">
                <!-- Background grid lines -->
                <line x1="0" y1="20" x2="180" y2="20" stroke="#1F2937" stroke-width="0.75" stroke-dasharray="2 3"/>
                <line x1="0" y1="60" x2="180" y2="60" stroke="#1F2937" stroke-width="0.75" stroke-dasharray="2 3"/>
                <line x1="0" y1="100" x2="180" y2="100" stroke="#1F2937" stroke-width="0.75" stroke-dasharray="2 3"/>
                
                <!-- Decision paths representing automation -->
                <path d="M20 60 C 60 60, 60 20, 100 20" stroke="#3984FF" stroke-width="1.5" class="flow-path-1"/>
                <path d="M20 60 L 100 60" stroke="#3984FF" stroke-width="1.5" class="flow-path-3"/>
                <path d="M20 60 C 60 60, 60 100, 100 100" stroke="#39D5E8" stroke-width="1.5" class="flow-path-2"/>
                
                <path d="M100 20 L 150 60" stroke="#3984FF" stroke-width="1.2" stroke-dasharray="2 2"/>
                <path d="M100 60 L 150 60" stroke="#3984FF" stroke-width="1.2" stroke-dasharray="2 2"/>
                <path d="M100 100 L 150 60" stroke="#39D5E8" stroke-width="1.2" stroke-dasharray="2 2"/>
                
                <!-- AI Node circles -->
                <circle cx="20" cy="60" r="4.5" fill="#3984FF" class="pulse-n1"/>
                <circle cx="100" cy="20" r="3.5" fill="#3984FF" class="pulse-n2"/>
                <circle cx="100" cy="60" r="3.5" fill="#3984FF" class="pulse-n5"/>
                <circle cx="100" cy="100" r="3.5" fill="#39D5E8" class="pulse-n3"/>
                <circle cx="150" cy="60" r="5.5" fill="#3984FF" class="pulse-n4"/>
              </svg>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* Section Layout */
  .services-section {
    position: relative;
    scroll-margin-top: 88px;
    width: 100%;
    background-color: var(--bg-primary); /* #05070D */
    border-top: 1px solid var(--border-color);
    padding-top: 90px; /* target: 80px – 100px */
    padding-bottom: 100px; /* target: 90px – 110px */
    overflow: hidden;
    box-sizing: border-box;
  }

  .services-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Section Header (Left-aligned) */
  .services-header {
    text-align: left;
    margin-bottom: 45px; /* target header -> cards: 40px – 50px */
    max-width: 700px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 44px; /* target: 42px - 48px */
    font-weight: 800; /* target: 700 - 800 */
    line-height: 1.1; /* target: 1.1 */
    letter-spacing: -1.5px; /* target: -1.5px */
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }

  .header-sub {
    font-family: 'Inter', sans-serif;
    font-size: 15px; /* target: 14px - 16px */
    line-height: 1.6;
    color: #8AA0C5; /* target: #8AA0C5 */
    max-width: 650px;
    margin: 0;
  }

  /* Services Asymmetric Grid */
  .services-grid {
    display: grid;
    grid-template-columns: 2.1fr 1fr; /* approx 68% and 32% */
    gap: 16px; /* target gap: 16px */
    width: 100%;
    box-sizing: border-box;
  }

  .ai-card {
    order: -1;
  }

  .dev-card,
  .marketing-card {
    order: 0;
  }

  /* Card base style */
  .service-card {
    position: relative;
    background-color: #111827; /* target card background: #111827 */
    border: 1px solid var(--border-color); /* target border: #263653 */
    border-radius: 12px; /* target: 10px – 12px */
    padding: 32px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1); /* target: 180–220ms */
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }

  /* Subtle Radial Glows for Featured Cards */
  .card-radial-glow {
    position: absolute;
    width: 250px;
    height: 250px;
    pointer-events: none;
    opacity: 0.15;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 1;
  }

  .bg-blue-glow {
    top: -80px;
    right: -80px;
    background: radial-gradient(circle, rgba(57, 132, 255, 0.6) 0%, rgba(57, 132, 255, 0) 70%);
  }

  .bg-cyan-glow {
    bottom: -100px;
    right: -100px;
    background: radial-gradient(circle, rgba(57, 213, 232, 0.4) 0%, rgba(57, 213, 232, 0) 70%);
  }

  /* Hover micro-interactions */
  .service-card:hover {
    transform: translateY(-2px); /* target: translateY -2px */
    border-color: var(--accent-blue); /* target: border becomes slightly brighter blue */
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(57, 132, 255, 0.05);
  }

  .service-card:hover .card-radial-glow {
    opacity: 0.25;
    transform: scale(1.05);
  }

  /* Card content details */
  .card-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 2;
  }

  .blue-icon {
    background-color: rgba(57, 132, 255, 0.1);
  }

  .cyan-icon {
    background-color: rgba(57, 213, 232, 0.1);
  }

  .card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 24px; /* target: 24px – 28px */
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    position: relative;
    z-index: 2;
    letter-spacing: -0.5px;
  }

  .title-large {
    font-size: 30px; /* target featured card: 28px – 32px */
    letter-spacing: -1px;
  }

  .card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px; /* target: 13px – 15px */
    line-height: 1.6;
    color: #7D96C5; /* secondary text */
    margin: 0 0 28px 0;
    position: relative;
    z-index: 2;
  }

  /* Tags/Pills list (AI & Automation / Web & Mobile) */
  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    position: relative;
    z-index: 2;
  }

  .service-tag {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px; /* target: 11px – 12px */
    padding: 7px 12px; /* target: 7px 12px */
    border-radius: 999px; /* target: 999px */
    font-weight: 500;
    line-height: 1.2;
    transition: all 0.18s ease;
  }

  /* Tag style: AI */
  .tag-ai {
    background-color: #1B263B; /* target bg: #1B263B */
    border: 1px solid #334155; /* target border: #334155 */
    color: #AFC4E5; /* target text: #AFC4E5 */
  }

  .service-card:hover .tag-ai {
    color: #FFFFFF;
    border-color: var(--accent-blue);
    background-color: #233352;
  }

  /* Tag style: Web & Mobile */
  .tag-dev {
    background-color: #10203A; /* target bg: #10203A */
    border: 1px solid #263653; /* target subtle blue border: #263653 */
    color: #AFC4E5;
  }

  .service-card:hover .tag-dev {
    color: #FFFFFF;
    border-color: var(--accent-blue);
    background-color: #152b4d;
  }

  /* Checklist items (Digital Marketing) */
  .checklist-items {
    list-style: none;
    margin: 0 0 32px 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    z-index: 2;
  }

  .checklist-items li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .check-icon {
    flex-shrink: 0;
    color: #39D5E8; /* target checkmark: #39D5E8 */
  }

  .checklist-text {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
  }

  /* Subtle CTA arrow link */
  .card-cta-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    position: relative;
    z-index: 2;
    transition: color 0.18s ease;
  }

  .cta-arrow {
    color: var(--text-muted);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.18s ease;
  }

  .card-cta-link:hover {
    color: var(--accent-blue);
  }

  .link-cyan:hover {
    color: #39D5E8;
  }

  .service-card:hover .cta-arrow {
    transform: translateX(4px);
    color: var(--accent-blue);
  }

  .service-card:hover .link-cyan .cta-arrow {
    color: #39D5E8;
  }

  /* CARD 3: Full Width Card layout */
  .full-width-card {
    grid-column: span 2;
    flex-direction: row; /* Horizontal layout on desktop */
    gap: 40px;
    align-items: center;
  }

  .dev-card-left {
    flex: 1.3; /* content area: ~65% */
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .dev-card-right {
    flex: 0.7; /* image area: ~35% */
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-width: 320px;
  }

  /* Tech Enterprise Schematic Panel */
  .tech-dashboard-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    background: #0B101B;
    border: 1px solid #1E293B;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.22s ease;
  }

  .service-card:hover .tech-dashboard-wrapper {
    border-color: var(--accent-blue);
    transform: scale(1.02); /* target image: slight scale 1.02 */
  }

  /* IDE Mock */
  .mock-ide {
    flex: 1.2;
    padding: 12px 16px;
    border-bottom: 1px solid #1E293B;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ide-dots {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .dot-btn {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .red { background-color: #EF4444; }
  .yellow { background-color: #F59E0B; }
  .green { background-color: #10B981; }

  .file-name {
    font-family: 'Inter', monospace;
    font-size: 10px;
    color: var(--text-muted);
    margin-left: 8px;
  }

  .ide-code {
    margin: 0;
    font-family: 'Inter', monospace;
    font-size: 11.5px;
    line-height: 1.4;
    color: #AFC4E5;
    overflow: hidden;
  }

  .c-key { color: var(--accent-blue); }
  .c-val { color: #39D5E8; }
  .c-bool { color: #F59E0B; }
  .c-comment { color: var(--text-muted); }

  /* Nodes SVG Flow Mock */
  .mock-nodes {
    flex: 0.8;
    position: relative;
    padding: 10px;
    box-sizing: border-box;
    background-color: rgba(7, 16, 32, 0.3);
  }

  .mock-flow-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Animation delays/staggered effects */
  .animate-fade-in {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Node flows stroke animations */
  .flow-path-1 {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: strokeDraw 4s linear infinite;
  }

  .flow-path-2 {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: strokeDraw 4s linear infinite 2s;
  }

  .flow-path-3 {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: strokeDraw 4s linear infinite 1s;
  }

  @keyframes strokeDraw {
    0% { stroke-dashoffset: 100; }
    50% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -100; }
  }

  /* Node pulses */
  .pulse-n1 { animation: nodePulse 2s infinite alternate; }
  .pulse-n2 { animation: nodePulse 2s infinite alternate 0.5s; }
  .pulse-n3 { animation: nodePulse 2s infinite alternate 1s; }
  .pulse-n4 { animation: nodePulse 2s infinite alternate 1.5s; }
  .pulse-n5 { animation: nodePulse 2s infinite alternate 0.75s; }

  @keyframes nodePulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.15); opacity: 1; filter: drop-shadow(0 0 3px var(--accent-blue)); }
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .services-grid {
      grid-template-columns: 1fr; /* tablet/mobile: 1 column stack */
    }

    .full-width-card {
      grid-column: span 1;
      flex-direction: column; /* vertically stacked */
      gap: 28px;
    }

    .dev-card-left, .dev-card-right {
      width: 100%;
      flex: none;
    }

    .dev-card-right {
      min-width: 100%;
    }
  }

  @media (max-width: 575px) {
    .services-section {
      padding-top: 80px;
      padding-bottom: 90px;
    }

    .header-title {
      font-size: 34px;
      letter-spacing: -1px;
    }

    .service-card {
      padding: 20px; /* target mobile padding: 20px */
    }

    .card-title {
      font-size: 22px;
    }

    .title-large {
      font-size: 26px;
    }

    .service-tag {
      padding: 6px 10px;
      font-size: 11px;
    }

    .tech-dashboard-wrapper {
      height: 180px;
    }

    .ide-code {
      font-size: 10.5px;
    }
  }
</style>
