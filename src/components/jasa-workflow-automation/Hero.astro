---
// Hero.astro (Jasa Workflow Automation)
---

<section class="hero-section">
  <!-- Subtle Glow Background -->
  <div class="hero-glow"></div>
  
  <div class="hero-container">
    <div class="hero-content">
      <!-- Tech Badge -->
      <div class="hero-badge animate-fade-in" style="animation-delay: 100ms;">
        <svg class="badge-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
        </svg>
        <span class="badge-text">WORKFLOW AUTOMATION</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-heading animate-fade-in" style="animation-delay: 250ms;">
        Jasa Workflow Automation untuk Menyederhanakan <span class="text-accent">Proses Kerja Bisnis</span>
      </h1>

      <!-- Description -->
      <p class="hero-description animate-fade-in" style="animation-delay: 400ms;">
        Hubungkan berbagai langkah kerja, approval, sistem, dan notifikasi agar proses bisnis berjalan lebih cepat, terstruktur, dan minim pekerjaan manual.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions animate-fade-in" style="animation-delay: 550ms;">
        <a href="/contact/" class="cta-primary">Konsultasikan Workflow Anda</a>
        <a href="#what-can-be-automated" class="cta-secondary">Lihat Contoh Workflow</a>
      </div>
    </div>
    
    <div class="hero-visual animate-fade-in" style="animation-delay: 700ms;">
      
      <!-- Visual Flowchart container -->
      <div class="workflow-diagram">
        
        <div class="wf-node wf-trigger">
          <div class="node-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="node-text">
            <span class="node-label">Trigger</span>
            <span class="node-title">Order Masuk</span>
          </div>
        </div>

        <div class="wf-connector"></div>

        <div class="wf-node wf-action">
          <div class="node-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          </div>
          <div class="node-text">
            <span class="node-label">Action</span>
            <span class="node-title">Validasi Sistem</span>
          </div>
        </div>

        <div class="wf-connector"></div>

        <div class="wf-node wf-human">
          <div class="node-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="node-text">
            <span class="node-label">Approval</span>
            <span class="node-title">Finance Verification</span>
          </div>
        </div>

        <div class="wf-connector"></div>

        <div class="wf-node wf-system">
          <div class="node-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <div class="node-text">
            <span class="node-label">Integration</span>
            <span class="node-title">Warehouse Task</span>
          </div>
        </div>

        <div class="wf-connector"></div>

        <div class="wf-node wf-notify">
          <div class="node-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          </div>
          <div class="node-text">
            <span class="node-label">Notification</span>
            <span class="node-title">Customer Notified</span>
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
    padding: 80px 24px;
    box-sizing: border-box;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    right: 10%;
    transform: translateY(-50%);
    width: 800px;
    height: 800px;
    background:
      radial-gradient(
        circle at center,
        rgba(34, 197, 94, 0.08) 0%,
        transparent 60%
      );
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 3;
    max-width: 1100px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* Tech Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 999px;
    margin-bottom: 34px;
    backdrop-filter: blur(4px);
  }

  .badge-icon {
    color: #22c55e;
  }

  .badge-text {
    font-family: "Inter", monospace;
    font-size: 10.5px;
    font-weight: 600;
    color: #22c55e;
    letter-spacing: 1.5px;
    line-height: 1;
  }

  .hero-heading {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 48px; 
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: var(--text-primary);
    margin: 0 0 25px 0;
  }

  .text-accent {
    color: #22c55e;
  }

  .hero-description {
    font-family: "Inter", sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6682b3;
    max-width: 550px;
    margin: 0 0 35px 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #22c55e;
    color: #000000;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-primary:hover {
    background: #4ade80;
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(34, 197, 94, 0.35);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid #34415a;
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary:hover {
    background: rgba(34, 197, 94, 0.1);
    border-color: #22c55e;
    transform: translateY(-1px);
  }

  /* Visual Section */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .workflow-diagram {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    background: rgba(7, 16, 32, 0.4);
    border: 1px solid #1B2A42;
    padding: 30px;
    border-radius: 16px;
    backdrop-filter: blur(10px);
    width: 100%;
    max-width: 320px;
  }

  .wf-node {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    background: #0B1424;
    border: 1px solid #1B2A42;
    padding: 12px 16px;
    border-radius: 12px;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .wf-node:hover {
    border-color: #2b3e5b;
    transform: translateX(4px);
  }

  .node-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .wf-trigger .node-icon { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
  .wf-action .node-icon { background: rgba(16, 185, 129, 0.15); color: #34d399; }
  .wf-human .node-icon { background: rgba(139, 92, 246, 0.15); color: #c4b5fd; }
  .wf-system .node-icon { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  .wf-notify .node-icon { background: rgba(236, 72, 153, 0.15); color: #f472b6; }

  .wf-trigger { border-left: 3px solid #60a5fa; }
  .wf-action { border-left: 3px solid #34d399; }
  .wf-human { border-left: 3px solid #c4b5fd; }
  .wf-system { border-left: 3px solid #fbbf24; }
  .wf-notify { border-left: 3px solid #f472b6; }

  .node-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .node-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #617AA7;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .node-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .wf-connector {
    width: 2px;
    height: 16px;
    background-color: #1B2A42;
    margin-left: 32px; /* align under icon */
  }

  /* Entrance Animation */
  .animate-fade-in {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specifics */
  :global(html[data-theme="light"]) .hero-glow {
    background:
      radial-gradient(
        circle at center,
        rgba(34, 197, 94, 0.15) 0%,
        transparent 60%
      );
  }

  :global(html[data-theme="light"]) .hero-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .workflow-diagram {
    background: rgba(255, 255, 255, 0.8);
    border-color: #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .wf-node {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .node-label {
    color: #64748B;
  }

  :global(html[data-theme="light"]) .node-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .wf-connector {
    background-color: #CBD5E1;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }
    
    .hero-content {
      align-items: center;
    }
    
    .hero-heading {
      font-size: 40px;
    }

    .workflow-diagram {
      margin: 0 auto;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding: 60px 16px;
    }
    
    .hero-heading {
      font-size: 32px;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
      padding: 0 20px;
      box-sizing: border-box;
    }
    
    .cta-primary, .cta-secondary {
      width: 100%;
    }
  }
</style>
