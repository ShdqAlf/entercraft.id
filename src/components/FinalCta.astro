---
// FinalCta.astro
---

<section class="cta-section" id="konsultasi">
  <div class="cta-container">
    <!-- Large Premium CTA Card -->
    <div class="cta-card animate-fade-scroll" style="animation-delay: 100ms;">
      <!-- Subtle Radial Blue Glow behind the card -->
      <div class="cta-glow-effect"></div>

      <div class="cta-grid">
        <!-- Left Side: Content (55%) -->
        <div class="cta-left-content">
          <div class="cta-eyebrow">
            <span class="eyebrow-dot">●</span> LET'S BUILD WHAT'S NEXT
          </div>

          <h2 class="cta-headline">
            Siap Membawa Bisnis Anda<br />
            ke Level Berikutnya?
          </h2>

          <p class="cta-subheadline">
            Ceritakan tantangan atau kebutuhan bisnis Anda. Kami akan membantu
            menemukan solusi teknologi yang tepat untuk mewujudkannya.
          </p>

          <!-- Buttons Row -->
          <div class="cta-actions">
            <a href="#konsultasi" class="btn-primary">
              Diskusikan Kebutuhan Anda <span class="btn-arrow">→</span>
            </a>
            <a href="#layanan" class="btn-secondary">
              Lihat Layanan Kami <span class="btn-arrow">→</span>
            </a>
          </div>

          <!-- Optional Micro Copy -->
          <span class="cta-micro-copy">
            From business challenges to digital solutions.
          </span>
        </div>

        <!-- Right Side: Abstract Technology Visual (45%) -->
        <div class="cta-right-visual">
          <div class="visual-network-box">
            <!-- SVG nodes/lines technical ecosystem diagram -->
            <svg
              class="visual-svg"
              viewBox="0 0 240 240"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <!-- Grid Circles -->
              <circle
                cx="120"
                cy="120"
                r="100"
                stroke="#3984FF"
                stroke-width="0.75"
                stroke-opacity="0.15"
                stroke-dasharray="1 3"></circle>
              <circle
                cx="120"
                cy="120"
                r="70"
                stroke="#39D5E8"
                stroke-width="0.75"
                stroke-opacity="0.15"></circle>
              <circle
                cx="120"
                cy="120"
                r="40"
                stroke="#3984FF"
                stroke-width="0.75"
                stroke-opacity="0.1"
                stroke-dasharray="2 2"></circle>

              <!-- Outer Glowing Connection Paths -->
              <path
                d="M120 20 C 180 20, 220 80, 220 120"
                stroke="#3984FF"
                stroke-width="1.2"
                stroke-opacity="0.25"
                class="anim-pulse-path"></path>
              <path
                d="M20 120 C 20 180, 60 220, 120 220"
                stroke="#39D5E8"
                stroke-width="1.2"
                stroke-opacity="0.25"></path>

              <!-- Connection Nodes -->
              <g class="node-group">
                <circle
                  cx="120"
                  cy="20"
                  r="4.5"
                  fill="#05070D"
                  stroke="#3984FF"
                  stroke-width="1.5"></circle>
                <circle
                  cx="220"
                  cy="120"
                  r="4.5"
                  fill="#05070D"
                  stroke="#39D5E8"
                  stroke-width="1.5"></circle>
                <circle
                  cx="120"
                  cy="220"
                  r="4.5"
                  fill="#05070D"
                  stroke="#3984FF"
                  stroke-width="1.5"></circle>
                <circle
                  cx="20"
                  cy="120"
                  r="4.5"
                  fill="#05070D"
                  stroke="#39D5E8"
                  stroke-width="1.5"></circle>

                <circle cx="120" cy="50" r="3" fill="#3984FF"></circle>
                <circle cx="190" cy="120" r="3" fill="#39D5E8"></circle>
                <circle cx="120" cy="190" r="3" fill="#3984FF"></circle>
                <circle cx="50" cy="120" r="3" fill="#39D5E8"></circle>
              </g>

              <!-- Central Core -->
              <circle
                cx="120"
                cy="120"
                r="16"
                fill="#0B1424"
                stroke="#3984FF"
                stroke-width="1.5"></circle>
              <circle cx="120" cy="120" r="6" fill="#39D5E8" class="core-pulse"
              ></circle>
            </svg>

            <!-- Floating Technical Micro Labels -->
            <span class="micro-tag label-ai" style="top: 30px; left: 30px;"
              >AI</span
            >
            <span class="micro-tag label-auto" style="top: 190px; left: 20px;"
              >AUTOMATION</span
            >
            <span class="micro-tag label-sys" style="top: 20px; right: 20px;"
              >SYSTEM</span
            >
            <span
              class="micro-tag label-data"
              style="bottom: 30px; right: 30px;">DATA</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Section base */
  .cta-section {
    position: relative;
    scroll-margin-top: 88px;
    width: 100%;
    background-color: var(--bg-primary); /* #05070D */
    padding-top: 110px; /* target top padding: 100px – 120px */
    padding-bottom: 90px; /* target bottom padding: 80px – 100px */
    overflow: hidden;
    box-sizing: border-box;
  }

  .cta-container {
    max-width: 1200px; /* target max-width: 1200px */
    margin: 0 auto; /* target margin: 0 auto */
    padding: 0 24px;
    position: relative;
    box-sizing: border-box;
  }

  /* Large Premium CTA Card */
  .cta-card {
    position: relative;
    width: 100%;
    min-height: 420px; /* target height: 380px – 460px */
    border-radius: 16px; /* target radius: 16px */
    background: linear-gradient(
      135deg,
      #0b1424 0%,
      #102c50 100%
    ); /* target: #0B1424 to #102C50 */
    border: 1px solid rgba(57, 132, 255, 0.25); /* target border: 1px solid rgba(57,132,255,0.25) */
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  /* Subtle blue glow behind card */
  .cta-glow-effect {
    position: absolute;
    top: 50%;
    right: 15%;
    transform: translate(50%, -50%);
    width: 450px;
    height: 450px;
    background: radial-gradient(
      circle,
      rgba(57, 132, 255, 0.15) 0%,
      rgba(57, 132, 255, 0) 70%
    ); /* target: 10% - 20% opacity */
    pointer-events: none;
    z-index: 1;
    filter: blur(50px);
  }

  /* 2-Column layout desktop */
  .cta-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr; /* target ratio: left 55%, right 45% */
    width: 100%;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  /* Left Side: Content */
  .cta-left-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px;
    box-sizing: border-box;
  }

  .cta-eyebrow {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .cta-headline {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 44px; /* target: 42px – 50px */
    font-weight: 800;
    line-height: 1.05; /* target: 1.05 */
    letter-spacing: -1.5px;
    color: #ffffff;
    margin: 0 0 20px 0;
    max-width: 600px; /* target max-width: 600px */
  }

  .cta-subheadline {
    font-family: "Inter", sans-serif;
    font-size: 15px; /* target: 14px – 16px */
    line-height: 1.7;
    color: #a4b6d2; /* target: #A4B6D2 */
    max-width: 550px; /* target max-width: 550px */
    margin: 0 0 36px 0;
  }

  /* Buttons block */
  .cta-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  /* Primary Button */
  .btn-primary {
    background-color: var(--accent-blue); /* target: #3984FF */
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13.5px; /* target: 13px – 14px */
    font-weight: 700; /* target: 600 – 700 */
    text-decoration: none;
    padding: 14px 22px; /* target: 14px 22px */
    border-radius: 8px; /* target: 8px, no rounded pill */
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(57, 132, 255, 0.2);
    box-sizing: border-box;
  }

  .btn-primary:hover {
    background-color: var(--accent-bright); /* slightly brighter */
    transform: translateY(-1px); /* target: translateY -1px */
    box-shadow: 0 6px 20px rgba(57, 132, 255, 0.45); /* subtle blue glow shadow */
  }

  .btn-primary .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Secondary Button */
  .btn-secondary {
    color: #7f95b8; /* target: #7F95B8 */
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
    box-sizing: border-box;
  }

  .btn-secondary:hover {
    color: #ffffff; /* target hover: #FFFFFF */
  }

  .btn-secondary .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Optional micro text */
  .cta-micro-copy {
    font-family: "Inter", sans-serif;
    font-size: 11px; /* target: 11px – 12px */
    color: #52698f; /* target: #52698F */
    letter-spacing: 0.5px;
  }

  /* Right Side: Abstract Technology Visual */
  .cta-right-visual {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 60px;
    position: relative;
    overflow: hidden;
  }

  .visual-network-box {
    position: relative;
    width: 280px;
    height: 280px;
  }

  .visual-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Micro Floating technical labels on right visual */
  .micro-tag {
    position: absolute;
    font-family: "Inter", sans-serif;
    font-size: 9px; /* target: 9px – 10px */
    font-weight: 700;
    letter-spacing: 1px; /* target: 1px */
    color: #7f95b8; /* target: #7F95B8 */
    border: 1px solid #263653; /* target: 1px solid #263653 */
    background: rgba(5, 7, 13, 0.6); /* target: rgba(5,7,13,0.5) */
    border-radius: 6px; /* target: 6px */
    padding: 3px 8px;
    text-transform: uppercase;
    pointer-events: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    user-select: none;
  }

  /* SVG animations */
  .core-pulse {
    animation: pulseCore 3s infinite alternate;
  }

  @keyframes pulseCore {
    0% {
      r: 5px;
      fill-opacity: 0.4;
      filter: drop-shadow(0 0 1px rgba(57, 213, 232, 0.4));
    }
    100% {
      r: 7.5px;
      fill-opacity: 0.9;
      filter: drop-shadow(0 0 6px rgba(57, 213, 232, 0.9));
    }
  }

  .anim-pulse-path {
    animation: dashPulse 4s infinite alternate;
  }

  @keyframes dashPulse {
    0% {
      stroke-opacity: 0.15;
    }
    100% {
      stroke-opacity: 0.4;
    }
  }

  /* Entrance Animation styling */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(20px); /* target card: translateY 20px */
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .cta-card {
      min-height: auto;
    }

    .cta-left-content {
      padding: 40px;
    }

    .cta-headline {
      font-size: 34px;
    }

    .cta-right-visual {
      padding-right: 40px;
    }

    .visual-network-box {
      width: 220px;
      height: 220px;
    }
  }

  @media (max-width: 768px) {
    /* MOBILE: Single Column Centered Layout */
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .cta-left-content {
      padding: 40px 24px 28px 24px;
      text-align: center;
      align-items: center;
    }

    .cta-eyebrow {
      justify-content: center;
    }

    .cta-headline {
      font-size: 30px; /* adjusted for better mobile line wraps */
      text-align: center;
      letter-spacing: -1px;
    }

    .cta-subheadline {
      text-align: center;
      font-size: 14px;
      margin: 0 auto 28px auto;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      width: 100%;
    }

    .btn-primary {
      width: 100%;
      justify-content: center;
      padding: 14px;
    }

    .btn-secondary {
      justify-content: center;
      align-self: center; /* prevent text link from stretching full-width */
      margin-top: 4px;
    }

    .cta-micro-copy {
      text-align: center;
      margin-top: 8px;
    }

    .cta-card {
      border-radius: 14px;
    }

    .cta-right-visual {
      width: 100%;
      height: 220px;
      justify-content: center;
      padding: 0 0 36px 0;
      margin-top: 0;
    }

    .visual-network-box {
      width: 180px;
      height: 180px;
    }

    /* Adjust micro labels for mobile visual safe zones */
    .micro-tag.label-sys {
      top: 10px;
      right: 0;
    }
    .micro-tag.label-ai {
      top: 15px;
      left: 0;
    }
    .micro-tag.label-auto {
      top: 140px;
      left: -10px;
    }
    .micro-tag.label-data {
      bottom: 20px;
      right: 0;
    }

    .cta-glow-effect {
      width: 300px;
      height: 300px;
      right: 25%;
    }
  }
</style>
