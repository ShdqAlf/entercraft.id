---
// ProblemSolution.astro

const problems = [
  {
    id: "01",
    title: "Terlalu Banyak Proses Manual",
    description: "Pekerjaan repetitif masih dilakukan secara manual, menghabiskan waktu tim dan meningkatkan risiko human error.",
    tags: ["Input Data", "Follow-up", "Reporting", "Administrasi"]
  },
  {
    id: "02",
    title: "Data Tersebar di Berbagai Sistem",
    description: "Data dan informasi bisnis tersebar di berbagai platform sehingga tim kesulitan mendapatkan informasi yang cepat dan terintegrasi.",
    tags: ["CRM", "Website", "Database", "WhatsApp"]
  },
  {
    id: "03",
    title: "Teknologi Tidak Mengikuti Kebutuhan Bisnis",
    description: "Sistem yang digunakan tidak lagi mampu mengikuti proses bisnis yang terus berkembang dan kebutuhan operasional yang semakin kompleks.",
    tags: ["Custom Workflow", "Scalability", "System Update", "New Features"]
  },
  {
    id: "04",
    title: "Digital Presence Belum Optimal",
    description: "Website dan konten digital belum sepenuhnya membantu bisnis mendapatkan visibility, traffic, dan peluang dari calon pelanggan yang relevan.",
    tags: ["SEO", "Content", "Visibility", "Traffic"]
  }
];

const solutions = [
  {
    title: "AI & AUTOMATION",
    description: "Otomatiskan proses yang berulang dan tingkatkan efisiensi tim dengan solusi berbasis AI dan workflow automation.",
    linkText: "Explore AI & Automation",
    href: "/layanan/ai-automation"
  },
  {
    title: "WEB & MOBILE DEVELOPMENT",
    description: "Bangun website, aplikasi, dan sistem informasi yang dirancang mengikuti kebutuhan dan proses bisnis Anda.",
    linkText: "Explore Development",
    href: "/jasa-website-development"
  },
  {
    title: "DIGITAL MARKETING",
    description: "Bangun digital presence yang lebih kuat dan optimalkan website agar lebih mudah ditemukan oleh calon pelanggan yang relevan.",
    linkText: "Explore Digital Marketing",
    href: "/layanan/seo-website"
  }
];
---

<section class="prob-sol-section">
  <div class="prob-sol-container">
    
    <!-- Section Header (Left-aligned) -->
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> THE CHALLENGE
      </div>
      <h2 class="header-title">
        Bisnis Anda Berkembang.<br />
        Apakah Sistem Anda Bisa Mengikutinya?
      </h2>
      <p class="header-intro">
        Seiring bisnis bertumbuh, proses yang awalnya sederhana bisa menjadi semakin kompleks. Kami membantu menyederhanakan proses, menghubungkan sistem, dan membangun solusi digital yang sesuai dengan kebutuhan bisnis Anda.
      </p>
    </div>

    <!-- Problem Grid (2x2 on desktop/tablet, 1x4 on mobile) -->
    <div class="problems-grid">
      {problems.map((prob, index) => (
        <div class="problem-panel animate-fade-scroll" style={`animation-delay: ${250 + (index * 100)}ms;`}>
          <!-- Subtle Top Border Accent on Hover -->
          <div class="panel-accent-line"></div>
          
          <div class="panel-header">
            <span class="problem-number">{prob.id}</span>
          </div>
          <h3 class="problem-title">{prob.title}</h3>
          <p class="problem-description">{prob.description}</p>
          <div class="problem-tags">
            {prob.tags.map((tag) => (
              <span class="problem-tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Solution Transition -->
    <div class="solution-transition animate-fade-scroll" style="animation-delay: 650ms;">
      <h3 class="transition-title">Saatnya Mengubah Kompleksitas Menjadi Efisiensi.</h3>
      <p class="transition-subtitle">
        Kami menggabungkan AI, automation, software development, dan digital strategy untuk membangun solusi yang benar-benar sesuai dengan kebutuhan bisnis.
      </p>
    </div>

    <!-- Solution Categories Grid (3 columns) -->
    <div class="solutions-grid">
      {solutions.map((sol, index) => (
        <div class="solution-card animate-fade-scroll" style={`animation-delay: ${750 + (index * 100)}ms;`}>
          <div class="card-glow"></div>
          <h4 class="solution-title">{sol.title}</h4>
          <p class="solution-desc">{sol.description}</p>
          <a href={sol.href} class="solution-link">
            {sol.linkText}
            <svg class="link-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Outer Section styling */
  .prob-sol-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 90px 24px 100px 24px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .prob-sol-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Section Header (Left-aligned) */
  .section-header {
    text-align: left;
    margin-bottom: 56px;
    max-width: 800px;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 50px; /* target: 48px - 60px */
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px; /* target: 15px - 17px */
    line-height: 1.7;
    color: #6682B3;
    max-width: 650px;
    margin: 0;
  }

  /* Problems Grid (2x2) */
  .problems-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    width: 100%;
    margin-bottom: 90px; /* spacing metrics -> solution transition */
    box-sizing: border-box;
  }

  /* Dark Bordered Panel styling */
  .problem-panel {
    position: relative;
    background-color: rgba(7, 16, 32, 0.2);
    border: 1px solid #1B2A42; /* target: 1px solid #1B2A42 */
    border-radius: 12px;
    padding: 32px; /* target: 28px - 34px */
    display: flex;
    flex-direction: column;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  /* Top border decoration indicator that activates on hover */
  .panel-accent-line {
    position: absolute;
    top: 0;
    left: 32px;
    width: 0px;
    height: 2px;
    background-color: var(--accent-blue);
    transition: width 0.2s ease;
  }

  .problem-panel:hover {
    transform: translateY(-2px);
    border-color: #2b3e5b;
    background-color: rgba(7, 16, 32, 0.4);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }

  .problem-panel:hover .panel-accent-line {
    width: 40px;
  }

  .panel-header {
    margin-bottom: 16px;
    display: flex;
    align-items: center;
  }

  .problem-number {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-blue);
    letter-spacing: 1px;
  }

  .problem-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .problem-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5; /* secondary text */
    margin: 0 0 24px 0;
  }

  /* Tags */
  .problem-tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .problem-tag {
    font-family: 'Inter', sans-serif;
    font-size: 10.5px;
    color: #617AA7;
    background-color: #0B1424;
    border: 1px solid #1D304B;
    border-radius: 6px;
    padding: 4px 10px;
    transition: all 0.15s ease;
  }

  .problem-panel:hover .problem-tag {
    color: #8fa7d4;
    border-color: #2b4369;
  }

  /* Solution Transition Area */
  .solution-transition {
    text-align: center;
    margin: 0 auto 56px auto;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .transition-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 28px; /* target: 24px – 30px */
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 16px 0;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .transition-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 15px; /* target: 14px - 16px */
    line-height: 1.6;
    color: #617AA7;
    margin: 0;
    max-width: 650px;
  }

  /* Solutions Categories Grid */
  .solutions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Solution Card designs */
  .solution-card {
    position: relative;
    background-color: rgba(7, 16, 32, 0.15);
    border: 1px solid var(--border-color); /* target: dark border */
    border-radius: 12px;
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1); /* target: transition ~ 180ms */
    min-height: 250px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 0%, rgba(57, 132, 255, 0.05) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .solution-card:hover {
    border-color: var(--accent-blue); /* target: border becomes slightly more blue */
    transform: translateY(-2px); /* target: translateY -2px */
    background-color: rgba(7, 16, 32, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(57, 132, 255, 0.05);
  }

  .solution-card:hover .card-glow {
    opacity: 1;
  }

  .solution-card .solution-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #8fa7d4; /* muted primary text initially */
    margin: 0 0 16px 0;
    text-transform: uppercase;
    transition: color 0.18s ease;
  }

  .solution-card:hover .solution-title {
    color: #FFFFFF; /* target: title becomes white */
  }

  .solution-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0 0 28px 0;
  }

  .solution-link {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    transition: color 0.18s ease;
  }

  .link-arrow {
    color: var(--text-muted);
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), color 0.18s ease; /* target: transition ~ 180ms */
  }

  .solution-card:hover .solution-link {
    color: var(--accent-blue);
  }

  .solution-card:hover .link-arrow {
    transform: translateX(4px); /* target: arrow slightly moves right */
    color: var(--accent-blue); /* target: arrow changes to blue */
  }

  /* Entrance animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .header-title {
      font-size: 42px; /* target: tablet 38px - 44px */
      letter-spacing: -1.2px;
    }

    .solutions-grid {
      grid-template-columns: 1fr 1fr; /* tablet: 2 + 1 dynamic row */
      gap: 20px;
    }
    
    .solution-card:last-child {
      grid-column: span 2;
      min-height: auto;
    }
  }

  @media (max-width: 767px) {
    .prob-sol-section {
      padding: 60px 16px 70px 16px;
    }

    .section-header {
      margin-bottom: 40px;
    }

    .header-title {
      font-size: 36px;
      letter-spacing: -1px;
    }

    .problems-grid {
      grid-template-columns: 1fr; /* mobile: 1 column */
      gap: 16px;
      margin-bottom: 60px;
    }

    .problem-panel {
      padding: 24px;
    }

    .solution-transition {
      margin-bottom: 40px;
    }

    .transition-title {
      font-size: 22px;
    }

    .solutions-grid {
      grid-template-columns: 1fr; /* mobile: 1 column */
      gap: 16px;
    }

    .solution-card:last-child {
      grid-column: span 1;
    }
  }
</style>
