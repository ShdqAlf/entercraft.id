---
// Architecture.astro (Jasa Integrasi Sistem)

const steps = [
  {
    title: "Authentication",
    description: "Memastikan request berasal dari sistem atau client yang memiliki akses (token/API key).",
    icon: "shield"
  },
  {
    title: "Integration Layer",
    description: "Menangkap (receive) data dari System A sebelum diproses lebih lanjut.",
    icon: "layers"
  },
  {
    title: "Validation",
    description: "Memeriksa apakah data memenuhi format dan aturan wajib (required fields) yang dibutuhkan.",
    icon: "check-circle"
  },
  {
    title: "Transformation",
    description: "Mengubah struktur data (mapping) agar persis seperti yang diminta oleh sistem tujuan.",
    icon: "shuffle"
  },
  {
    title: "Business Rules",
    description: "Menentukan kondisi khusus bagaimana data harus diproses sebelum diteruskan.",
    icon: "git-branch"
  }
];
---

<section class="arch-section">
  <div class="arch-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Bangun Jalur Integrasi yang Terstruktur</h2>
      <p class="header-intro">
        Integrasi yang baik bukan sekadar melempar data, melainkan memastikan data tersebut aman, valid, dan dapat dipahami oleh sistem penerima.
      </p>
    </div>

    <div class="arch-diagram animate-fade-scroll" style="animation-delay: 200ms;">
      
      <!-- System A (Source) -->
      <div class="system-box source">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        <span>System A (Source)</span>
      </div>

      <div class="down-arrow">↓</div>

      <!-- Middleware Steps -->
      <div class="middleware-box">
        <div class="mw-header">Entercraft Integration Layer</div>
        <div class="mw-steps">
          {steps.map((step, index) => (
            <>
              <div class="mw-step">
                <div class="step-icon">
                  {step.icon === 'shield' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                  {step.icon === 'layers' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>}
                  {step.icon === 'check-circle' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>}
                  {step.icon === 'shuffle' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>}
                  {step.icon === 'git-branch' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>}
                </div>
                <div class="step-content">
                  <h4>{step.title}</h4>
                  <p>{step.description}</p>
                </div>
              </div>
              {index < steps.length - 1 && <div class="step-divider"></div>}
            </>
          ))}
        </div>
      </div>

      <div class="down-arrow">↓</div>

      <!-- System B (Destination) -->
      <div class="system-box dest">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        <span>System B (Destination)</span>
        <div class="dest-caption">Mengirim data atau menjalankan action pada sistem tujuan.</div>
      </div>

    </div>

  </div>
</section>

<style>
  .arch-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .arch-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    max-width: 700px;
    margin: 0;
  }

  /* Diagram Styles */
  .arch-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .system-box {
    width: 100%;
    padding: 24px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    text-align: center;
    border: 1px solid var(--border-color);
  }

  .system-box.source {
    background: rgba(16, 185, 129, 0.05);
    border-color: rgba(16, 185, 129, 0.3);
  }
  .system-box.source svg { color: #10B981; }

  .system-box.dest {
    background: rgba(139, 92, 246, 0.05);
    border-color: rgba(139, 92, 246, 0.3);
  }
  .system-box.dest svg { color: #A78BFA; }

  .dest-caption {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #94A3B8;
    margin-top: 4px;
  }

  .down-arrow {
    font-size: 24px;
    color: #475569;
    font-weight: bold;
    padding: 16px 0;
  }

  .middleware-box {
    width: 100%;
    background: rgba(10, 22, 44, 0.6);
    border: 2px dashed var(--accent-blue);
    border-radius: 16px;
    overflow: hidden;
  }

  .mw-header {
    background: rgba(57, 132, 255, 0.1);
    border-bottom: 1px solid rgba(57, 132, 255, 0.2);
    padding: 16px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .mw-steps {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .mw-step {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
  }

  .step-icon {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    flex-shrink: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .step-content h4 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .step-content p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #94A3B8;
    margin: 0;
  }

  .step-divider {
    width: 2px;
    height: 24px;
    background: #334155;
    margin-left: 19px; /* align with icon center */
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .arch-section {
    background-color: #F8FAFC;
  }
  
  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .system-box {
    background: #FFFFFF;
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .system-box.source {
    border-color: #10B981;
  }

  :global(html[data-theme="light"]) .system-box.dest {
    border-color: #8B5CF6;
  }

  :global(html[data-theme="light"]) .dest-caption {
    color: #64748B;
  }

  :global(html[data-theme="light"]) .down-arrow {
    color: #94A3B8;
  }

  :global(html[data-theme="light"]) .middleware-box {
    background: #FFFFFF;
    border-color: var(--accent-blue);
  }

  :global(html[data-theme="light"]) .mw-header {
    background: #F8FAFC;
    border-bottom-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .step-icon {
    background: #F1F5F9;
  }

  :global(html[data-theme="light"]) .step-content h4 {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .step-content p {
    color: #64748B;
  }

  :global(html[data-theme="light"]) .step-divider {
    background: #E2E8F0;
  }

  @media (max-width: 767px) {
    .arch-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 30px;
    }

    .system-box {
      font-size: 16px;
    }

    .mw-steps {
      padding: 16px;
    }

    .mw-step {
      gap: 12px;
    }
  }
</style>
