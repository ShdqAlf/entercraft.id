---
// Security.astro (Jasa Integrasi Sistem)

const features = [
  {
    title: "Encryption in Transit",
    description: "Seluruh pertukaran data antar sistem dilindungi menggunakan protokol HTTPS/TLS untuk memastikan data operasional Anda tidak dapat dicegat di tengah jalan (man-in-the-middle).",
    icon: "lock"
  },
  {
    title: "Authentication & Authorization",
    description: "Kami menerapkan standar keamanan ketat seperti OAuth 2.0, API Keys dengan sistem rotasi, atau IP Whitelisting agar hanya sistem Anda yang sah yang dapat mengirim dan menerima data.",
    icon: "key"
  },
  {
    title: "Detailed Audit Logs",
    description: "Setiap aliran data dan request dicatat (logging). Jika terjadi ketidaksesuaian jumlah transaksi, Anda dapat melacak kembali tepat pada jam dan detik berapa data tersebut masuk atau ditolak.",
    icon: "file-search"
  }
];
---

<section class="security-section">
  <div class="security-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Keamanan Data dalam Proses Integrasi</h2>
      <p class="header-intro">
        Saat Anda membuka akses antar sistem, keamanan adalah prioritas mutlak. Kami memastikan gerbang data Anda terlindungi dari akses yang tidak sah.
      </p>
    </div>

    <div class="security-grid">
      {features.map((feature, index) => (
        <div class="security-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="sec-icon">
            {feature.icon === 'lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>}
            {feature.icon === 'key' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>}
            {feature.icon === 'file-search' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><circle cx="11.5" cy="14.5" r="2.5"></circle><line x1="13.27" y1="16.27" x2="16" y2="19"></line></svg>}
          </div>
          <h3 class="sec-title">{feature.title}</h3>
          <p class="sec-description">{feature.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .security-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .security-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    max-width: 700px;
    margin: 0;
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .security-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    transition: all 0.3s ease;
  }

  .security-card:hover {
    transform: translateY(-4px);
    border-color: rgba(57, 132, 255, 0.4);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .sec-icon {
    width: 56px;
    height: 56px;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sec-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .sec-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #94A3B8;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .security-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .security-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .security-card:hover {
    border-color: rgba(57, 132, 255, 0.5);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .sec-icon {
    background: #F1F5F9;
  }

  :global(html[data-theme="light"]) .sec-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .sec-description {
    color: #64748B;
  }

  @media (max-width: 991px) {
    .security-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .security-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .security-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
