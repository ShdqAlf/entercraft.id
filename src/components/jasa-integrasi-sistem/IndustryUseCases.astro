---
// IndustryUseCases.astro (Jasa Integrasi Sistem)

const industries = [
  {
    title: "Retail & E-Commerce",
    description: "Mensinkronisasikan pesanan dari Website E-Commerce, stok barang di ERP/Inventory, dan mesin kasir (POS) di toko fisik agar jumlah stok selalu akurat di semua saluran penjualan.",
    icon: "shopping-bag"
  },
  {
    title: "Manufaktur & Distribusi",
    description: "Menghubungkan aplikasi Sales lapangan (CRM) dengan Warehouse Management System (WMS). Order masuk langsung memotong alokasi stok dan memberikan instruksi pengiriman secara instan.",
    icon: "box"
  },
  {
    title: "Layanan Profesional & B2B",
    description: "Mengintegrasikan formulir pendaftaran prospek ke CRM, dan setelah deal terjadi (Won), sistem secara otomatis membuat draft kontrak/invoice di sistem Finance.",
    icon: "briefcase"
  }
];
---

<section class="industry-section">
  <div class="industry-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Solusi Integrasi untuk Berbagai Industri</h2>
      <p class="header-intro">
        Setiap industri memiliki proses bisnis dan tumpukan aplikasi (tech stack) yang unik. Kami menyesuaikan arsitektur integrasi dengan cara Anda bekerja.
      </p>
    </div>

    <div class="industry-list">
      {industries.map((ind, index) => (
        <div class="industry-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="ind-icon">
            {ind.icon === 'shopping-bag' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>}
            {ind.icon === 'box' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>}
            {ind.icon === 'briefcase' && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>}
          </div>
          <div class="ind-content">
            <h3 class="ind-title">{ind.title}</h3>
            <p class="ind-description">{ind.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .industry-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .industry-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    max-width: 700px;
    margin: 0;
  }

  .industry-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .industry-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    gap: 32px;
    transition: all 0.3s ease;
  }

  .industry-card:hover {
    transform: translateX(8px);
    border-color: rgba(57, 132, 255, 0.4);
    background-color: rgba(57, 132, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .ind-icon {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--accent-blue);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .industry-card:hover .ind-icon {
    background: rgba(57, 132, 255, 0.1);
  }

  .ind-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ind-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .ind-description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #94A3B8;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .industry-section {
    background-color: #FFFFFF;
  }
  
  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .industry-card {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .industry-card:hover {
    border-color: rgba(57, 132, 255, 0.5);
    background-color: rgba(57, 132, 255, 0.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .ind-icon {
    background: #F1F5F9;
  }

  :global(html[data-theme="light"]) .industry-card:hover .ind-icon {
    background: #EFF6FF;
  }

  :global(html[data-theme="light"]) .ind-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .ind-description {
    color: #64748B;
  }

  @media (max-width: 767px) {
    .industry-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .industry-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
      gap: 24px;
    }
    .industry-card:hover {
      transform: translateY(-4px); /* Vertical hover on mobile */
    }
    .ind-icon {
      width: 64px;
      height: 64px;
    }
    .ind-title {
      font-size: 20px;
    }
  }
</style>
