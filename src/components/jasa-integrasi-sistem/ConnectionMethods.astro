---
// ConnectionMethods.astro (Jasa Integrasi Sistem)

const methods = [
  {
    title: "API Integration",
    description: "Menghubungkan dua sistem atau lebih menggunakan REST/GraphQL API. Sistem dapat saling 'memanggil' untuk bertukar data atau mengeksekusi instruksi (action).",
    flow: "System A → API → System B",
    icon: "code"
  },
  {
    title: "Webhook",
    description: "Mengirimkan data secara real-time tepat ketika sebuah event terjadi, sehingga sistem tujuan tidak perlu melakukan polling (bertanya) secara berulang.",
    flow: "Event (Order Created) → Webhook → ERP",
    icon: "zap"
  },
  {
    title: "Database Integration",
    description: "Membaca dan menulis data langsung ke tingkat basis data (MySQL, PostgreSQL) untuk kondisi di mana akses API tidak tersedia namun akses server dimungkinkan.",
    flow: "System A → Database → System B",
    icon: "database"
  },
  {
    title: "Scheduled Sync (Batch)",
    description: "Menjalankan sinkronisasi data dalam jumlah besar pada jadwal tertentu (misal: setiap jam 12 malam) untuk menghindari beban berlebih pada server saat jam sibuk.",
    flow: "System A → Scheduled Sync → System B",
    icon: "clock"
  },
  {
    title: "File-Based Integration",
    description: "Memproses data dari file terstruktur (CSV, Excel, XML) yang dilempar secara berkala. Alternatif kuat jika integrasi modern benar-benar tidak tersedia.",
    flow: "CSV / Excel / File → Processing → Destination",
    icon: "file-text"
  }
];
---

<section class="methods-section">
  <div class="methods-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Bagaimana Kami Menghubungkan Sistem?</h2>
      <p class="header-intro">
        Tidak ada satu cara mutlak. Pendekatan dipilih berdasarkan arsitektur, batasan teknologi pada sistem Anda, volume data, dan seberapa cepat data tersebut dibutuhkan.
      </p>
    </div>

    <div class="methods-list">
      {methods.map((method, index) => (
        <div class="method-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="method-icon">
            {method.icon === 'code' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
            {method.icon === 'zap' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
            {method.icon === 'database' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
            {method.icon === 'clock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>}
            {method.icon === 'file-text' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>}
          </div>
          
          <div class="method-content">
            <h3 class="method-title">{method.title}</h3>
            <p class="method-description">{method.description}</p>
            
            <div class="method-flow">
              <code>{method.flow}</code>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .methods-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .methods-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    max-width: 700px;
    margin: 0;
  }

  .methods-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .method-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    gap: 24px;
    transition: all 0.3s ease;
    align-items: flex-start;
  }

  .method-card:hover {
    transform: translateX(8px);
    border-color: rgba(57, 132, 255, 0.4);
    background-color: rgba(57, 132, 255, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .method-icon {
    width: 56px;
    height: 56px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--accent-blue);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .method-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  .method-description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #94A3B8;
    margin: 0;
  }

  .method-flow {
    margin-top: 8px;
  }

  .method-flow code {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #10B981;
    padding: 6px 12px;
    border-radius: 6px;
    font-family: monospace;
    font-size: 13px;
    display: inline-block;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .methods-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .method-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .method-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .method-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .method-card:hover {
    border-color: rgba(57, 132, 255, 0.5);
    background-color: rgba(57, 132, 255, 0.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .method-icon {
    background: #F1F5F9;
  }

  :global(html[data-theme="light"]) .method-flow code {
    background: #F8FAFC;
    border-color: #E2E8F0;
    color: #059669;
  }

  @media (max-width: 767px) {
    .methods-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 30px;
    }

    .method-card {
      flex-direction: column;
      padding: 24px;
      gap: 16px;
    }
    
    .method-card:hover {
      transform: translateY(-4px); /* Change to vertical hover on mobile */
    }

    .method-icon {
      margin-bottom: 8px;
    }

    .method-flow code {
      word-break: break-all;
    }
  }
</style>
