---
// Problem.astro (Jasa Integrasi Sistem)

const problems = [
  {
    title: "Data Terpisah (Siloed)",
    description: "CRM, ERP, website, spreadsheet, dan aplikasi internal masing-masing menyimpan versinya sendiri tanpa terhubung.",
    icon: "database"
  },
  {
    title: "Input Berulang",
    description: "Tim operasional Anda harus memasukkan (re-entry) informasi yang persis sama ke dalam beberapa sistem yang berbeda.",
    icon: "copy"
  },
  {
    title: "Tidak Ada Sinkronisasi",
    description: "Perubahan atau update pada satu sistem (misal: status order di web) tidak langsung tercermin di sistem lainnya.",
    icon: "refresh-cw"
  },
  {
    title: "Sulit Mendapat Data Utuh",
    description: "Tim harus membuka dan mencocokkan beberapa aplikasi sekaligus hanya untuk mendapatkan satu informasi pelanggan yang utuh.",
    icon: "search"
  }
];
---

<section class="problem-section" id="problem">
  <div class="problem-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Sistem Anda Sudah Banyak, tetapi Mengapa Data Masih Harus Dipindahkan Manual?</h2>
      <p class="header-intro">
        Software yang terpisah (siloed) dapat membuat tim melakukan pekerjaan tambahan yang tidak perlu, hanya untuk memindahkan data dari satu aplikasi ke aplikasi lainnya.
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((prob, index) => (
        <div class="problem-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="problem-icon">
            {prob.icon === 'database' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
            {prob.icon === 'copy' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>}
            {prob.icon === 'refresh-cw' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>}
            {prob.icon === 'search' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>}
          </div>
          <h3 class="problem-title">{prob.title}</h3>
          <p class="problem-description">{prob.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .problem-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .problem-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 850px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #94A3B8;
    max-width: 700px;
    margin: 0;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .problem-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* Red accent on hover to indicate "problem" */
  .problem-card:hover {
    transform: translateY(-4px);
    border-color: rgba(239, 68, 68, 0.4);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .problem-icon {
    width: 48px;
    height: 48px;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: all 0.3s ease;
  }

  .problem-card:hover .problem-icon {
    background: rgba(239, 68, 68, 0.2);
    transform: scale(1.05);
  }

  .problem-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .problem-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #94A3B8;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .problem-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .problem-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .problem-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .problem-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .problem-card:hover {
    border-color: rgba(239, 68, 68, 0.5);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 991px) {
    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .problem-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
