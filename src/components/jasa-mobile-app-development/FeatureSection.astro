---
interface Item {
  title: string;
  description: string;
  meta?: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro: string;
  items: Item[];
}

const { id, eyebrow, title, intro, items } = Astro.props;
---

<section class="feature-section" id={id}>
  <div class="feature-container">
    <header class="section-header animate-fade-scroll">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{intro}</p>
    </header>

    <div class="feature-grid">
      {items.map((item, index) => (
        <article class="feature-card animate-fade-scroll" style={`animation-delay: ${index * 80}ms`}>
          <span class="feature-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            {item.meta && <span class="feature-meta">{item.meta}</span>}
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-section {
    width: 100%;
    padding: 96px 24px;
    box-sizing: border-box;
    background: var(--bg-primary);
    border-top: 1px solid var(--border-color);
  }

  .feature-section:nth-of-type(even) {
    background: var(--bg-secondary);
  }

  .feature-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .section-header {
    max-width: 760px;
    margin: 0 auto 52px;
    text-align: center;
  }

  .eyebrow,
  .feature-meta {
    color: var(--accent-blue);
    font: 700 11px/1.2 'Plus Jakarta Sans', sans-serif;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .section-header h2 {
    margin: 14px 0 16px;
    color: #fff;
    font: 800 38px/1.2 'Plus Jakarta Sans', sans-serif;
  }

  .section-header p,
  .feature-card p {
    margin: 0;
    color: #7d96c5;
    font: 400 16px/1.7 'Inter', sans-serif;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .feature-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    min-height: 180px;
    padding: 26px;
    box-sizing: border-box;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: rgba(10, 22, 44, 0.42);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
  }

  .feature-number {
    color: var(--accent-blue);
    font: 800 13px/1 'Plus Jakarta Sans', sans-serif;
  }

  .feature-card h3 {
    margin: 8px 0 10px;
    color: #fff;
    font: 700 19px/1.3 'Plus Jakarta Sans', sans-serif;
  }

  .feature-card p {
    font-size: 14px;
  }

  .animate-fade-scroll {
    animation: fade-in-up 0.6s ease both;
  }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(html[data-theme="light"]) .feature-section,
  :global(html[data-theme="light"]) .feature-section:nth-of-type(even) {
    background: #f8fafc;
    border-color: #e2e8f0;
  }

  :global(html[data-theme="light"]) .section-header h2,
  :global(html[data-theme="light"]) .feature-card h3 {
    color: #0f172a;
  }

  :global(html[data-theme="light"]) .section-header p,
  :global(html[data-theme="light"]) .feature-card p {
    color: #475569;
  }

  :global(html[data-theme="light"]) .feature-card {
    background: #fff;
    border-color: #e2e8f0;
  }

  @media (max-width: 767px) {
    .feature-section { padding: 64px 16px; }
    .section-header h2 { font-size: 30px; }
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>
