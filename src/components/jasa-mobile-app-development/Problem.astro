---
// Problem.astro (Jasa Mobile App Development)

const problems = [
  {
    title: "Engagement Pelanggan Rendah",
    description: "Sulit mempertahankan loyalitas pelanggan karena interaksi hanya terbatas pada kunjungan fisik atau email yang jarang dibuka.",
    icon: "users"
  },
  {
    title: "Proses Lapangan Manual",
    description: "Tim operasional atau sales masih mengandalkan kertas atau spreadsheet, menyebabkan data tidak real-time dan rawan hilang.",
    icon: "clipboard"
  },
  {
    title: "Kompetitor Selangkah Lebih Maju",
    description: "Pesaing bisnis Anda sudah menawarkan kemudahan transaksi via genggaman, membuat pelanggan perlahan beralih ke mereka.",
    icon: "trending-up"
  },
  {
    title: "Sistem Internal Terpisah",
    description: "Sistem ERP atau database perusahaan sulit diakses staf di luar kantor, menghambat mobilitas dan pengambilan keputusan cepat.",
    icon: "layers"
  }
];
---

<section class="problem-section" id="problem">
  <div class="problem-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Tantangan Bisnis Saat Mengabaikan Potensi Mobile App</h2>
      <p class="header-intro">
        Di era mobilitas tinggi, bergantung pada sistem lama atau sekadar website seringkali menimbulkan hambatan operasional dan hilangnya potensi pendapatan.
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((prob, index) => (
        <div class="problem-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="problem-icon">
            {prob.icon === 'users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>}
            {prob.icon === 'clipboard' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>}
            {prob.icon === 'trending-up' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>}
            {prob.icon === 'layers' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>}
          </div>
          <h3 class="problem-title">{prob.title}</h3>
          <p class="problem-description">{prob.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .problem-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .problem-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6682B3;
    max-width: 650px;
    margin: 0;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .problem-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .problem-card:hover {
    transform: translateY(-4px);
    border-color: rgba(239, 68, 68, 0.4);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .problem-icon {
    width: 48px;
    height: 48px;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .problem-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .problem-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .problem-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .problem-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .problem-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .problem-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .problem-card:hover {
    border-color: rgba(239, 68, 68, 0.5);
    background-color: rgba(239, 68, 68, 0.02);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 991px) {
    .problem-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .problem-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 30px;
    }
    .problem-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
