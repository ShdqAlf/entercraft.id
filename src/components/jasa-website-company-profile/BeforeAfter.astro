---
// BeforeAfter.astro (Jasa Website Company Profile)
---

<section class="before-after-section" id="before-after">
  <div class="ba-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Perbedaan Website Lama vs Website B2B Profesional</h2>
      <p class="header-intro">
        Website bukan sekadar brosur online. Ini adalah aset digital yang harus bekerja aktif mendukung sales dan marketing perusahaan Anda.
      </p>
    </div>

    <div class="ba-comparison animate-fade-scroll" style="animation-delay: 250ms;">
      
      <!-- BEFORE -->
      <div class="ba-column ba-before">
        <div class="column-header">
          <span class="badge before-badge">WEBSITE LAMA (TEMPLATE)</span>
        </div>
        
        <ul class="comparison-list before-list">
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Desain kaku, usang, dan terlihat murahan</span>
          </li>
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Tampilan berantakan saat dibuka di HP</span>
          </li>
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Loading sangat lambat (lebih dari 5 detik)</span>
          </li>
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Tidak ada ajakan bertindak (Call-to-Action) jelas</span>
          </li>
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Informasi perusahaan dan layanan sulit dicari</span>
          </li>
          <li>
            <div class="icon-x">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </div>
            <span>Tidak terindeks dengan baik di Google (SEO buruk)</span>
          </li>
        </ul>
      </div>

      <!-- AFTER -->
      <div class="ba-column ba-after">
        <div class="column-header">
          <span class="badge after-badge">WEBSITE ENTERCRAFT</span>
        </div>
        
        <ul class="comparison-list after-list">
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Desain modern, eksklusif, dan profesional (B2B)</span>
          </li>
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Responsive dan optimal untuk perangkat mobile</span>
          </li>
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Fast Loading (Skor performa tinggi)</span>
          </li>
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Navigasi user-friendly untuk Customer & Partner</span>
          </li>
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Sitemap jelas & Struktur SEO Foundation siap</span>
          </li>
          <li>
            <div class="icon-check">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>CTA terarah (Konsultasi via Email / WhatsApp)</span>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>

<style>
  .before-after-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
    border-top: 1px solid var(--border-color);
  }

  .ba-container {
    max-width: 1000px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 16px auto;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 700px;
    margin: 0 auto;
  }

  .ba-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .ba-column {
    background: rgba(7, 16, 32, 0.4);
    border: 1px solid #1B2A42;
    border-radius: 16px;
    padding: 40px;
    display: flex;
    flex-direction: column;
  }

  .ba-before {
    border-top: 4px solid #ef4444;
  }

  .ba-after {
    border-top: 4px solid #3984FF;
    background: rgba(57, 132, 255, 0.03);
    border-color: rgba(57, 132, 255, 0.2);
  }

  .column-header {
    margin-bottom: 30px;
    text-align: center;
  }

  .badge {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .before-badge {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .after-badge {
    background: rgba(57, 132, 255, 0.15);
    color: #3984FF;
  }

  /* List styles */
  .comparison-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .comparison-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.5;
  }

  .before-list li {
    color: #94a3b8;
  }

  .after-list li {
    color: #f8fafc;
    font-weight: 500;
  }

  .icon-x, .icon-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: -2px;
  }

  .icon-x {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .icon-check {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .before-after-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .ba-column {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .ba-after {
    background: rgba(57, 132, 255, 0.02);
    border-color: rgba(57, 132, 255, 0.3);
  }

  :global(html[data-theme="light"]) .before-list li {
    color: #64748b;
  }

  :global(html[data-theme="light"]) .after-list li {
    color: #0f172a;
  }

  /* Responsive */
  @media (max-width: 850px) {
    .ba-comparison {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .before-after-section {
      padding: 70px 16px;
    }

    .header-title {
      font-size: 32px;
    }

    .ba-column {
      padding: 24px;
    }
  }
</style>
