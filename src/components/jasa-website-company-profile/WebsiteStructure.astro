---
// WebsiteStructure.astro (Jasa Website Company Profile)
---

<section class="structure-section" id="structure">
  <div class="structure-container">
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> INFORMATION ARCHITECTURE
      </div>
      <h2 class="header-title">Struktur Konten yang Terorganisir</h2>
      <p class="header-intro">
        Kami merancang sitemap yang memudahkan pengunjung menemukan informasi, sekaligus disukai oleh mesin pencari (SEO). Berikut adalah contoh struktur dasar untuk website B2B.
      </p>
    </div>

    <!-- Sitemap Visualization -->
    <div class="sitemap-wrapper animate-fade-scroll" style="animation-delay: 250ms;">
      
      <!-- Homepage Root -->
      <div class="sitemap-root">
        <div class="node root-node">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          Homepage
        </div>
        <div class="root-line"></div>
      </div>

      <!-- Main Branches -->
      <div class="sitemap-branches">
        
        <!-- Branch 1: Company -->
        <div class="branch">
          <div class="node-connector"></div>
          <div class="node level-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22"></line><line x1="15" y1="22" x2="15" y2="22"></line><line x1="9" y1="6" x2="9" y2="6.01"></line></svg>
            Company
          </div>
          <div class="sub-nodes">
            <div class="node level-2">About Us</div>
            <div class="node level-2">Vision & Mission</div>
            <div class="node level-2">Management Team</div>
            <div class="node level-2">Certifications</div>
          </div>
        </div>

        <!-- Branch 2: Solutions -->
        <div class="branch">
          <div class="node-connector"></div>
          <div class="node level-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            Products / Services
          </div>
          <div class="sub-nodes">
            <div class="node level-2">Service Category A</div>
            <div class="node level-2">Service Category B</div>
            <div class="node level-2">Industry Solutions</div>
          </div>
        </div>

        <!-- Branch 3: Proof -->
        <div class="branch">
          <div class="node-connector"></div>
          <div class="node level-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            Portfolio & Insights
          </div>
          <div class="sub-nodes">
            <div class="node level-2">Case Studies</div>
            <div class="node level-2">Client List</div>
            <div class="node level-2">Company Blog / News</div>
          </div>
        </div>

        <!-- Branch 4: Contact -->
        <div class="branch">
          <div class="node-connector"></div>
          <div class="node level-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Contact
          </div>
          <div class="sub-nodes">
            <div class="node level-2">Contact Form</div>
            <div class="node level-2">Location Maps</div>
            <div class="node level-2">WhatsApp Redirect</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .structure-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .structure-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 20px auto;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 650px;
  }

  /* Sitemap Visualization Styles */
  .sitemap-wrapper {
    width: 100%;
    max-width: 900px;
    background: rgba(13, 20, 34, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 40px;
    box-sizing: border-box;
    overflow-x: auto;
  }

  .sitemap-root {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .node {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid;
    white-space: nowrap;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }

  .root-node {
    background: rgba(57, 132, 255, 0.1);
    border-color: rgba(57, 132, 255, 0.3);
    color: var(--accent-blue);
    font-size: 16px;
  }

  .root-line {
    width: 2px;
    height: 40px;
    background: var(--border-color);
  }

  .sitemap-branches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
    padding-top: 20px;
  }

  /* Horizontal connecting line across branches */
  .sitemap-branches::before {
    content: '';
    position: absolute;
    top: 0;
    left: 12.5%; /* Center of first col */
    right: 12.5%; /* Center of last col */
    height: 2px;
    background: var(--border-color);
  }

  .branch {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .node-connector {
    width: 2px;
    height: 20px;
    background: var(--border-color);
    position: absolute;
    top: -20px;
  }

  .level-1 {
    background: #1B2A42;
    border-color: #2b3e5b;
    color: #FFFFFF;
    margin-bottom: 20px;
    width: 100%;
    justify-content: center;
    box-sizing: border-box;
  }

  .sub-nodes {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding-left: 20px;
    position: relative;
  }

  .sub-nodes::before {
    content: '';
    position: absolute;
    top: -20px;
    bottom: 20px;
    left: 10px;
    width: 2px;
    background: var(--border-color);
  }

  .level-2 {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 13px;
    width: 100%;
    position: relative;
  }

  .level-2::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -10px;
    width: 10px;
    height: 2px;
    background: var(--border-color);
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .structure-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .sitemap-wrapper {
    background: #FFFFFF;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .root-line,
  :global(html[data-theme="light"]) .sitemap-branches::before,
  :global(html[data-theme="light"]) .node-connector,
  :global(html[data-theme="light"]) .sub-nodes::before,
  :global(html[data-theme="light"]) .level-2::before {
    background: #CBD5E1;
  }

  :global(html[data-theme="light"]) .level-1 {
    background: #F1F5F9;
    border-color: #CBD5E1;
    color: #1E293B;
  }

  :global(html[data-theme="light"]) .level-2 {
    background: #FFFFFF;
    border-color: #E2E8F0;
    color: #64748B;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .sitemap-branches {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }
    
    .sitemap-branches::before {
      display: none; /* Hide top connector on grid wrapping */
    }
    
    .branch {
      position: relative;
    }
    
    /* Recreate connectors for 2x2 grid */
    .branch:nth-child(1)::before,
    .branch:nth-child(2)::before {
      content: '';
      position: absolute;
      top: -20px;
      left: 50%;
      width: 2px;
      height: 20px;
      background: var(--border-color);
    }
    
    .branch:nth-child(3)::before,
    .branch:nth-child(4)::before {
       /* Connect to nothing above visually easily, so we hide them or create a custom vertical line */
       display: none;
    }
  }

  @media (max-width: 767px) {
    .structure-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 32px;
    }
    .sitemap-branches {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .sitemap-wrapper {
      padding: 20px;
    }
  }
</style>
