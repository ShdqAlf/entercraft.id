---
// DesignDevelopment.astro (Jasa Website Company Profile)

const features = [
  {
    title: "Responsive (Mobile-First)",
    description: "Tampilan otomatis menyesuaikan layar smartphone, tablet, maupun desktop untuk kenyamanan pengunjung.",
    icon: "smartphone"
  },
  {
    title: "Fast Loading",
    description: "Struktur kode dan aset gambar dioptimasi secara menyeluruh untuk menjamin skor PageSpeed tinggi.",
    icon: "zap"
  },
  {
    title: "SEO Foundation",
    description: "Dibangun dengan struktur HTML semantik, meta tags, dan sitemap XML otomatis yang disukai mesin pencari.",
    icon: "search"
  },
  {
    title: "Conversion Focused",
    description: "Alur navigasi didesain dengan penempatan Call to Action strategis untuk memaksimalkan inquiry.",
    icon: "cursor"
  },
  {
    title: "Scalable Architecture",
    description: "Website siap dikembangkan lebih jauh, baik untuk penambahan bahasa (multilingual) maupun fitur baru.",
    icon: "maximize"
  },
  {
    title: "Easy to Manage (CMS)",
    description: "Dilengkapi dashboard administrator yang user-friendly sehingga tim Anda bisa update konten tanpa coding.",
    icon: "edit"
  }
];
---

<section class="design-dev-section" id="design-dev">
  <div class="dd-container">
    <div class="dd-content">
      
      <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
        <div class="header-eyebrow">
          <span class="eyebrow-dot">●</span> DESIGN & DEVELOPMENT
        </div>
        <h2 class="header-title">Dibalik Tampilan Profesional, Ada Standar Kualitas Tinggi</h2>
        <p class="header-intro">
          Kami memastikan website perusahaan Anda bukan hanya indah dilihat, tetapi juga memiliki fondasi teknis yang kuat untuk mendukung performa bisnis.
        </p>
      </div>

      <div class="features-grid">
        {features.map((feature, index) => (
          <div class="feature-item animate-fade-scroll" style={`animation-delay: ${200 + (index * 50)}ms;`}>
            <div class="feature-icon">
              {feature.icon === 'smartphone' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>}
              {feature.icon === 'zap' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
              {feature.icon === 'search' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>}
              {feature.icon === 'cursor' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19-9.19a2 2 0 0 0-2.83 0l-9.19 9.19a2 2 0 0 0 0 2.83l9.19 9.19a2 2 0 0 0 2.83 0l9.19-9.19a2 2 0 0 0 0-2.83z"></path><line x1="12" y1="2" x2="12" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line></svg>}
              {feature.icon === 'maximize' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>}
              {feature.icon === 'edit' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>}
            </div>
            <div class="feature-text">
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-desc">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .design-dev-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .dd-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .dd-content {
    background-color: rgba(13, 20, 34, 0.3);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 60px;
    display: flex;
    flex-direction: column;
  }

  .section-header {
    margin-bottom: 50px;
    text-align: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 700px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px 40px;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
  }

  .feature-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 17px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .feature-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .design-dev-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .dd-content {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .feature-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .feature-desc {
    color: #475569;
  }

  @media (max-width: 767px) {
    .design-dev-section {
      padding: 60px 16px;
    }
    
    .dd-content {
      padding: 30px 24px;
    }

    .header-title {
      font-size: 28px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
