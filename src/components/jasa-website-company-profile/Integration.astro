---
// Integration.astro (Jasa Website Company Profile)
---

<section class="integration-section" id="integration">
  <div class="int-container">
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Terhubung dengan Sistem Operasional Anda</h2>
      <p class="header-intro">
        Website B2B modern bukan sistem yang berdiri sendiri. Kami dapat menghubungkan website Anda dengan berbagai tools yang sudah digunakan tim internal untuk mempermudah operasional.
      </p>
    </div>

    <div class="integration-visual animate-fade-scroll" style="animation-delay: 250ms;">
      
      <!-- Center: Website -->
      <div class="center-node">
        <div class="node-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        </div>
        <span>Company Website</span>
      </div>

      <!-- Connections -->
      <div class="connections">
        <!-- Top Left -->
        <div class="connection-line line-tl"></div>
        <div class="satellite-node node-tl">
          <div class="sat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <span>WhatsApp API</span>
        </div>

        <!-- Top Right -->
        <div class="connection-line line-tr"></div>
        <div class="satellite-node node-tr">
          <div class="sat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <span>Email & Workspace</span>
        </div>

        <!-- Bottom Left -->
        <div class="connection-line line-bl"></div>
        <div class="satellite-node node-bl">
          <div class="sat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <span>CRM Systems</span>
        </div>

        <!-- Bottom Right -->
        <div class="connection-line line-br"></div>
        <div class="satellite-node node-br">
          <div class="sat-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          </div>
          <span>Analytics Tools</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .integration-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .int-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 16px auto;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 auto;
    max-width: 650px;
  }

  .integration-visual {
    position: relative;
    width: 100%;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center-node {
    position: relative;
    z-index: 10;
    width: 180px;
    height: 180px;
    background: #0f172a;
    border: 2px solid var(--accent-blue);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 0 40px rgba(57, 132, 255, 0.2);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    color: #FFFFFF;
  }

  .node-icon {
    color: var(--accent-blue);
  }

  .satellite-node {
    position: absolute;
    width: 140px;
    height: 60px;
    background: rgba(13, 20, 34, 0.8);
    border: 1px solid var(--border-color);
    border-radius: 30px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    gap: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #cbd5e1;
    z-index: 5;
    backdrop-filter: blur(4px);
  }

  .sat-icon {
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
  }

  .node-tl { top: 20px; left: 10%; }
  .node-tr { top: 20px; right: 10%; }
  .node-bl { bottom: 20px; left: 10%; }
  .node-br { bottom: 20px; right: 10%; }

  .connection-line {
    position: absolute;
    z-index: 1;
    border-top: 2px dashed rgba(57, 132, 255, 0.3);
  }

  .line-tl {
    width: 25%;
    top: 35%;
    left: 20%;
    transform: rotate(30deg);
  }
  
  .line-tr {
    width: 25%;
    top: 35%;
    right: 20%;
    transform: rotate(-30deg);
  }
  
  .line-bl {
    width: 25%;
    bottom: 35%;
    left: 20%;
    transform: rotate(-30deg);
  }
  
  .line-br {
    width: 25%;
    bottom: 35%;
    right: 20%;
    transform: rotate(30deg);
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .integration-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .center-node {
    background: #FFFFFF;
    color: #0F172A;
    box-shadow: 0 10px 30px rgba(57, 132, 255, 0.1);
  }

  :global(html[data-theme="light"]) .satellite-node {
    background: #FFFFFF;
    border-color: #E2E8F0;
    color: #334155;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .sat-icon {
    background: #F1F5F9;
    color: #64748b;
  }

  :global(html[data-theme="light"]) .connection-line {
    border-color: rgba(57, 132, 255, 0.4);
  }

  @media (max-width: 767px) {
    .integration-section {
      padding: 60px 16px;
    }
    
    .header-title {
      font-size: 32px;
    }

    .integration-visual {
      height: 500px;
    }

    .center-node {
      width: 140px;
      height: 140px;
      font-size: 14px;
    }

    .satellite-node {
      width: auto;
      min-width: 120px;
    }

    .node-tl { top: 0; left: 5%; }
    .node-tr { top: 0; right: 5%; }
    .node-bl { bottom: 0; left: 5%; }
    .node-br { bottom: 0; right: 5%; }

    .line-tl { top: 25%; left: 15%; width: 35%; transform: rotate(45deg); }
    .line-tr { top: 25%; right: 15%; width: 35%; transform: rotate(-45deg); }
    .line-bl { bottom: 25%; left: 15%; width: 35%; transform: rotate(-45deg); }
    .line-br { bottom: 25%; right: 15%; width: 35%; transform: rotate(45deg); }
  }
</style>
