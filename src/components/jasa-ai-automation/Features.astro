---
// Features.astro (Jasa AI Automation - What We Automate)

const features = [
  {
    title: "Lead Management",
    flow: "Capture → Qualification → Follow-up → CRM",
    description: "Tangkap prospek dari berbagai channel, kualifikasi secara otomatis dengan AI, dan catat langsung ke dalam CRM tanpa manual data entry.",
    icon: "users"
  },
  {
    title: "Customer Service",
    flow: "Message → AI Response → Routing → Escalation",
    description: "Beri respons instan ke pelanggan 24/7 menggunakan AI yang memahami konteks, dan teruskan pesan ke tim manusia hanya untuk kasus kompleks.",
    icon: "message-square"
  },
  {
    title: "Data Processing",
    flow: "Input → Validation → Transformation → Database",
    description: "Ambil data mentah dari berbagai format, biarkan AI membersihkan dan menstandarisasi data tersebut sebelum masuk ke sistem utama Anda.",
    icon: "database"
  },
  {
    title: "Reporting & Analytics",
    flow: "Data Source → Processing → Analysis → Report",
    description: "Gabungkan data operasional, proses secara otomatis setiap periode, dan hasilkan laporan analitik langsung ke email manajemen.",
    icon: "bar-chart-2"
  },
  {
    title: "Document Processing",
    flow: "Upload → AI Extraction → Validation → Database",
    description: "Ekstrak informasi penting dari invoice, KTP, atau dokumen fisik lainnya menggunakan OCR dan AI, lalu simpan terstruktur ke database.",
    icon: "file-text"
  },
  {
    title: "Internal Workflow",
    flow: "Trigger → Automation → Approval → Notification",
    description: "Sederhanakan proses persetujuan dan delegasi tugas internal. Otomatiskan notifikasi setiap kali ada perubahan status pekerjaan.",
    icon: "git-merge"
  }
];
---

<section class="features-section">
  <div class="features-container">
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Proses Bisnis Apa Saja yang Bisa Kami Otomatiskan?</h2>
      <p class="header-intro">
        Kami merancang otomasi untuk berbagai fungsi bisnis, membantu tim Anda fokus pada hal strategis alih-alih terjebak pada pekerjaan administratif.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <div class="feature-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="feature-icon">
            {feature.icon === 'users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>}
            {feature.icon === 'message-square' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>}
            {feature.icon === 'database' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
            {feature.icon === 'bar-chart-2' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
            {feature.icon === 'file-text' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>}
            {feature.icon === 'git-merge' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 9 9"></path></svg>}
          </div>
          <h3 class="feature-title">{feature.title}</h3>
          <div class="feature-flow">{feature.flow}</div>
          <p class="feature-description">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 40px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6682B3;
    max-width: 650px;
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    background-color: rgba(10, 22, 44, 0.4);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-blue);
    background-color: rgba(7, 16, 32, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: rgba(57, 132, 255, 0.1);
    color: var(--accent-blue);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .feature-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .feature-flow {
    font-family: 'Inter', monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-blue);
    background: rgba(57, 132, 255, 0.08);
    padding: 8px 12px;
    border-radius: 6px;
    margin-bottom: 16px;
    line-height: 1.4;
  }

  .feature-description {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specific Adjustments */
  :global(html[data-theme="light"]) .features-section {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .feature-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .feature-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .feature-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .feature-card:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 991px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .features-section {
      padding: 60px 16px;
    }
    .header-title {
      font-size: 32px;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
