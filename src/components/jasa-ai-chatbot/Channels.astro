---
// Channels.astro (Jasa AI Chatbot)

const channels = [
  { name: "Website", icon: "globe" },
  { name: "WhatsApp", icon: "message-square" },
  { name: "Customer Portal", icon: "layout" },
  { name: "Internal Portal", icon: "lock" },
  { name: "Sistem Eksternal", icon: "box" }
];
---

<section class="channels-section">
  <div class="channels-container">
    
    <div class="channels-content animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Gunakan AI Chatbot di Channel yang Sesuai dengan Bisnis Anda</h2>
      <p class="header-intro">
        AI Chatbot dapat dirancang untuk ditempatkan pada channel yang paling sering digunakan customer atau tim internal Anda.
      </p>
      
      <div class="channels-grid">
        {channels.map((ch, index) => (
          <div class="channel-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 50)}ms;`}>
            {ch.icon === 'globe' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>}
            {ch.icon === 'message-square' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>}
            {ch.icon === 'layout' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>}
            {ch.icon === 'lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>}
            {ch.icon === 'box' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16" y1="8" x2="8" y2="8"></line><line x1="16" y1="16" x2="8" y2="16"></line><line x1="8" y1="8" x2="8" y2="16"></line><line x1="16" y1="8" x2="16" y2="16"></line></svg>}
            <span class="channel-name">{ch.name}</span>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</section>

<style>
  .channels-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 80px 24px 100px 24px; /* Slightly less top padding since it often follows Benefits */
    box-sizing: border-box;
  }

  .channels-container {
    max-width: 1000px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .channels-content {
    background: rgba(10, 22, 44, 0.4);
    border: 1px solid #1B2A42;
    border-radius: 20px;
    padding: 60px 40px;
    text-align: center;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 34px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 auto 16px auto;
    max-width: 700px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 600px;
    margin: 0 auto 40px auto;
  }

  .channels-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1B2A42;
    padding: 12px 20px;
    border-radius: 999px;
    color: #A0B2D2;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .channel-card:hover {
    color: #FFFFFF;
    background: rgba(57, 132, 255, 0.15);
    border-color: rgba(57, 132, 255, 0.3);
    transform: translateY(-2px);
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .channels-section {
    background-color: #F8FAFC;
  }
  
  :global(html[data-theme="light"]) .channels-content {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .header-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro {
    color: #475569;
  }

  :global(html[data-theme="light"]) .channel-card {
    background: #F1F5F9;
    color: #475569;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .channel-card:hover {
    color: var(--accent-blue);
    background: #FFFFFF;
    border-color: var(--accent-blue);
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  /* Responsive Design */
  @media (max-width: 767px) {
    .channels-section {
      padding: 50px 16px 80px 16px;
    }

    .channels-content {
      padding: 40px 20px;
    }

    .header-title {
      font-size: 28px;
    }

    .channels-grid {
      flex-direction: column;
      align-items: stretch;
    }

    .channel-card {
      justify-content: center;
    }
  }
</style>
