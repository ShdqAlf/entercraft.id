---
// Hero.astro (Jasa AI Chatbot)
---

<section class="hero-section">
  <!-- Subtle Radial Glows -->
  <div class="hero-glow"></div>
  
  <div class="hero-container">
    <div class="hero-content">
      <!-- Tech Badge -->
      <div class="hero-badge animate-fade-in" style="animation-delay: 100ms;">
        <svg class="badge-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          <path d="M12 2v2"></path><path d="M12 20v2"></path>
        </svg>
        <span class="badge-text">JASA AI CHATBOT</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-heading animate-fade-in" style="animation-delay: 250ms;">
        Jasa AI Chatbot untuk Membantu Customer Mendapatkan <span class="text-accent">Jawaban Lebih Cepat</span>
      </h1>

      <!-- Description -->
      <p class="hero-description animate-fade-in" style="animation-delay: 400ms;">
        Bangun chatbot AI yang memahami pertanyaan pengguna, memberikan informasi berdasarkan knowledge bisnis Anda, dan meneruskan percakapan ke tim ketika membutuhkan bantuan manusia.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions animate-fade-in" style="animation-delay: 550ms;">
        <a href="/contact/" class="cta-primary">Konsultasikan AI Chatbot Anda</a>
        <a href="#demo" class="cta-secondary">Lihat Contoh Chatbot</a>
      </div>
    </div>
    
    <div class="hero-visual animate-fade-in" style="animation-delay: 700ms;">
      <div class="chat-interface">
        
        <!-- Header -->
        <div class="chat-header">
          <div class="chat-header-info">
            <div class="ai-avatar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div>
              <div class="ai-name">Business Assistant</div>
              <div class="ai-status">Online</div>
            </div>
          </div>
        </div>

        <!-- Chat Body -->
        <div class="chat-body">
          <div class="message msg-customer">
            <div class="msg-bubble">Berapa minimum order produk ini?</div>
            <div class="msg-time">09:41</div>
          </div>
          
          <div class="message msg-ai">
            <div class="msg-bubble">
              Minimum order produk A adalah 100 unit. Untuk kebutuhan di atas 500 unit, tim sales kami dapat membantu menyiapkan penawaran.
            </div>
            <div class="msg-time">09:41</div>
          </div>
        </div>
        
      </div>
      
      <!-- Mini Workflow -->
      <div class="mini-workflow">
        <div class="wf-node wf-kb">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          Knowledge Base
        </div>
        <div class="wf-arrow">↓</div>
        <div class="wf-node wf-ai">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          AI Chatbot
        </div>
        <div class="wf-arrow">↓</div>
        <div class="wf-node wf-resp">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Business Response
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
    padding: 80px 24px;
    box-sizing: border-box;
  }

  .hero-glow {
    position: absolute;
    top: 40%;
    left: 60%;
    transform: translate(-50%, -50%);
    width: 900px;
    height: 900px;
    background:
      radial-gradient(
        circle at 40% 40%,
        rgba(57, 132, 255, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 60% 60%,
        rgba(139, 92, 246, 0.05) 0%,
        transparent 40%
      );
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 3;
    max-width: 1100px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* Tech Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(57, 132, 255, 0.1);
    border: 1px solid rgba(57, 132, 255, 0.3);
    border-radius: 999px;
    margin-bottom: 34px;
    backdrop-filter: blur(4px);
  }

  .badge-icon {
    color: var(--accent-blue);
  }

  .badge-text {
    font-family: "Inter", monospace;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--accent-blue);
    letter-spacing: 1.5px;
    line-height: 1;
  }

  .hero-heading {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 48px; 
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: var(--text-primary);
    margin: 0 0 25px 0;
  }

  .text-accent {
    color: var(--accent-blue);
  }

  .hero-description {
    font-family: "Inter", sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6682b3;
    max-width: 550px;
    margin: 0 0 35px 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-blue);
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-primary:hover {
    background: var(--accent-bright);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(57, 132, 255, 0.35);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid #34415a;
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary:hover {
    background: var(--blue-dark-10);
    border-color: var(--accent-blue);
    transform: translateY(-1px);
  }

  /* Visual Section */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .chat-interface {
    width: 100%;
    max-width: 360px;
    background: rgba(10, 22, 44, 0.6);
    border: 1px solid #1B2A42;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    backdrop-filter: blur(10px);
  }

  .chat-header {
    background: rgba(7, 16, 32, 0.8);
    padding: 16px;
    border-bottom: 1px solid #1B2A42;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(57, 132, 255, 0.2);
    color: var(--accent-blue);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .ai-status {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #22c55e;
  }

  .chat-body {
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .message {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }

  .msg-customer {
    align-self: flex-end;
    align-items: flex-end;
  }

  .msg-ai {
    align-self: flex-start;
    align-items: flex-start;
  }

  .msg-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  .msg-customer .msg-bubble {
    background: #1B2A42;
    color: #FFFFFF;
    border-bottom-right-radius: 4px;
  }

  .msg-ai .msg-bubble {
    background: rgba(57, 132, 255, 0.15);
    border: 1px solid rgba(57, 132, 255, 0.3);
    color: #FFFFFF;
    border-bottom-left-radius: 4px;
  }

  .msg-time {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    color: #6682b3;
    margin-top: 4px;
  }

  .mini-workflow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .wf-node {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid;
  }

  .wf-kb {
    background: rgba(139, 92, 246, 0.1);
    border-color: rgba(139, 92, 246, 0.3);
    color: #c4b5fd;
  }

  .wf-ai {
    background: rgba(57, 132, 255, 0.1);
    border-color: rgba(57, 132, 255, 0.3);
    color: #93c5fd;
  }

  .wf-resp {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    color: #86efac;
  }

  .wf-arrow {
    color: #4b5563;
    font-size: 12px;
  }

  /* Entrance Animation */
  .animate-fade-in {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specifics */
  :global(html[data-theme="light"]) .hero-glow {
    background:
      radial-gradient(
        circle at 40% 40%,
        rgba(57, 132, 255, 0.15) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 60% 60%,
        rgba(139, 92, 246, 0.1) 0%,
        transparent 40%
      );
  }

  :global(html[data-theme="light"]) .chat-interface {
    background: rgba(255, 255, 255, 0.9);
    border-color: #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  :global(html[data-theme="light"]) .chat-header {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .ai-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .msg-customer .msg-bubble {
    background: #F1F5F9;
    color: #1E293B;
  }

  :global(html[data-theme="light"]) .msg-ai .msg-bubble {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .hero-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .wf-kb {
    color: #6d28d9;
  }

  :global(html[data-theme="light"]) .wf-ai {
    color: #1d4ed8;
  }

  :global(html[data-theme="light"]) .wf-resp {
    color: #15803d;
  }

  /* Responsive */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }
    
    .hero-content {
      align-items: center;
    }
    
    .hero-heading {
      font-size: 40px;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding: 60px 16px;
    }
    
    .hero-heading {
      font-size: 32px;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
      padding: 0 20px;
      box-sizing: border-box;
    }
    
    .cta-primary, .cta-secondary {
      width: 100%;
    }
  }
</style>
