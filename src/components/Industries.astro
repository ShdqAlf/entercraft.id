---
// Industries.astro

const industriesData = [
  {
    id: "manufacturing",
    num: "01",
    title: "Manufacturing",
    description: "Digitalisasi proses operasional untuk membantu bisnis manufaktur meningkatkan efisiensi, menghubungkan data, dan menyederhanakan workflow.",
    solutions: ["Process Automation", "System Integration", "Custom Information System", "Digital Presence"],
    cta: "Explore Manufacturing Solutions →",
    // Small Outline Factory Icon
    iconPath: "M2 22V9l6 3V9l6 3V9l6 3v10H2zm6 0v-4h4v4"
  },
  {
    id: "distribution",
    num: "02",
    title: "Distribution & Trading",
    description: "Solusi digital untuk membantu distributor dan perusahaan perdagangan mengelola proses, menghubungkan data, dan memperkuat aktivitas bisnis.",
    solutions: ["Workflow Automation", "System Integration", "Website Development", "SEO & Content"],
    cta: "Explore Distribution Solutions →",
    // Small Outline Distribution/Boxes Icon
    iconPath: "M10 21v-6.5L4 11M14 21v-6.5l6-3.5M12 3v7.5"
  },
  {
    id: "retail",
    num: "03",
    title: "Retail & F&B",
    description: "Bangun digital presence dan sistem pendukung operasional yang membantu bisnis retail dan F&B bekerja lebih terstruktur.",
    solutions: ["Website Development", "WhatsApp Automation", "Workflow Automation", "SEO & Content"],
    cta: "Explore Retail Solutions →",
    // Small Outline Store Icon
    iconPath: "M3 9l1-4h16l1 4M3 9v11a2 2 0 002 2h14a2 2 0 002-2V9M3 9h18M9 22v-6h6v6"
  },
  {
    id: "logistics",
    num: "04",
    title: "Logistics & Transportation",
    description: "Optimalkan workflow, integrasi data, dan proses operasional dengan solusi digital yang menyesuaikan kebutuhan bisnis logistik.",
    solutions: ["Workflow Automation", "System Integration", "Custom Information System", "Database Migration"],
    cta: "Explore Logistics Solutions →",
    // Small Outline Truck Icon
    iconPath: "M14 18H6a2 2 0 01-2-2V8a2 2 0 012-2h8m0 12h6a2 2 0 002-2v-4l-3-4h-5v10zM6 18a2 2 0 100 4 2 2 0 000-4z M18 18a2 2 0 100 4 2 2 0 000-4z"
  },
  {
    id: "property",
    num: "05",
    title: "Property & Construction",
    description: "Perkuat digital presence dan proses bisnis melalui website, sistem informasi, automation, dan strategi digital yang sesuai kebutuhan.",
    solutions: ["Website Development", "Custom Information System", "SEO", "Workflow Automation"],
    cta: "Explore Property Solutions →",
    // Small Outline Building Icon
    iconPath: "M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16M9 7h2 M9 11h2 M9 15h2 M13 7h2 M13 11h2 M13 15h2"
  },
  {
    id: "healthcare",
    num: "06",
    title: "Healthcare",
    description: "Bangun sistem dan workflow digital yang membantu organisasi healthcare mengelola proses, informasi, dan kebutuhan operasional secara lebih terstruktur.",
    solutions: ["Custom Information System", "System Integration", "Workflow Automation", "Website Development"],
    cta: "Explore Healthcare Solutions →",
    // Small Outline Medical Cross Icon
    iconPath: "M12 2v20M2 12h20M12 7h0 M12 17h0 M7 12h0 M17 12h0"
  },
  {
    id: "education",
    num: "07",
    title: "Education",
    description: "Digitalisasi proses administrasi, informasi, dan layanan pendidikan melalui website, sistem informasi, dan automation.",
    solutions: ["Website Development", "Custom Information System", "Workflow Automation", "AI Chatbot"],
    cta: "Explore Education Solutions →",
    // Small Outline Graduation Cap / Book Icon
    iconPath: "M12 2L2 7l10 5 10-5-10-5zm-8 8.5V17c0 2 4 3.5 8 3.5s8-1.5 8-3.5v-6.5"
  },
  {
    id: "professional",
    num: "08",
    title: "Professional Services",
    description: "Bangun digital presence, workflow, dan sistem pendukung bisnis untuk perusahaan jasa profesional yang ingin bekerja lebih efisien.",
    solutions: ["Website Development", "AI Automation", "Workflow Automation", "SEO & Content"],
    cta: "Explore Professional Services →",
    // Small Outline Briefcase Icon
    iconPath: "M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16M3 7h18a2 2 0 012 2v10a2 2 0 01-2 2H3a2 2 0 01-2-2V9a2 2 0 012-2z"
  }
];
---

<section class="ind-section" id="industri">
  <div class="ind-container">
    
    <!-- Section Header (Left-aligned) -->
    <div class="ind-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="ind-eyebrow">
        <span class="eyebrow-dot">●</span> INDUSTRIES
      </div>
      <h2 class="ind-title">
        Teknologi yang Mengikuti<br />
        Bisnis Anda
      </h2>
      <p class="ind-intro">
        Dari manufaktur hingga jasa profesional, kami menyesuaikan solusi digital dengan proses dan kebutuhan bisnis Anda.
      </p>
    </div>

    <!-- Desktop Selector Grid Layout -->
    <div class="ind-grid">
      
      <!-- Left side: Vertical navigation list -->
      <div class="ind-sidebar animate-fade-scroll" style="animation-delay: 250ms;">
        <nav class="ind-nav-list" aria-label="Industry Selector">
          {industriesData.map((ind, index) => (
            <button 
              class={`ind-nav-item ${index === 0 ? 'active' : ''}`}
              data-industry={ind.id}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`panel-${ind.id}`}
              id={`tab-${ind.id}`}
            >
              <span class="nav-number">{ind.num}</span>
              <span class="nav-title">{ind.title}</span>
            </button>
          ))}
        </nav>
      </div>

      <!-- Mobile Horizontal Scroll Pills (hidden on desktop) -->
      <div class="ind-mobile-selector-wrapper">
        <div class="ind-mobile-selector" role="tablist">
          {industriesData.map((ind, index) => (
            <button
              class={`ind-mobile-pill ${index === 0 ? 'active' : ''}`}
              data-industry={ind.id}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              {ind.title}
            </button>
          ))}
        </div>
      </div>

      <!-- Right side: Active Industry Content panel -->
      <div class="ind-panel animate-fade-scroll" style="animation-delay: 400ms;">
        
        <!-- Blueprint nodes visual background accent (opacity: 5-8%) -->
        <div class="ind-blueprint-accent">
          <svg width="100%" height="100%" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="20" y1="20" x2="180" y2="20" stroke="#3984FF" stroke-width="0.5" stroke-opacity="0.2" stroke-dasharray="1 3"/>
            <line x1="20" y1="75" x2="180" y2="75" stroke="#3984FF" stroke-width="0.5" stroke-opacity="0.2" stroke-dasharray="1 3"/>
            <line x1="20" y1="130" x2="180" y2="130" stroke="#3984FF" stroke-width="0.5" stroke-opacity="0.2" stroke-dasharray="1 3"/>
            <line x1="40" y1="10" x2="40" y2="140" stroke="#3984FF" stroke-width="0.5" stroke-opacity="0.2" stroke-dasharray="1 3"/>
            <line x1="160" y1="10" x2="160" y2="140" stroke="#3984FF" stroke-width="0.5" stroke-opacity="0.2" stroke-dasharray="1 3"/>
            
            <circle cx="40" cy="20" r="2.5" fill="#3984FF" fill-opacity="0.2"/>
            <circle cx="160" cy="75" r="2.5" fill="#39D5E8" fill-opacity="0.2"/>
            <circle cx="40" cy="130" r="2.5" fill="#3984FF" fill-opacity="0.2"/>
            
            <path d="M40 20 C 100 20, 100 75, 160 75" stroke="#3984FF" stroke-width="0.75" stroke-opacity="0.3"/>
            <path d="M40 130 C 100 130, 100 75, 160 75" stroke="#39D5E8" stroke-width="0.75" stroke-opacity="0.3"/>
          </svg>
        </div>

        <!-- Industry Details container -->
        <div class="ind-content-panels">
          {industriesData.map((ind, index) => (
            <div 
              class={`ind-content-panel ${index === 0 ? 'active' : ''}`}
              id={`content-${ind.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${ind.id}`}
            >
              <!-- Small Category Marker + Outline Icon -->
              <div class="panel-meta">
                <span class="panel-num">{ind.num} / INDUSTRY</span>
                {ind.iconPath && (
                  <div class="panel-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d={ind.iconPath} />
                    </svg>
                  </div>
                )}
              </div>

              <h3 class="panel-title">{ind.title}</h3>
              <p class="panel-desc">{ind.description}</p>
              
              <!-- Solution tags -->
              <div class="panel-solutions">
                {ind.solutions.map((sol) => (
                  <span class="solution-pill">{sol}</span>
                ))}
              </div>

              <!-- CTA Link -->
              <a href={`/industries/${ind.id}`} class="panel-cta">
                {ind.cta}
              </a>
            </div>
          ))}
        </div>

      </div>

    </div>

    <!-- Bottom Supporting Statement -->
    <div class="ind-supporting animate-fade-scroll" style="animation-delay: 600ms;">
      <p class="support-question">Tidak menemukan industri Anda?</p>
      <p class="support-answer">
        Selama bisnis Anda memiliki proses yang dapat dioptimalkan, solusi digital dapat disesuaikan dengan kebutuhan Anda.
      </p>
      <a href="/contact/" class="support-cta">
        Diskusikan Kebutuhan Anda <span class="support-arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* Section base */
  .ind-section {
    position: relative;
    scroll-margin-top: 88px;
    width: 100%;
    background-color: var(--bg-primary); /* #05070D */
    border-top: 1px solid var(--border-color);
    padding-top: 100px; /* target: 90px – 110px */
    padding-bottom: 110px; /* target: 100px – 120px */
    overflow: hidden;
    box-sizing: border-box;
  }

  .ind-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* Left-aligned Header */
  .ind-header {
    text-align: left;
    margin-bottom: 50px; /* target header -> selector: 45px – 55px */
    max-width: 800px;
  }

  .ind-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .ind-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 48px; /* target: 46px – 54px */
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .ind-intro {
    font-family: 'Inter', sans-serif;
    font-size: 15px; /* target: 14px – 16px */
    line-height: 1.7;
    color: #7F95B8; /* target: #7F95B8 */
    max-width: 650px;
    margin: 0;
  }

  /* Interactive grid */
  .ind-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.9fr;
    gap: 50px; /* target gap: 40px – 60px */
    width: 100%;
    margin-bottom: 70px;
    box-sizing: border-box;
  }

  /* Left Navigation Sidebar */
  .ind-sidebar {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border-color);
    padding-right: 24px;
    box-sizing: border-box;
  }

  .ind-nav-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ind-nav-item {
    background: none;
    border: none;
    padding: 13px 16px; /* target vertical padding: 12px – 14px */
    text-align: left;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px; /* target: 14px – 16px */
    font-weight: 500;
    color: #60779D; /* target: #60779D */
    cursor: pointer;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.2s ease;
  }

  .nav-number {
    font-family: 'Inter', monospace;
    font-size: 12px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  /* Hover state */
  .ind-nav-item:hover {
    color: #FFFFFF;
    background-color: rgba(13, 20, 34, 0.4);
  }

  .ind-nav-item:hover .nav-number {
    color: var(--accent-blue);
  }

  /* Active state */
  .ind-nav-item.active {
    color: #FFFFFF; /* target: white */
    background-color: #0D1728; /* target: subtle #0D1728 */
    font-weight: 600; /* target: 600 */
    border-left: 3px solid var(--accent-blue); /* left accent blue border */
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  .ind-nav-item.active .nav-number {
    color: var(--accent-blue); /* target number: #3984FF */
  }

  /* Mobile horizontal scroll selector (hidden on desktop) */
  .ind-mobile-selector-wrapper {
    display: none;
    width: 100%;
    margin-bottom: 24px;
    overflow-x: auto;
    /* Hide scrollbar for Chrome, Safari and Opera */
    -webkit-overflow-scrolling: touch;
  }

  .ind-mobile-selector-wrapper::-webkit-scrollbar {
    display: none;
  }

  .ind-mobile-selector {
    display: flex;
    gap: 10px;
    white-space: nowrap;
    padding: 4px 0;
  }

  .ind-mobile-pill {
    background-color: rgba(13, 20, 34, 0.4);
    border: 1px solid var(--border-color);
    color: #60779D;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px;
    padding: 8px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ind-mobile-pill.active {
    background-color: #0D1728;
    color: #FFFFFF;
    border-color: var(--accent-blue);
  }

  /* Right Panel: Content panel container */
  .ind-panel {
    background-color: #0D1422; /* target panel bg: #0D1422 */
    border: 1px solid var(--border-color); /* target border: 1px */
    border-radius: 12px; /* target radius: 8px – 12px */
    padding: 40px;
    position: relative;
    overflow: hidden;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
  }

  /* Blueprint Nodes Accent visual background */
  .ind-blueprint-accent {
    position: absolute;
    bottom: -10px;
    right: -10px;
    width: 260px;
    height: 180px;
    pointer-events: none;
    z-index: 1;
    color: var(--accent-blue);
    opacity: 0.06; /* target: 5% - 8% */
  }

  .ind-content-panels {
    position: relative;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Tab Panel transitions */
  .ind-content-panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px); /* target transition: translateY 8px */
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); /* target: 250-350ms */
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .ind-content-panel.active {
    position: relative;
    opacity: 1; /* target active: opacity 0 -> 1 */
    pointer-events: auto;
    transform: translateY(0); /* target active: translateY 0 */
  }

  /* Category indicator + Small outline icon */
  .panel-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 24px; /* target content internal spacing: 20px – 28px */
  }

  .panel-num {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-blue);
    letter-spacing: 1px;
  }

  .panel-icon-box {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-blue);
    opacity: 0.8;
  }

  .panel-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 34px; /* target industry title: 32px – 42px */
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 16px 0; /* internal spacing: 20px-28px */
    letter-spacing: -0.5px;
    text-transform: uppercase;
  }

  .panel-desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px; /* target description: 14px – 16px */
    line-height: 1.65;
    color: #7F95B8; /* secondary text */
    max-width: 580px;
    margin: 0 0 32px 0; /* internal spacing */
  }

  /* Tags/Pills related solution list */
  .panel-solutions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .solution-pill {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px; /* target tags: 11px – 12px */
    font-weight: 500;
    color: #AFC4E5;
    background-color: #10203A;
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    border-radius: 999px;
  }

  /* Panel CTA link */
  .panel-cta {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px; /* target cta: 12px – 13px */
    font-weight: 700;
    color: var(--accent-blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    transition: color 0.18s ease;
  }

  .panel-cta:hover {
    color: var(--accent-bright);
  }

  /* Supporting statement at the bottom */
  .ind-supporting {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 700px;
    margin: 30px auto 0 auto;
    border-top: 1px solid var(--border-color);
    padding-top: 40px;
  }

  .support-question {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .support-answer {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #7187AA;
    margin: 0 0 16px 0;
    max-width: 600px;
  }

  .support-cta {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-blue); /* target: color #3984FF */
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .support-arrow {
    transition: transform 0.2s ease;
  }

  .support-cta:hover {
    color: var(--accent-bright);
  }

  .support-cta:hover .support-arrow {
    transform: translateX(4px);
  }

  /* Entrance Animation CSS */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .ind-grid {
      grid-template-columns: 1.2fr 1.8fr;
      gap: 30px;
    }

    .ind-title {
      font-size: 38px;
      letter-spacing: -1px;
    }

    .panel-title {
      font-size: 28px;
    }
  }

  @media (max-width: 767px) {
    .ind-grid {
      grid-template-columns: 1fr; /* mobile: 1 column */
      gap: 0;
    }

    .ind-sidebar {
      display: none; /* Hide vertical navigation sidebar on mobile */
    }

    .ind-mobile-selector-wrapper {
      display: block; /* Show horizontal pills selector */
    }

    .ind-panel {
      padding: 30px 24px;
      min-height: auto;
    }

    .ind-content-panel {
      position: relative;
      display: none;
    }

    .ind-content-panel.active {
      display: flex;
    }
  }

  @media (max-width: 575px) {
    .ind-section {
      padding-top: 80px;
      padding-bottom: 90px;
    }

    .ind-title {
      font-size: 30px;
    }

    .panel-title {
      font-size: 24px;
    }

    .panel-desc {
      font-size: 14px;
    }

    .ind-supporting {
      margin-top: 24px;
      padding-top: 32px;
    }
  }
</style>

<script>
  // Handlers for industry interactive selectors
  document.addEventListener('DOMContentLoaded', () => {
    const navItems = document.querySelectorAll('.ind-sidebar .ind-nav-item');
    const mobilePills = document.querySelectorAll('.ind-mobile-selector .ind-mobile-pill');
    const contentPanels = document.querySelectorAll('.ind-content-panels .ind-content-panel');

    function setActiveIndustry(industryId: string | null) {
      if (!industryId) return;

      // Update desktop sidebar buttons
      navItems.forEach(item => {
        const itemIndustry = item.getAttribute('data-industry');
        if (itemIndustry === industryId) {
          item.classList.add('active');
          item.setAttribute('aria-selected', 'true');
        } else {
          item.classList.remove('active');
          item.setAttribute('aria-selected', 'false');
        }
      });

      // Update mobile horizontal pills
      mobilePills.forEach(pill => {
        const pillIndustry = pill.getAttribute('data-industry');
        if (pillIndustry === industryId) {
          pill.classList.add('active');
          pill.setAttribute('aria-selected', 'true');
        } else {
          pill.classList.remove('active');
          pill.setAttribute('aria-selected', 'false');
        }
      });

      // Update active content panel with transition classes
      contentPanels.forEach(panel => {
        const panelId = panel.id;
        if (panelId === `content-${industryId}`) {
          // Force layout recalculation for transition on mobile display toggle
          panel.style.display = 'flex';
          setTimeout(() => {
            panel.classList.add('active');
          }, 10);
        } else {
          panel.classList.remove('active');
          // On mobile, hide layout entirely after transition to avoid space collapse
          if (window.innerWidth <= 767) {
            setTimeout(() => {
              if (!panel.classList.contains('active')) {
                panel.style.display = 'none';
              }
            }, 300);
          } else {
            panel.style.display = '';
          }
        }
      });
    }

    // Bind click events on desktop sidebar items
    navItems.forEach(item => {
      item.addEventListener('click', () => {
        const industryId = item.getAttribute('data-industry');
        setActiveIndustry(industryId);
      });
    });

    // Bind click events on mobile horizontal pills
    mobilePills.forEach(pill => {
      pill.addEventListener('click', () => {
        const industryId = pill.getAttribute('data-industry');
        setActiveIndustry(industryId);
      });
    });
  });
</script>
