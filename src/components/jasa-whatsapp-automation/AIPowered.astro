---
// AIPowered.astro

const features = [
  {
    type: "Rule-Based Bot Biasa",
    icon: "bot",
    items: [
      "Hanya mengerti keyword tertentu",
      "Response kaku dan seperti robot",
      "Sering gagal mengerti variasi bahasa",
      "Pelanggan merasa frustrasi",
      "Hanya bisa mengikuti alur yang kaku"
    ],
    isAI: false
  },
  {
    type: "AI-Powered WhatsApp Automation",
    icon: "sparkles",
    items: [
      "Memahami bahasa natural & percakapan sehari-hari",
      "Response dinamis dan sangat relevan",
      "Mampu mengerti konteks & intensi pelanggan",
      "Pengalaman pelanggan jauh lebih baik",
      "Mampu melakukan ekstraksi data dari teks bebas"
    ],
    isAI: true
  }
];
---

<section class="ai-powered-section">
  <div class="ai-container">
    
    <div class="content-wrapper">
      
      <!-- Text Area -->
      <div class="text-area animate-fade-scroll" style="animation-delay: 100ms;">
        <div class="header-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sparkle-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          LEBIH DARI SEKADAR BOT
        </div>
        <h2 class="section-title">WhatsApp Automation + AI = Komunikasi yang Lebih Cerdas</h2>
        <p class="section-description">
          Automation standar bekerja berdasarkan rule "Jika A, maka B". Namun, dengan menambahkan kapabilitas AI (seperti NLP dan LLM) ke dalam workflow WhatsApp, sistem dapat berinteraksi seperti asisten manusia yang cerdas.
        </p>
        <p class="section-description">
          Entercraft mengintegrasikan AI Agent ke dalam alur WhatsApp Anda untuk memastikan pelanggan mendapatkan respons yang tepat, bukan balasan <em>template</em> yang kaku.
        </p>
      </div>

      <!-- Comparison Area -->
      <div class="comparison-area animate-fade-scroll" style="animation-delay: 300ms;">
        <div class="comp-cards">
          
          {features.map((feature, idx) => (
            <div class={`comp-card ${feature.isAI ? 'card-ai' : 'card-standard'}`}>
              <div class="card-header">
                <div class="icon-box">
                  {feature.icon === 'bot' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8" y2="16"></line><line x1="16" y1="16" x2="16" y2="16"></line></svg>}
                  {feature.icon === 'sparkles' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>}
                </div>
                <h3 class="card-title">{feature.type}</h3>
              </div>
              
              <ul class="feature-list">
                {feature.items.map(item => (
                  <li class="feature-item">
                    <span class="check-icon">
                      {feature.isAI 
                        ? <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        : <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      }
                    </span>
                    <span class="item-text">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .ai-powered-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .ai-powered-section::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 80%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .ai-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  /* Text Area */
  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #a855f7; /* Purple accent for AI */
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .sparkle-icon {
    color: #a855f7;
  }

  .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 24px 0;
  }

  .section-description {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 0 20px 0;
  }

  .section-description em {
    font-style: italic;
    color: #A0B2D2;
  }

  /* Comparison Area */
  .comp-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .comp-card {
    background: rgba(7, 16, 32, 0.4);
    border: 1px solid #1B2A42;
    border-radius: 16px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .card-ai {
    background: rgba(139, 92, 246, 0.05);
    border-color: rgba(139, 92, 246, 0.3);
    position: relative;
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .card-header {
    margin-bottom: 24px;
  }

  .icon-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .card-standard .icon-box {
    background: rgba(125, 150, 197, 0.1);
    color: #7D96C5;
  }

  .card-ai .icon-box {
    background: rgba(139, 92, 246, 0.2);
    color: #a855f7;
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
  }

  .card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
  }

  /* Feature List */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-standard .check-icon {
    color: #ef4444; /* Red cross for bad standard */
  }

  .card-ai .check-icon {
    color: #22c55e; /* Green check for AI */
  }

  .item-text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #A0B2D2;
    line-height: 1.5;
  }

  .card-ai .item-text {
    color: #D7E0F0;
    font-weight: 500;
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Specifics */
  :global(html[data-theme="light"]) .ai-powered-section {
    background-color: #FFFFFF;
  }

  :global(html[data-theme="light"]) .ai-powered-section::before {
    background: radial-gradient(circle, rgba(139, 92, 246, 0.05) 0%, transparent 60%);
  }

  :global(html[data-theme="light"]) .section-title,
  :global(html[data-theme="light"]) .card-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .section-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .comp-card {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .card-ai {
    background-color: #FFFFFF;
    border-color: #a855f7;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .item-text {
    color: #475569;
  }

  :global(html[data-theme="light"]) .card-ai .item-text {
    color: #1E293B;
  }

  /* Responsive Design */
  @media (max-width: 991px) {
    .content-wrapper {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    
    .section-title {
      font-size: 34px;
    }

    .card-ai {
      transform: none; /* Disable scale on mobile to prevent overflow */
    }
  }

  @media (max-width: 767px) {
    .ai-powered-section {
      padding: 70px 16px;
    }
    
    .comp-cards {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
