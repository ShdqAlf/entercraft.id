---
// Hero.astro (Jasa WhatsApp Automation)
---

<section class="hero-section">
  <!-- Subtle Radial Glows -->
  <div class="hero-glow"></div>
  <div class="hero-glow-secondary"></div>

  <!-- Background WhatsApp Workflow Decorations -->
  <div class="hero-bg-decorations" aria-hidden="true">
    <!-- SVG Communication Workflow Lines -->
    <svg class="bg-circuit-svg" viewBox="0 0 1440 700" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="circuit-grad-green" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#22c55e" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#3984ff" stop-opacity="0.05"/>
        </linearGradient>
        <linearGradient id="circuit-grad-blue" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#3984ff" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#39d5e8" stop-opacity="0.05"/>
        </linearGradient>
      </defs>

      <!-- Left Workflow Line -->
      <path class="circuit-path line-anim-1" d="M120 220 H 280 L 320 300 V 400 L 250 480 H 150" stroke="url(#circuit-grad-green)" stroke-width="1.5" stroke-dasharray="6 6"/>
      <circle cx="280" cy="220" r="4" fill="#22c55e" class="node-glow"/>
      <circle cx="320" cy="300" r="3" fill="#3984ff"/>
      <circle cx="250" cy="480" r="4" fill="#8b5cf6" class="node-glow"/>

      <!-- Right Workflow Line -->
      <path class="circuit-path line-anim-2" d="M1320 220 H 1160 L 1120 300 V 400 L 1190 480 H 1290" stroke="url(#circuit-grad-blue)" stroke-width="1.5" stroke-dasharray="6 6"/>
      <circle cx="1160" cy="220" r="4" fill="#3984ff" class="node-glow"/>
      <circle cx="1120" cy="300" r="3" fill="#39d5e8"/>
      <circle cx="1190" cy="480" r="4" fill="#39d5e8" class="node-glow"/>

      <!-- Center Data Flow Curve -->
      <path class="orbit-path" d="M320 540 C 600 440, 840 440, 1120 540" stroke="url(#circuit-grad-blue)" stroke-width="1.5" stroke-dasharray="4 8" opacity="0.45"/>
    </svg>
  </div>

  <div class="hero-container">
    <!-- Left Side: Copywriting -->
    <div class="hero-content">
      <!-- Tech Badge -->
      <div class="hero-badge animate-fade-in" style="animation-delay: 100ms;">
        <svg class="badge-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
        <span class="badge-text">JASA WHATSAPP AUTOMATION</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-heading animate-fade-in" style="animation-delay: 250ms;">
        Jasa WhatsApp Automation untuk Mengotomatiskan <span class="text-emerald">Komunikasi & Proses Bisnis</span>
      </h1>

      <!-- Description -->
      <p class="hero-description animate-fade-in" style="animation-delay: 400ms;">
        Bantu bisnis mengelola lead, customer service, follow-up, notifikasi, dan workflow melalui WhatsApp dengan proses yang lebih cepat, terstruktur, dan efisien.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions animate-fade-in" style="animation-delay: 550ms;">
        <a href="/contact/" class="cta-primary">Konsultasikan Kebutuhan Anda</a>
        <a href="#use-cases" class="cta-secondary">Lihat Use Case</a>
      </div>
    </div>

    <!-- Right Side: Visual WhatsApp Automation System -->
    <div class="hero-visual animate-fade-in" style="animation-delay: 700ms;">
      <div class="automation-flow">
        
        <!-- Input Layer -->
        <div class="flow-layer input-layer">
          <div class="flow-card">
            <div class="card-icon emerald">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div class="card-text">
              <span class="layer-name">WhatsApp Message In</span>
              <span class="layer-detail">Customer: "Halo, info produk..."</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow"></span></div>

        <!-- AI Engine / Router -->
        <div class="flow-layer ai-layer">
          <div class="flow-card highlight">
            <div class="card-icon purple">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
            <div class="card-text">
              <span class="layer-name">WhatsApp Auto Router</span>
              <span class="layer-detail">Intent Check & Contact Sync</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow delay-1"></span></div>

        <!-- API / Gateway Layer -->
        <div class="flow-layer gateway-layer">
          <div class="flow-card">
            <div class="card-icon blue">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                <line x1="6" y1="6" x2="6.01" y2="6"></line>
                <line x1="6" y1="18" x2="6.01" y2="18"></line>
              </svg>
            </div>
            <div class="card-text">
              <span class="layer-name">WhatsApp API Gateway</span>
              <span class="layer-detail">Official API / Cloud API</span>
            </div>
          </div>
        </div>

        <div class="flow-arrow"><span class="arrow-dot animate-flow delay-2"></span></div>

        <!-- Split Bottom: CRM / Auto Response -->
        <div class="flow-split">
          
          <!-- Save / Update CRM -->
          <div class="split-side">
            <div class="flow-card mini">
              <div class="card-icon cyan">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div class="card-text">
                <span class="layer-name small">CRM Lead Save</span>
                <span class="layer-detail small">Auto Contact Save</span>
              </div>
            </div>
          </div>

          <!-- Notification / Auto Reply -->
          <div class="split-side">
            <div class="flow-card mini">
              <div class="card-icon emerald">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="card-text">
                <span class="layer-name small">Catalog Sent</span>
                <span class="layer-detail small">Auto Reply Message</span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* Hero Section Wrapper */
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-primary);
    overflow: hidden;
    padding: 100px 24px 60px 24px;
    box-sizing: border-box;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(34, 197, 94, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34, 197, 94, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.7;
    pointer-events: none;
    z-index: 0;
  }

  /* Radial Glow Backgrounds */
  .hero-glow {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 850px;
    height: 850px;
    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(34, 197, 94, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 20% 75%,
        rgba(57, 132, 255, 0.04) 0%,
        transparent 40%
      );
    pointer-events: none;
    z-index: 1;
  }

  .hero-glow-secondary {
    position: absolute;
    top: 30%;
    right: 10%;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(57, 213, 232, 0.04) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* Background Decorations Layer */
  .hero-bg-decorations {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* SVG Circuit styling */
  .bg-circuit-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .node-glow {
    filter: drop-shadow(0 0 6px rgba(34, 197, 94, 0.6));
    animation: pulseNode 3s infinite ease-in-out;
  }

  @keyframes pulseNode {
    0%, 100% { r: 4px; opacity: 0.7; }
    50% { r: 5.5px; opacity: 1; filter: drop-shadow(0 0 10px rgba(34, 197, 94, 0.9)); }
  }

  /* Main Container (Grid) */
  .hero-container {
    position: relative;
    z-index: 3;
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* Tech Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(7, 32, 16, 0.5);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 999px;
    margin-bottom: 24px;
    backdrop-filter: blur(4px);
    box-sizing: border-box;
  }

  .badge-icon {
    color: #22c55e;
    flex-shrink: 0;
  }

  .badge-text {
    font-family: "Inter", monospace;
    font-size: 10.5px;
    font-weight: 600;
    color: #22c55e;
    letter-spacing: 1.5px;
    line-height: 1;
  }

  /* Large Typography Heading */
  .hero-heading {
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 46px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: var(--text-primary);
    margin: 0 0 20px 0;
    text-transform: none;
    text-shadow: 0 4px 32px rgba(0, 0, 0, 0.7);
  }

  .text-emerald {
    color: #22c55e;
  }

  /* Description */
  .hero-description {
    font-family: "Inter", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6682b3;
    max-width: 520px;
    margin: 0 0 35px 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  /* CTA Buttons */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-blue);
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 0 0 rgba(57, 132, 255, 0);
  }

  .cta-primary:hover {
    background: var(--accent-bright);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(57, 132, 255, 0.35);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid #34415a;
    color: #ffffff;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 14px;
    font-weight: 700;
    height: 44px;
    padding: 0 24px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-secondary:hover {
    background: var(--blue-dark-10);
    border-color: var(--accent-blue);
    transform: translateY(-1px);
  }

  /* Visual Flow Diagram (Right Panel) */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .automation-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 440px;
    background: rgba(10, 22, 44, 0.4);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 20px;
    padding: 30px;
    box-sizing: border-box;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .flow-layer {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .flow-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(13, 20, 34, 0.75);
    border: 1px solid rgba(57, 132, 255, 0.2);
    border-radius: 12px;
    padding: 16px 20px;
    width: 100%;
    transition: all 0.3s ease;
  }

  .flow-card.highlight {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.05);
    box-shadow: 0 0 25px rgba(34, 197, 94, 0.15);
  }

  .flow-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .card-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon.blue { background: rgba(57, 132, 255, 0.1); color: var(--accent-blue); }
  .card-icon.cyan { background: rgba(57, 213, 232, 0.1); color: #39d5e8; }
  .card-icon.purple { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; }
  .card-icon.emerald { background: rgba(34, 197, 94, 0.1); color: #22c55e; }
  .card-icon.gold { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }

  .card-text {
    display: flex;
    flex-direction: column;
  }

  .layer-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
  }

  .layer-detail {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #6682B3;
    margin-top: 2px;
  }

  .flow-arrow {
    height: 24px;
    width: 2px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    margin: 4px 0;
  }

  .arrow-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #22c55e;
  }

  .animate-flow {
    animation: flowDown 1.8s infinite linear;
  }

  .delay-1 { animation-delay: 0.45s; }
  .delay-2 { animation-delay: 0.9s; }
  .delay-3 { animation-delay: 1.35s; }

  @keyframes flowDown {
    0% {
      top: 0;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* Split Bottom Side */
  .flow-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
    margin-top: 4px;
  }

  .flow-card.mini {
    padding: 12px 14px;
    gap: 12px;
  }

  .layer-name.small {
    font-size: 12px;
  }

  .layer-detail.small {
    font-size: 10px;
  }

  /* Entrance Animation CSS classes */
  .animate-fade-in {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Adjustments */
  :global(html[data-theme="light"]) .hero-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .hero-glow {
    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(34, 197, 94, 0.18) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 20% 75%,
        rgba(57, 132, 255, 0.12) 0%,
        transparent 40%
      );
  }

  :global(html[data-theme="light"]) .hero-glow-secondary {
    background: radial-gradient(circle, rgba(57, 213, 232, 0.12) 0%, transparent 70%);
  }

  :global(html[data-theme="light"]) .bg-circuit-svg {
    opacity: 0.85;
  }
  
  :global(html[data-theme="light"]) .hero-heading {
    text-shadow: none;
  }
  
  :global(html[data-theme="light"]) .hero-description {
    text-shadow: none;
  }

  :global(html[data-theme="light"]) .automation-flow {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }

  :global(html[data-theme="light"]) .flow-card {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .flow-card.highlight {
    background: rgba(34, 197, 94, 0.05);
    border-color: #22c55e;
  }

  :global(html[data-theme="light"]) .layer-name {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .layer-detail {
    color: #64748B;
  }

  /* Responsive Design styling */
  @media (max-width: 991px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 50px;
    }

    .hero-content {
      align-items: center;
    }

    .hero-heading {
      font-size: 40px;
      letter-spacing: -1px;
      margin-bottom: 20px;
    }

    .hero-description {
      margin: 0 auto 30px auto;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding: 80px 16px 40px 16px;
    }

    .hero-heading {
      font-size: 34px;
    }

    .hero-description {
      font-size: 15px;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-primary,
    .cta-secondary {
      width: 100%;
      box-sizing: border-box;
    }

    .bg-circuit-svg {
      opacity: 0.4;
    }

    .automation-flow {
      padding: 20px;
    }

    .flow-card {
      padding: 12px 16px;
      gap: 12px;
    }

    .flow-split {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
