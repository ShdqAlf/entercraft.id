---
// Solution.astro (Jasa WhatsApp Automation)

const steps = [
  "Komunikasi & Customer Service",
  "Lead Handling & Follow-up",
  "Order & Transaction",
  "Booking & Reminder",
  "Notification & Alert",
  "Internal Workflow"
];

const workflowNodes = [
  { label: "Customer Message", icon: "message-circle", color: "emerald" },
  { label: "Trigger Analysis", icon: "zap", color: "blue" },
  { label: "Workflow Logic", icon: "git-branch", color: "cyan" },
  { label: "System Update", icon: "database", color: "purple" },
  { label: "Automated Response", icon: "send", color: "emerald" }
];
---

<section class="solution-section" id="solusi">
  <div class="solution-container">
    <div class="content-wrapper">
      <div class="text-content animate-fade-scroll" style="animation-delay: 100ms;">
        <h2 class="section-title">Ubah WhatsApp Menjadi Bagian dari Workflow Bisnis Anda</h2>
        <p class="section-description">
          WhatsApp Automation bukan sekadar auto-reply. Kami merancang alur yang menghubungkan percakapan pelanggan langsung dengan proses internal bisnis Anda. Automation ini dapat diterapkan untuk berbagai kebutuhan:
        </p>
        
        <ul class="benefits-list">
          {steps.map((step, index) => (
            <li class="benefit-item" style={`animation-delay: ${150 + (index * 50)}ms;`}>
              <div class="check-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="visual-content animate-fade-scroll" style="animation-delay: 400ms;">
        <div class="workflow-visual">
          <div class="workflow-glow"></div>
          <h3 class="visual-title">Automation Flow</h3>
          
          <div class="pipeline">
            {workflowNodes.map((node, i) => (
              <>
                <div class={`pipeline-node node-${node.color}`}>
                  <div class="node-icon-wrapper">
                    {/* Simplified SVG icons based on name for the visual */}
                    {node.icon === 'message-circle' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>}
                    {node.icon === 'zap' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
                    {node.icon === 'git-branch' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>}
                    {node.icon === 'database' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
                    {node.icon === 'send' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>}
                  </div>
                  <span class="node-label">{node.label}</span>
                </div>
                {i < workflowNodes.length - 1 && (
                  <div class="pipeline-connector">
                    <div class="connector-line"></div>
                    <div class="connector-arrow"></div>
                  </div>
                )}
              </>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .solution-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
  }

  .solution-container {
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .section-description {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    margin: 0 0 32px 0;
  }

  .benefits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #D7E0F0;
    line-height: 1.5;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    flex-shrink: 0;
    margin-top: -2px;
  }

  /* Visual Pipeline styles */
  .workflow-visual {
    position: relative;
    background-color: rgba(7, 16, 32, 0.4);
    border: 1px solid #1B2A42;
    border-radius: 16px;
    padding: 40px;
    overflow: hidden;
  }

  .workflow-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, rgba(34, 197, 94, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .visual-title {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px 0;
  }

  .pipeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 2;
  }

  .pipeline-node {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(10, 22, 44, 0.8);
    border: 1px solid rgba(34, 197, 94, 0.2);
    padding: 12px 20px;
    border-radius: 12px;
    width: 240px;
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pipeline-node:hover {
    transform: translateX(5px);
  }

  .node-blue { border-color: rgba(57, 132, 255, 0.3); }
  .node-cyan { border-color: rgba(57, 213, 232, 0.3); }
  .node-purple { border-color: rgba(139, 92, 246, 0.3); }
  .node-emerald { border-color: rgba(34, 197, 94, 0.3); }

  .node-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }

  .node-blue .node-icon-wrapper { color: #3984ff; background: rgba(57, 132, 255, 0.15); }
  .node-cyan .node-icon-wrapper { color: #39d5e8; background: rgba(57, 213, 232, 0.15); }
  .node-purple .node-icon-wrapper { color: #a855f7; background: rgba(139, 92, 246, 0.15); }
  .node-emerald .node-icon-wrapper { color: #22c55e; background: rgba(34, 197, 94, 0.15); }

  .node-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #FFFFFF;
  }

  .pipeline-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 24px;
  }

  .connector-line {
    width: 2px;
    height: 18px;
    background: linear-gradient(to bottom, var(--accent-blue), rgba(57, 132, 255, 0.2));
  }

  .connector-arrow {
    width: 0; 
    height: 0; 
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid rgba(57, 132, 255, 0.5);
  }

  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme Adjustments */
  :global(html[data-theme="light"]) .solution-section {
    background-color: #FFFFFF;
  }
  
  :global(html[data-theme="light"]) .section-title {
    color: #0F172A;
  }
  
  :global(html[data-theme="light"]) .section-description {
    color: #475569;
  }
  
  :global(html[data-theme="light"]) .benefit-item {
    color: #1E293B;
  }
  
  :global(html[data-theme="light"]) .workflow-visual {
    background-color: #F8FAFC;
    border-color: #E2E8F0;
  }
  
  :global(html[data-theme="light"]) .pipeline-node {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  
  :global(html[data-theme="light"]) .node-label {
    color: #0F172A;
  }

  @media (max-width: 991px) {
    .content-wrapper {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .workflow-visual {
      padding: 32px 20px;
    }
    
    .pipeline {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }
    
    .pipeline-connector {
      display: none;
    }
  }

  @media (max-width: 575px) {
    .solution-section {
      padding: 60px 16px;
    }

    .section-title {
      font-size: 32px;
    }
  }
</style>
