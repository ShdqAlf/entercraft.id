---
// BusinessBenefits.astro

const benefits = [
  {
    title: "Skalabilitas Komunikasi",
    description: "Tangani lebih banyak pesan tanpa harus menambah ukuran tim operasional secara linear.",
    icon: "trending-up"
  },
  {
    title: "Peningkatan Kecepatan",
    description: "Response time instan, meningkatkan kepuasan dan mencegah pelanggan berpindah ke kompetitor.",
    icon: "zap"
  },
  {
    title: "Konsistensi Data",
    description: "Tidak ada lagi lead yang hilang karena semua data percakapan otomatis tersimpan di CRM atau sistem.",
    icon: "database"
  },
  {
    title: "Penghematan Waktu",
    description: "Tim dapat fokus pada pekerjaan strategis dan penutupan sales daripada aktivitas copy-paste administratif.",
    icon: "clock"
  }
];
---

<section class="benefits-section">
  <div class="benefits-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <h2 class="header-title">Dampak WhatsApp Automation pada Bisnis</h2>
      <p class="header-intro">
        Otomatisasi bukan sekadar tentang teknologi, tetapi tentang bagaimana teknologi dapat secara langsung memengaruhi efisiensi dan pertumbuhan bisnis Anda.
      </p>
    </div>

    <div class="benefits-grid">
      {benefits.map((benefit, index) => (
        <div class="benefit-card animate-fade-scroll" style={`animation-delay: ${200 + (index * 100)}ms;`}>
          <div class="card-icon">
            {benefit.icon === 'trending-up' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>}
            {benefit.icon === 'zap' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
            {benefit.icon === 'database' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>}
            {benefit.icon === 'clock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>}
          </div>
          <h3 class="card-title">{benefit.title}</h3>
          <p class="card-description">{benefit.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .benefits-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
    border-top: 1px solid var(--border-color);
  }

  .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Grid Setup */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    width: 100%;
  }

  /* Cards */
  .benefit-card {
    background-color: rgba(7, 16, 32, 0.4);
    border: 1px solid #1B2A42;
    border-radius: 12px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
  }

  .benefit-card:hover {
    background-color: rgba(10, 22, 44, 0.8);
    border-color: rgba(57, 132, 255, 0.4);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .card-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .card-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 19px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: #7D96C5;
    margin: 0;
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .benefits-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .card-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .card-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .benefit-card {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .benefit-card:hover {
    border-color: #22c55e;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .benefits-section {
      padding: 70px 16px;
    }

    .header-title {
      font-size: 30px;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
