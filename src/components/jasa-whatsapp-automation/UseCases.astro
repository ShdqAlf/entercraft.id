---
// UseCases.astro

const useCases = [
  {
    id: "sales",
    title: "Sales & Lead Qualification",
    description: "Kurangi proses administrasi dan bantu tim sales menerima informasi lead yang lebih terstruktur.",
    workflow: ["Lead masuk", "WhatsApp qualification", "Informasi lead dikumpulkan", "Data masuk CRM", "Sales menerima lead"],
    align: "left"
  },
  {
    id: "cs",
    title: "Customer Service",
    description: "Bantu tim customer service menangani pertanyaan berulang tanpa menghilangkan peran tim pada kasus yang membutuhkan perhatian langsung.",
    workflow: ["Customer bertanya", "Automation mengenali intent", "FAQ / information response", "Jika perlu → human agent"],
    align: "right"
  },
  {
    id: "order",
    title: "Order Management",
    description: "Hubungkan proses komunikasi dengan workflow order agar customer memperoleh informasi yang lebih cepat dan konsisten.",
    workflow: ["Customer melakukan request", "Data diproses", "Order dikonfirmasi", "Status dikirim via WhatsApp"],
    align: "left"
  },
  {
    id: "booking",
    title: "Booking & Reservation",
    description: "Kurangi pekerjaan administratif pada proses booking dan reminder.",
    workflow: ["Customer request booking", "Schedule check", "Confirmation", "Reminder otomatis"],
    align: "right"
  },
  {
    id: "internal",
    title: "Internal Workflow",
    description: "Gunakan WhatsApp sebagai bagian dari workflow internal ketika notifikasi dan action perlu berjalan lebih cepat.",
    workflow: ["Trigger sistem", "WhatsApp notification", "Approval / action via chat", "Status update di sistem"],
    align: "left"
  }
];
---

<section class="use-cases-section" id="use-cases">
  <div class="uc-container">
    
    <div class="section-header animate-fade-scroll" style="animation-delay: 100ms;">
      <div class="header-eyebrow">
        <span class="eyebrow-dot">●</span> PRAKTIK TERBAIK
      </div>
      <h2 class="header-title">Contoh Penerapan WhatsApp Automation dalam Bisnis</h2>
      <p class="header-intro">
        Bagaimana berbagai divisi dalam perusahaan dapat memanfaatkan WhatsApp Automation untuk bekerja lebih cerdas dan cepat.
      </p>
    </div>

    <div class="uc-timeline">
      {useCases.map((uc, index) => (
        <div class={`uc-row align-${uc.align} animate-fade-scroll`} style={`animation-delay: ${200 + (index * 150)}ms;`}>
          
          <div class="uc-content">
            <h3 class="uc-title">{uc.title}</h3>
            <p class="uc-description">{uc.description}</p>
          </div>

          <div class="uc-visual">
            <div class="workflow-box">
              <div class="workflow-header">Alur Proses</div>
              <div class="workflow-steps">
                {uc.workflow.map((step, stepIndex) => (
                  <div class="w-step">
                    <span class="w-num">{stepIndex + 1}</span>
                    <span class="w-text">{step}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

        </div>
      ))}
      <div class="timeline-line"></div>
    </div>

  </div>
</section>

<style>
  .use-cases-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: 100px 24px;
    box-sizing: border-box;
    border-top: 1px solid var(--border-color);
  }

  .uc-container {
    max-width: 1000px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-bottom: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-blue);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .eyebrow-dot {
    color: var(--accent-blue);
    font-size: 8px;
  }

  .header-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -1px;
    color: #FFFFFF;
    margin: 0 0 16px 0;
    max-width: 800px;
  }

  .header-intro {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #7D96C5;
    max-width: 650px;
    margin: 0;
  }

  /* Zig-zag Timeline */
  .uc-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: linear-gradient(to bottom, rgba(57, 132, 255, 0.1) 0%, rgba(57, 132, 255, 0.3) 50%, rgba(57, 132, 255, 0.1) 100%);
    transform: translateX(-50%);
    z-index: 1;
  }

  .uc-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    position: relative;
    z-index: 2;
    align-items: center;
  }

  .uc-row::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--bg-primary);
    border: 3px solid var(--accent-blue);
    z-index: 3;
    box-shadow: 0 0 10px rgba(57, 132, 255, 0.5);
  }

  /* Alignment Handling */
  .align-left .uc-content { grid-column: 1; text-align: right; }
  .align-left .uc-visual { grid-column: 2; }
  
  .align-right .uc-content { grid-column: 2; text-align: left; }
  .align-right .uc-visual { grid-column: 1; grid-row: 1; }

  /* Content */
  .uc-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }

  .uc-description {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #A0B2D2;
    margin: 0;
  }

  /* Visual / Workflow Box */
  .workflow-box {
    background-color: rgba(7, 16, 32, 0.5);
    border: 1px solid #1B2A42;
    border-radius: 12px;
    padding: 24px;
    transition: all 0.3s ease;
  }
  
  .uc-row:hover .workflow-box {
    border-color: rgba(34, 197, 94, 0.4);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transform: translateY(-4px);
  }

  .workflow-header {
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-blue);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
    border-bottom: 1px solid #1B2A42;
    padding-bottom: 12px;
  }

  .workflow-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .w-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .w-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    font-family: 'Inter', monospace;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .w-text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #D7E0F0;
    line-height: 1.5;
  }

  /* Animations */
  .animate-fade-scroll {
    opacity: 0;
    transform: translateY(15px);
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Light Theme */
  :global(html[data-theme="light"]) .use-cases-section {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
  }

  :global(html[data-theme="light"]) .header-title,
  :global(html[data-theme="light"]) .uc-title {
    color: #0F172A;
  }

  :global(html[data-theme="light"]) .header-intro,
  :global(html[data-theme="light"]) .uc-description {
    color: #475569;
  }

  :global(html[data-theme="light"]) .timeline-line {
    background: linear-gradient(to bottom, rgba(57, 132, 255, 0.1) 0%, rgba(57, 132, 255, 0.5) 50%, rgba(57, 132, 255, 0.1) 100%);
  }
  
  :global(html[data-theme="light"]) .uc-row::after {
    background-color: #FFFFFF;
  }

  :global(html[data-theme="light"]) .workflow-box {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="light"]) .workflow-header {
    border-color: #E2E8F0;
  }

  :global(html[data-theme="light"]) .w-text {
    color: #334155;
  }

  /* Responsive Design */
  @media (max-width: 767px) {
    .use-cases-section {
      padding: 70px 16px;
    }

    .header-title {
      font-size: 30px;
    }

    .timeline-line, .uc-row::after {
      display: none;
    }

    .uc-timeline {
      gap: 40px;
    }

    .uc-row {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .align-left .uc-content, .align-right .uc-content {
      grid-column: 1;
      text-align: left;
    }

    .align-left .uc-visual, .align-right .uc-visual {
      grid-column: 1;
      grid-row: 2; /* Visual always below content on mobile */
    }
  }
</style>
