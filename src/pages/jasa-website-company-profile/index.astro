---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`Jasa Pembuatan Website Company Profile B2B Profesional - ${SITE_TITLE}`} 
      description="Jasa pembuatan website company profile profesional, responsif, dan SEO ready untuk meningkatkan kredibilitas dan konversi bisnis B2B Anda." 
    />
  </head>
  <body>
    <Navbar />
    
    <main>
      <Hero />
      <Problem />
      <BeforeAfter />
      <WhatWeBuild />
      <B2bValue />
      <WebsiteStructure />
      <DesignDevelopment />
      <TechCapability />
      <SeoFoundation />
      <Portfolio />
      <QualityChecklist />
      <Integration />
      <BusinessBenefits />
      
      <!-- Industries section with custom data -->
      <Industries 
        industriesData={industriesData}
      />
      
      <WhyChoose 
        eyebrow="MENGAPA ENTERCRAFT"
        titleHtml="Bukan Sekadar Jasa Pembuat Web.<br/>Kami Partner Pertumbuhan Bisnis Anda."
        intro="Kami menggabungkan business understanding, desain premium, dan teknologi modern untuk menghasilkan website yang relevan dengan skala bisnis Anda."
        valueProps={whyChooseData}
      />
      
      <HowWeWork 
        eyebrow="PROSES KAMI"
        titleHtml="Tahapan Pembuatan<br/>Website yang Terstruktur"
        intro="Setiap project kami kerjakan melalui metodologi sistematis untuk memastikan hasil akhir sesuai dengan visi perusahaan Anda."
        stepsData={processData}
      />
      
      <Faq 
        eyebrow="FAQ PEMBUATAN WEBSITE"
        titleHtml="Pertanyaan Umum Seputar<br/>Jasa Website Company Profile"
        intro="Hal-hal yang sering ditanyakan oleh klien sebelum memulai project website mereka."
        faqData={faqData}
      />
      
      <FinalCta 
        eyebrow="MULAI SEKARANG"
        titleHtml="Siap Membangun Kredibilitas<br/>Digital Bisnis Anda?"
        intro="Konsultasikan kebutuhan website company profile Anda bersama tim kami. Kami siap membantu Anda merancang representasi digital terbaik."
      />
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
    overflow-x: hidden;
  }
</style>
