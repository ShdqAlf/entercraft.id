const faqData = [
  {
    id: "01",
    question: "Berapa lama proses pembuatan website company profile?",
    answer: "Umumnya memakan waktu 3-6 minggu tergantung dari kompleksitas struktur halaman, ketersediaan materi konten (teks/foto), dan revisi desain."
  },
  {
    id: "02",
    question: "Apakah saya harus menyiapkan materi konten sendiri?",
    answer: "Kami sangat menyarankan materi dasar (company profile, foto) dari pihak Anda agar otentik. Namun jika Anda tidak memilikinya, kami bisa membantu layanan copywriting profesional."
  },
  {
    id: "03",
    question: "Apakah website ini bisa saya update sendiri nantinya?",
    answer: "Tentu. Kami akan menyediakan sistem Content Management System (CMS) yang mudah digunakan sehingga tim internal Anda dapat mengupdate portofolio atau artikel secara mandiri."
  },
  {
    id: "04",
    question: "Apakah harganya termasuk domain dan hosting?",
    answer: "Ya, kami menawarkan paket all-in yang sudah mencakup domain korporat (seperti .com, .co.id, atau .id) dan server hosting berkecepatan tinggi untuk tahun pertama."
