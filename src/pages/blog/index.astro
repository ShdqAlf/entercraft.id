---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import FeaturedArticle from '../../components/blog/FeaturedArticle.astro';
import BlogCard from '../../components/blog/BlogCard.astro';

// Fetch all posts, filter out drafts in production, sort by date desc
const allPosts = (await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Find the featured post
const featuredPost = allPosts.find(post => post.data.featured);

// Find all other posts (non-featured)
const latestPosts = featuredPost 
  ? allPosts.filter(post => post.id !== featuredPost.id)
  : allPosts;
---

  <BlogLayout title="Insights | Entercraft.id" description="Insight tentang AI, automation, business technology, dan digital transformation dari Entercraft.id.">
  <div class="blog-main-container">
    <!-- Hero Section -->
    <div class="blog-hero">
      <span class="blog-eyebrow">INSIGHTS</span>
      <h1 class="blog-headline">Wawasan Teknologi<br />untuk Bisnis yang Terus Bergerak.</h1>
      <p class="blog-subheadline">
        Insight, strategi, dan perspektif praktis tentang teknologi, automation, AI, dan transformasi digital untuk membantu bisnis mengambil keputusan yang lebih tepat.
      </p>
    </div>

    <!-- Search Controls -->
    <div class="blog-search-container">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="blog-search" placeholder="Cari insight..." aria-label="Cari insight" />
      </div>
    </div>

    <!-- Featured Post -->
    {featuredPost && (
      <div class="featured-wrapper" data-featured-card data-category={featuredPost.data.category.toLowerCase()} data-title={featuredPost.data.title.toLowerCase()} data-description={featuredPost.data.description.toLowerCase()} data-tags={featuredPost.data.tags?.join(' ').toLowerCase()}>
        <div class="section-divider-label">FEATURED INSIGHT</div>
        <FeaturedArticle post={featuredPost} />
      </div>
    )}

    <!-- Category Filters -->
    <div class="blog-filters-section">
      <h3 class="filters-heading">Explore by Topic</h3>
      <div class="filters-container">
        <button class="filter-btn active" data-category="all">All</button>
        <button class="filter-btn" data-category="ai & automation">AI & Automation</button>
        <button class="filter-btn" data-category="business technology">Business Technology</button>
        <button class="filter-btn" data-category="digital transformation">Digital Transformation</button>
        <button class="filter-btn" data-category="industry insights">Industry Insights</button>
      </div>
    </div>

    <!-- Latest Insights Section -->
    <div class="latest-insights-section">
      <div class="latest-header-wrapper">
        <h2 class="latest-heading">Latest Insights</h2>
        <p class="latest-subheadline">
          Perspektif terbaru seputar teknologi dan bagaimana penerapannya dapat menciptakan dampak nyata bagi bisnis.
        </p>
      </div>

      <div class="articles-grid" id="articles-grid">
        {latestPosts.map(post => (
          <BlogCard post={post} />
        ))}
      </div>

      <!-- Empty State -->
      <div class="empty-state" id="empty-state" style="display: none;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
        <p class="empty-state-text">No insights found matching your criteria.</p>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  /* Blog Hero Styles */
  .blog-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 48px;
  }

  .blog-eyebrow {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent-blue);
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  .blog-headline {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 48px; /* desktop: 48px – 56px */
    font-weight: 800;
    line-height: 1.05;
    color: #FFFFFF;
    margin: 0 0 20px 0;
    letter-spacing: -1.5px;
  }

  .blog-subheadline {
    font-family: 'Inter', sans-serif;
    font-size: 15px; /* 14px – 16px */
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0;
  }

  /* Search Styles */
  .blog-search-container {
    display: flex;
    justify-content: center;
    margin-bottom: 60px;
    width: 100%;
    box-sizing: border-box;
  }

  .search-input-wrapper {
    position: relative;
    width: 420px; /* desktop width around 420px */
    box-sizing: border-box;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input-wrapper input {
    width: 100%;
    background-color: #080E19; /* dark background */
    border: 1px solid #263653; /* subtle border */
    border-radius: 8px; /* 8px radius */
    padding: 12px 16px 12px 42px;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .search-input-wrapper input:focus {
    outline: none;
    border-color: var(--accent-blue); /* accent blue saat focus */
    box-shadow: 0 0 0 3px rgba(57, 132, 255, 0.15);
  }

  /* Section Divider Label */
  .section-divider-label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(38, 54, 83, 0.4);
  }

  /* Category Filters Styles */
  .blog-filters-section {
    margin-bottom: 60px;
    width: 100%;
    box-sizing: border-box;
  }

  .filters-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 20px 0;
  }

  .filters-container {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .filter-btn {
    background: transparent; /* inactive: transparent */
    border: 1px solid #263653; /* inactive: border #263653 */
    border-radius: 6px; /* 6px – 8px radius */
    padding: 10px 18px;
    color: var(--text-secondary);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .filter-btn:hover {
    color: #FFFFFF;
    border-color: var(--accent-blue);
  }

  .filter-btn.active {
    background-color: var(--accent-blue); /* active: background #3984FF */
    border-color: var(--accent-blue);
    color: #FFFFFF; /* active: text #FFFFFF */
  }

  /* Latest Insights Section */
  .latest-insights-section {
    width: 100%;
    box-sizing: border-box;
  }

  .latest-header-wrapper {
    margin-bottom: 40px;
  }

  .latest-heading {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .latest-subheadline {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
    line-height: 1.6;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* desktop: 3-column grid */
    gap: 28px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Empty State Styles */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    border: 1px dashed #263653;
    border-radius: 12px;
    color: var(--text-secondary);
    text-align: center;
    width: 100%;
    box-sizing: border-box;
  }

  .empty-state svg {
    margin-bottom: 16px;
    color: var(--text-muted);
  }

  .empty-state-text {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    margin: 0;
  }

  /* Responsive Grid Breakpoints */
  @media (max-width: 992px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr); /* tablet: 2-column */
    }
    .blog-headline {
      font-size: 38px;
    }
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr; /* mobile: 1-column */
    }
    .search-input-wrapper {
      width: 100%; /* mobile: 100% search */
    }
    .blog-headline {
      font-size: 32px;
    }
    .blog-subheadline {
      font-size: 14px;
    }
  }

  /* Light Theme Specific Component Overrides */
  :global(html[data-theme="light"]) .blog-headline {
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .blog-subheadline {
    color: #475569;
  }
  :global(html[data-theme="light"]) .search-input-wrapper input {
    background-color: #FFFFFF;
    border-color: #CBD5E1;
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .search-input-wrapper input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(0, 85, 255, 0.1);
  }
  :global(html[data-theme="light"]) .filters-heading {
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .filter-btn {
    border-color: #CBD5E1;
    color: #475569;
  }
  :global(html[data-theme="light"]) .filter-btn:hover {
    color: #000000;
    border-color: var(--accent-blue);
  }
  :global(html[data-theme="light"]) .filter-btn.active {
    background-color: var(--accent-blue);
    border-color: var(--accent-blue);
    color: #FFFFFF;
  }
  :global(html[data-theme="light"]) .latest-heading {
    color: #0F172A;
  }
  :global(html[data-theme="light"]) .latest-subheadline {
    color: #475569;
  }
  :global(html[data-theme="light"]) .section-divider-label {
    border-bottom-color: #E2E8F0;
  }
  :global(html[data-theme="light"]) .empty-state {
    border-color: #E2E8F0;
    color: #64748B;
  }
</style>

<script>
  // High-performance client-side category and search filtration
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.blog-card');
    const featuredWrapper = document.querySelector('.featured-wrapper') as HTMLElement | null;
    const emptyState = document.getElementById('empty-state');
    const articlesGrid = document.getElementById('articles-grid');
    const latestHeadingWrapper = document.querySelector('.latest-header-wrapper') as HTMLElement | null;

    let currentSearch = '';
    let currentCategory = 'all';

    function applyFilter() {
      let visibleCount = 0;
      let gridVisibleCount = 0;

      // Filter Featured Post (if matching search and category)
      if (featuredWrapper) {
        const category = featuredWrapper.getAttribute('data-category') || '';
        const title = featuredWrapper.getAttribute('data-title') || '';
        const description = featuredWrapper.getAttribute('data-description') || '';
        const tags = featuredWrapper.getAttribute('data-tags') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesSearch = !currentSearch || 
          title.includes(currentSearch) || 
          description.includes(currentSearch) || 
          tags.includes(currentSearch);

        if (matchesCategory && matchesSearch) {
          featuredWrapper.style.display = 'block';
          visibleCount++;
        } else {
          featuredWrapper.style.display = 'none';
        }
      }

      // Filter Regular Posts in Grid
      cards.forEach((cardNode) => {
        const card = cardNode as HTMLElement;
        const category = card.getAttribute('data-category') || '';
        const title = card.getAttribute('data-title') || '';
        const description = card.getAttribute('data-description') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesSearch = !currentSearch || 
          title.includes(currentSearch) || 
          description.includes(currentSearch) || 
          tags.includes(currentSearch);

        if (matchesCategory && matchesSearch) {
          card.style.display = 'flex';
          visibleCount++;
          gridVisibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Handle empty states and heading visibility
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.style.display = 'flex';
          if (articlesGrid) articlesGrid.style.display = 'none';
          if (latestHeadingWrapper) latestHeadingWrapper.style.display = 'none';
        } else {
          emptyState.style.display = 'none';
          if (latestHeadingWrapper) latestHeadingWrapper.style.display = 'block';
          
          if (gridVisibleCount === 0) {
            if (articlesGrid) articlesGrid.style.display = 'none';
          } else {
            if (articlesGrid) articlesGrid.style.display = 'grid';
          }
        }
      }
    }

    // Input search binding
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        currentSearch = target.value.trim().toLowerCase();
        applyFilter();
      });
    }

    // Category filter button click binds
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active button style classes
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        currentCategory = btn.getAttribute('data-category') || 'all';
        applyFilter();
      });
    });
  });
</script>
