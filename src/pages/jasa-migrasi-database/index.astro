---
import BaseHead from '../../components/BaseHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhyChoose from '../../components/WhyChoose.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE_TITLE } from '../../consts';

const migrationTypes = [
  { title: 'Database Engine Migration', detail: 'Penyesuaian struktur dan data antar engine seperti MySQL, PostgreSQL, MariaDB, SQL Server, atau SQLite sesuai hasil assessment.', tags: ['MySQL → PostgreSQL', 'MariaDB → MySQL'] },
  { title: 'Server & Cloud Migration', detail: 'Memindahkan database dari server lama ke server baru, on-premise ke cloud, atau antar environment cloud dengan rencana cutover yang jelas.', tags: ['On-Premise → Cloud', 'Server A → Server B'] },
  { title: 'Version Upgrade', detail: 'Meng-upgrade versi database sambil memeriksa compatibility, deprecated feature, extension, dan kebutuhan aplikasi.', tags: ['Old Version → New Version'] },
  { title: 'Schema Migration', detail: 'Memindahkan atau merestrukturisasi tabel, relationship, index, constraint, dan aturan data agar sesuai dengan schema tujuan.', tags: ['Schema Mapping', 'Relationship'] },
  { title: 'Data Consolidation', detail: 'Menggabungkan beberapa sumber data menjadi environment yang lebih terpusat dengan aturan cleansing dan deduplikasi.', tags: ['Multi-Source', 'Centralized Data'] },
  { title: 'Application-Database Migration', detail: 'Memindahkan database sekaligus menyesuaikan connection, query, ORM mapping, dan dependency aplikasi yang menggunakannya.', tags: ['Compatibility', 'Replatforming'] }
];

const problems = [
  { title: 'Risiko Data Tidak Sesuai', description: 'Column, datatype, relation, encoding, atau format dapat berbeda antara source dan destination.', icon: 'data' },
  { title: 'Aplikasi Tidak Kompatibel', description: 'Connection, query, ORM mapping, atau dependency aplikasi dapat terpengaruh setelah database berubah.', icon: 'app' },
  { title: 'Data Tidak Konsisten', description: 'Jumlah maupun isi data source dan destination perlu dibandingkan setelah proses migration.', icon: 'check' },
  { title: 'Downtime Mengganggu Operasional', description: 'Migration yang tidak direncanakan dapat menghentikan layanan dan menghambat proses bisnis.', icon: 'clock' },
  { title: 'Database Legacy', description: 'Struktur lama mungkin tidak lagi sesuai dengan kebutuhan aplikasi atau environment baru.', icon: 'legacy' }
];

const validationItems = [
  { title: 'Row Count', description: 'Membandingkan jumlah record pada source dan destination.' },
  { title: 'Data Integrity', description: 'Memeriksa relationship antar tabel dan referential integrity.' },
  { title: 'Data Type', description: 'Memastikan datatype sesuai dengan schema tujuan.' },
  { title: 'Missing Data', description: 'Mencari data yang hilang, terpotong, atau gagal di-import.' },
  { title: 'Constraints', description: 'Memvalidasi primary key, foreign key, unique constraint, dan aturan relevan.' },
  { title: 'Application Test', description: 'Memastikan aplikasi dapat membaca dan menulis data sesuai kebutuhan.' },
  { title: 'Business Validation', description: 'Memastikan data penting tetap dapat digunakan oleh tim operasional.' }
];

const securityItems = [
  { title: 'Access Control', description: 'Membatasi siapa yang dapat mengakses source, destination, dan proses migration.' },
  { title: 'Secure Connection', description: 'Menggunakan koneksi aman sesuai kemampuan dan kebijakan environment.' },
  { title: 'Credential Handling', description: 'Mengelola credential secara aman tanpa mengekspos secret di source code atau log.' },
  { title: 'Backup Protection', description: 'Melindungi backup berdasarkan sensitivitas data dan kebutuhan retention.' },
  { title: 'Validation & Logging', description: 'Mencatat proses, hasil validasi, dan issue sesuai kebutuhan project.' }
];

const processData = [
  { num: '01', label: 'ASSESS', title: 'Assess', description: 'Memahami source, destination, ukuran data, schema, dependency aplikasi, kebutuhan downtime, dan constraints operasional.', focus: 'DISCOVERY' },
  { num: '02', label: 'PLAN', title: 'Plan', description: 'Menentukan migration strategy, backup strategy, migration window, rollback plan, dan validation approach.', focus: 'STRATEGY' },
  { num: '03', label: 'BACKUP', title: 'Backup', description: 'Menyiapkan salinan data dan memastikan backup dapat digunakan sesuai skenario recovery yang disepakati.', focus: 'RECOVERY READINESS' },
  { num: '04', label: 'MAP', title: 'Map', description: 'Memetakan table, column, datatype, relationship, index, constraint, dan kebutuhan transformation.', focus: 'SCHEMA MAPPING' },
  { num: '05', label: 'MIGRATE', title: 'Migrate', description: 'Memindahkan struktur dan data ke environment tujuan menggunakan metode yang sesuai kondisi database.', focus: 'DATA TRANSFER' },
  { num: '06', label: 'VALIDATE', title: 'Validate', description: 'Memeriksa completeness, consistency, integrity, schema compatibility, dan application compatibility.', focus: 'QUALITY CONTROL' },
  { num: '07', label: 'CUTOVER', title: 'Cutover', description: 'Mengalihkan aplikasi ke database baru sesuai migration plan dan checklist operasional.', focus: 'GO-LIVE' },
  { num: '08', label: 'MONITOR', title: 'Monitor', description: 'Memantau environment setelah migration dan menangani issue yang muncul pada fase awal.', focus: 'STABILIZATION' }
];

const whyChooseData = [
  { id: '01', title: 'Structured Migration', description: 'Setiap migration dimulai dari assessment dan planning, bukan langsung memindahkan data.', label: 'STRUCTURED' },
  { id: '02', title: 'Data-Aware', description: 'Schema, relationship, datatype, transformation, dan integrity menjadi bagian dari perencanaan.', label: 'DATA-AWARE' },
  { id: '03', title: 'Application-Aware', description: 'Database dipahami bersama aplikasi, query, connection, dan dependency yang menggunakannya.', label: 'COMPATIBILITY' },
  { id: '04', title: 'Validation Focused', description: 'Data divalidasi berdasarkan migration scope dan criteria yang disepakati.', label: 'VALIDATION' },
  { id: '05', title: 'Risk Conscious', description: 'Backup, rollback, downtime, dan failure scenario dipertimbangkan sejak awal.', label: 'RISK-AWARE' },
  { id: '06', title: 'End-to-End', description: 'Assessment, planning, migration, testing, cutover, dan support berada dalam satu alur kerja.', label: 'END-TO-END' }
];

const faqData = [
  { id: '01', question: 'Apa itu migrasi database?', answer: 'Migrasi database adalah proses memindahkan data dan struktur database dari environment lama ke environment baru dengan assessment, mapping, migration, validation, dan cutover yang terencana.' },
  { id: '02', question: 'Apa bedanya migrasi database dengan backup?', answer: 'Backup menyalin data untuk kebutuhan recovery. Migration memindahkan atau menyesuaikan data ke environment tujuan agar dapat digunakan di sana.' },
  { id: '03', question: 'Apa bedanya migrasi database dengan integrasi sistem?', answer: 'Migrasi memindahkan data dari satu environment ke environment lain. Integrasi sistem membuat dua sistem tetap terhubung dan bertukar data. Lihat juga layanan Jasa Integrasi Sistem Entercraft.' , hasLink: true, linkText: 'Lihat Jasa Integrasi Sistem →', linkUrl: '/jasa-integrasi-sistem/' },
  { id: '04', question: 'Database apa saja yang dapat dimigrasikan?', answer: 'Engine dan pendekatan ditentukan setelah melihat source, destination, ukuran data, schema, akses, dan kebutuhan aplikasi. Assessment diperlukan sebelum menentukan scope.' },
  { id: '05', question: 'Apakah bisa migrasi MySQL ke PostgreSQL?', answer: 'Bisa menjadi salah satu skenario yang kami bantu. Karena perbedaan datatype, query, function, dan constraint, pendekatan final ditentukan setelah assessment compatibility.' },
  { id: '06', question: 'Apakah bisa migrasi database ke cloud?', answer: 'Bisa untuk skenario yang sesuai, misalnya on-premise ke cloud atau cloud ke cloud. Provider, konfigurasi, keamanan, dan network perlu dievaluasi lebih dulu.' },
  { id: '07', question: 'Apakah aplikasi perlu diubah ketika database dipindahkan?', answer: 'Tergantung perubahan engine, schema, connection, query, ORM, dan dependency. Application compatibility selalu menjadi bagian dari validation dan testing.' },
  { id: '08', question: 'Apakah migrasi database membutuhkan downtime?', answer: 'Tidak selalu sama. Pilihannya dapat berupa offline migration, staged migration, atau pendekatan low-downtime jika architecture memungkinkan dan sesuai kebutuhan operasional.' },
  { id: '09', question: 'Bagaimana cara mengurangi risiko kehilangan data?', answer: 'Risiko diminimalkan melalui assessment, backup yang sesuai, mapping, migration rehearsal bila relevan, validation criteria, monitoring, dan rollback approach.' },
  { id: '10', question: 'Bagaimana proses backup sebelum migration?', answer: 'Backup strategy disusun berdasarkan engine, ukuran data, environment, retention, akses, dan recovery requirement. Backup kemudian diperiksa agar dapat digunakan sesuai rencana.' },
  { id: '11', question: 'Bagaimana memastikan data hasil migration tetap valid?', answer: 'Validasi dapat mencakup row count, integrity, datatype, missing data, constraint, application test, dan business validation sesuai scope yang disepakati.' },
  { id: '12', question: 'Bagaimana jika terjadi error saat migration?', answer: 'Issue ditangani berdasarkan failure scenario yang sudah direncanakan. Tim dapat melakukan troubleshooting, recovery, retry, atau rollback sesuai kondisi dan keputusan cutover.' },
  { id: '13', question: 'Apakah ada rollback plan?', answer: 'Rollback plan dapat disiapkan sebelum cutover. Bentuknya bergantung pada architecture, metode migration, backup, application dependency, dan toleransi downtime.' },
  { id: '14', question: 'Apakah bisa menggabungkan beberapa database?', answer: 'Database consolidation dapat dilakukan bila struktur, ownership data, mapping, deduplikasi, dan aturan sumber data telah dipahami melalui assessment.' },
  { id: '15', question: 'Berapa lama proses migrasi database?', answer: 'Timeline bergantung pada ukuran data, kompleksitas schema, jumlah dependency, metode migration, kebutuhan testing, dan migration window. Estimasi diberikan setelah scope dipahami.' },
  { id: '16', question: 'Berapa biaya jasa migrasi database?', answer: 'Biaya ditentukan oleh engine, volume data, kompleksitas transformation, kebutuhan downtime, testing, security, dan support. Konsultasi diperlukan untuk menyusun estimasi yang realistis.' }
];

const icon = (name: string) => {
  const paths: Record<string, string> = {
    data: 'M12 2v20M2 12h20M5 5l14 14M19 5L5 19',
    app: 'M5 2h14a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V4a2 2 0 012-2zM8 6h8M8 18h8',
    check: 'M4 12l5 5L20 6',
    clock: 'M12 8v4l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    legacy: 'M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4'
  };
  return paths[name] ?? paths.data;
};
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title="Jasa Migrasi Database Profesional untuk Bisnis | Entercraft" description="Jasa Migrasi Database untuk memindahkan data ke server, platform, atau database baru dengan mapping, validation, backup, dan cutover terstruktur." />
  </head>
  <body>
    <Navbar />
    <main>
      <section class="migration-hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-wrap">
          <div class="hero-copy reveal">
            <span class="eyebrow"><span class="eyebrow-dot"></span> JASA MIGRASI DATABASE</span>
            <h1>Jasa Migrasi Database untuk Memindahkan Data dengan <span>Proses yang Terstruktur</span></h1>
            <p>Bantu bisnis memindahkan database ke server, platform, atau struktur baru dengan proses mapping, migration, validation, dan cutover yang direncanakan untuk meminimalkan risiko kehilangan data dan gangguan operasional.</p>
            <div class="hero-actions">
              <a href="/contact/" class="btn-primary">Konsultasikan Migrasi Database</a>
              <a href="#proses-migrasi" class="btn-secondary">Lihat Proses Migrasi</a>
            </div>
          </div>

          <div class="migration-visual reveal" aria-label="Alur migrasi dari database lama ke database baru">
            <div class="db-node source-node"><span class="node-kicker">SOURCE</span><strong>OLD DATABASE</strong><small>Legacy environment</small></div>
            <div class="flow-arrow"><span class="flow-line"></span><b>DATA</b></div>
            <div class="migration-core"><span class="node-kicker">CONTROLLED FLOW</span><strong>DATABASE<br />MIGRATION</strong><div class="core-tags"><span>Schema</span><span>Mapping</span><span>Validation</span><span>Cutover</span></div></div>
            <div class="flow-arrow"><span class="flow-line"></span><b>VALIDATED</b></div>
            <div class="db-node target-node"><span class="node-kicker">TARGET</span><strong>NEW DATABASE</strong><small>Updated environment</small></div>
          </div>
        </div>
      </section>

      <section class="section problem-section" id="risiko-migrasi">
        <div class="container">
          <header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> RISK AWARENESS</span><h2>Migrasi Database Bukan Sekadar Memindahkan Data</h2><p>Perubahan database dapat memengaruhi struktur data, aplikasi, integrasi, dan operasional. Karena itu migration perlu direncanakan dari awal.</p></header>
          <div class="problem-grid">
            {problems.map((problem, index) => <article class="risk-card reveal" style={`animation-delay: ${index * 70}ms`}><div class="risk-icon"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icon(problem.icon)} /></svg></div><span class="card-index">0{index + 1}</span><h3>{problem.title}</h3><p>{problem.description}</p></article>)}
          </div>
        </div>
      </section>

      <section class="section stages-section">
        <div class="container">
          <header class="section-heading left-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION STORY</span><h2>Dari Database Lama ke Environment Baru dengan Proses yang Terstruktur</h2><p>Setiap fase memiliki tujuan dan checkpoint agar keputusan migration dapat dipahami oleh business owner maupun technical evaluator.</p></header>
          <div class="stages-grid">
            <article class="stage-card before"><span class="stage-label">BEFORE</span><h3>Legacy Environment</h3><div class="stage-stack"><strong>Legacy Database</strong><span>↓</span><strong>Old Server</strong><span>↓</span><strong>Old Application</strong></div><ul><li>Existing schema</li><li>Existing dependencies</li></ul></article>
            <article class="stage-card during"><span class="stage-label">MIGRATION</span><h3>Controlled Process</h3><div class="mini-process">{['Assessment', 'Backup', 'Schema Mapping', 'Transformation', 'Migration', 'Validation', 'Testing', 'Cutover'].map((step, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{step}</span>)}</div></article>
            <article class="stage-card after"><span class="stage-label">AFTER</span><h3>Updated Environment</h3><div class="stage-stack"><strong>New Database</strong><span>↓</span><strong>Application</strong><span>↓</span><strong>Business Operations</strong></div><ul><li>Validated data</li><li>Monitoring enabled</li></ul></article>
          </div>
        </div>
      </section>

      <section class="section types-section" id="jenis-migrasi">
        <div class="container"><header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION SCOPE</span><h2>Jenis Migrasi Database yang Dapat Kami Bantu</h2><p>Pendekatan dan scope ditentukan setelah assessment kondisi source dan destination.</p></header><div class="types-grid">{migrationTypes.map((item, index) => <article class="info-card reveal" style={`animation-delay: ${index * 60}ms`}><span class="card-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.detail}</p><div class="tag-row">{item.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div></div>
      </section>

      <section class="section mapping-section">
        <div class="container split-layout"><div><span class="eyebrow"><span class="eyebrow-dot"></span> SCHEMA MAPPING</span><h2>Data Tidak Selalu Bisa Dipindahkan 1:1</h2><p>Struktur data pada source dan destination dapat berbeda. Migration dapat membutuhkan mapping, transformation, cleansing, dan penyesuaian relationship agar data sesuai dengan schema tujuan.</p><div class="mapping-note">Migration memindahkan data dengan konteks, bukan hanya menyalin file.</div></div><div class="mapping-visual"><div class="schema-box"><span>SOURCE</span><code>customer_name<br />phone<br />company<br />created_at</code></div><div class="mapping-bridge"><b>MAP</b><span>TRANSFORM</span><span>VALIDATE</span></div><div class="schema-box target"><span>DESTINATION</span><code>name<br />contact_number<br />organization<br />registered_date</code></div><div class="relation-chain"><span>customers</span><b>↕</b><span>orders</span><b>↕</b><span>payments</span></div></div></div>
      </section>

      <section class="section process-section" id="proses-migrasi">
        <div class="container"><header class="section-heading left-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> CONTROLLED WORKFLOW</span><h2>Bagaimana Proses Migrasi Database Dilakukan?</h2><p>Assess → Plan → Backup → Map → Migrate → Validate → Cutover → Monitor.</p></header><div class="process-strip">{processData.map(step => <article class="process-card"><span>{step.num}</span><small>{step.label}</small><h3>{step.title}</h3><p>{step.description}</p></article>)}</div></div>
      </section>

      <section class="section validation-section" id="validasi-data">
        <div class="container split-layout"><div><span class="eyebrow"><span class="eyebrow-dot"></span> DATA INTEGRITY</span><h2>Bagaimana Memastikan Data Hasil Migrasi Tetap Valid?</h2><p>Data divalidasi berdasarkan migration scope dan validation criteria yang disepakati, bukan berdasarkan klaim bahwa semua kondisi selalu identik.</p><div class="validation-stamp">VALIDATION<br /><strong>CHECKPOINT</strong></div></div><div class="check-grid">{validationItems.map((item, index) => <article><span>✓</span><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></div>
      </section>

      <section class="section backup-section">
        <div class="container"><header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> RECOVERY PLANNING</span><h2>Siapkan Backup dan Rollback Plan Sebelum Cutover</h2><p>Strategi backup dan rollback bergantung pada database engine, environment, data size, application architecture, dan toleransi downtime.</p></header><div class="backup-flow"><div><b>BACKUP</b><small>Salinan data</small></div><i>↓</i><div><b>MIGRATION</b><small>Transfer terencana</small></div><i>↓</i><div><b>VALIDATION</b><small>Checkpoint</small></div><i>↓</i><div><b>CUTOVER</b><small>Alih aplikasi</small></div><i>↓</i><div class="rollback"><b>IF ISSUE</b><small>Rollback / Recovery</small></div></div><div class="clarification"><strong>Backup ≠ Migration</strong><span>Backup menyiapkan recovery. Migration membuat data dapat digunakan di environment tujuan.</span></div></div>
      </section>

      <section class="section operations-section">
        <div class="container"><header class="section-heading left-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> OPERATIONAL CONTINUITY</span><h2>Migrasi Disesuaikan dengan Kebutuhan Operasional</h2><p>Metode migration dipilih berdasarkan kondisi sistem dan tolerance terhadap downtime.</p></header><div class="three-grid"><article class="approach-card"><span>01</span><h3>Offline Migration</h3><p>Service dihentikan sementara untuk proses migration. Cocok bila downtime dapat dijadwalkan.</p></article><article class="approach-card featured"><span>02</span><h3>Staged Migration</h3><p>Sebagian data dipindahkan lebih dulu, kemudian dilakukan synchronization dan cutover.</p></article><article class="approach-card"><span>03</span><h3>Low-Downtime Approach</h3><p>Digunakan ketika kebutuhan operasional membutuhkan downtime minimal dan architecture memungkinkan.</p></article></div></div>
      </section>

      <section class="section compatibility-section">
        <div class="container split-layout"><div><span class="eyebrow"><span class="eyebrow-dot"></span> APPLICATION AWARE</span><h2>Database Berubah, Aplikasi Tetap Harus Berjalan</h2><p>Database migration perlu mempertimbangkan aplikasi yang menggunakan database tersebut agar perubahan environment tidak memutus operasional.</p></div><div class="compat-visual"><div class="compat-node">APPLICATION</div><span>↓</span><div class="compat-node">CONNECTION</div><span>↓</span><div class="compat-node accent">NEW DATABASE</div><span>↓</span><div class="compat-node">QUERY / TRANSACTION</div></div></div><div class="container compatibility-list">{['Connection string', 'Credentials', 'Schema & datatype', 'SQL compatibility', 'ORM mapping', 'Indexes', 'Stored procedures bila relevan', 'API dependencies'].map(item => <span>✓ {item}</span>)}</div>
      </section>

      <section class="section architecture-section">
        <div class="container"><header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION ARCHITECTURE</span><h2>Bangun Jalur Migrasi yang Terstruktur</h2></header><div class="architecture-flow">{['SOURCE DB', 'BACKUP', 'MAPPING / TRANSFORM', 'TARGET DB', 'VALIDATION', 'APPLICATION'].map((item, index) => <div class="architecture-step"><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong>{index < 5 && <i>↓</i>}</div>)}</div></div>
      </section>

      <section class="section security-section">
        <div class="container"><header class="section-heading left-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> SECURITY CONSIDERATIONS</span><h2>Data Tetap Menjadi Prioritas Selama Proses Migrasi</h2><p>Kontrol akses dan handling data ditentukan sesuai sensitivitas serta kebutuhan environment project.</p></header><div class="security-grid">{securityItems.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div>
      </section>

      <section class="section compare-section" id="migrasi-vs-integrasi">
        <div class="container"><header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> CLARIFY THE DIFFERENCE</span><h2>Migrasi Database vs Integrasi Sistem: Apa Bedanya?</h2></header><div class="compare-grid"><article><span class="eyebrow">DATABASE MIGRATION</span><h3>Memindahkan data dan database environment dari A ke B.</h3><p>MySQL → PostgreSQL<br />On-Premise → Cloud<br />Old Server → New Server</p></article><article><span class="eyebrow">SYSTEM INTEGRATION</span><h3>Membuat dua sistem tetap terhubung dan bertukar data.</h3><p>CRM ↔ ERP<br />Website ↔ CRM<br />Payment ↔ Order System</p><a href="/jasa-integrasi-sistem/">Pelajari Jasa Integrasi Sistem →</a></article></div><div class="difference-line">Migrasi memindahkan data. Integrasi membuat sistem tetap terhubung.</div></div>
      </section>

      <section class="section stack-section">
        <div class="container split-layout"><div><span class="eyebrow"><span class="eyebrow-dot"></span> TECHNOLOGY & METHODS</span><h2>Teknologi Database yang Digunakan Sesuai Kebutuhan</h2><p>Engine dan metode dipilih berdasarkan kondisi database, target environment, data size, compatibility, serta kemampuan maintenance.</p></div><div class="stack-panel"><div><b>DATABASE ENGINES</b><span>MySQL</span><span>PostgreSQL</span><span>MariaDB</span><span>SQL Server</span><span>SQLite</span></div><div><b>MIGRATION METHODS</b><span>SQL & scripts</span><span>ETL</span><span>Dump & restore</span><span>Replication / synchronization</span></div></div></div>
      </section>

      <section class="section usecase-section">
        <div class="container"><header class="section-heading"><span class="eyebrow"><span class="eyebrow-dot"></span> USE CASES</span><h2>Contoh Kebutuhan Migrasi Database</h2></header><div class="three-grid"><article class="usecase-card"><b>01</b><h3>Legacy Database Upgrade</h3><p>Database lama dipindahkan ke environment yang lebih baru.</p></article><article class="usecase-card"><b>02</b><h3>Server Migration</h3><p>Database dipindahkan dari server lama ke server baru.</p></article><article class="usecase-card"><b>03</b><h3>Cloud Migration</h3><p>Database dipindahkan ke environment cloud sesuai assessment.</p></article><article class="usecase-card"><b>04</b><h3>Database Consolidation</h3><p>Beberapa database digabung ke environment yang lebih terpusat.</p></article><article class="usecase-card"><b>05</b><h3>Application Replatforming</h3><p>Database dipindahkan bersamaan dengan penyesuaian application environment.</p></article></div></div>
      </section>

      <section class="section impact-section">
