---
import BaseHead from '../../components/BaseHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WhyChoose from '../../components/WhyChoose.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE_TITLE } from '../../consts';

const migrationTypes = [
  { title: 'Database Engine Migration', detail: 'Penyesuaian struktur dan data antar engine seperti MySQL, PostgreSQL, MariaDB, SQL Server, atau SQLite sesuai hasil assessment.', tags: ['MySQL → PostgreSQL', 'MariaDB → MySQL'] },
  { title: 'Server & Cloud Migration', detail: 'Memindahkan database dari server lama ke server baru, on-premise ke cloud, atau antar environment cloud dengan rencana cutover yang jelas.', tags: ['On-Premise → Cloud', 'Server A → Server B'] },
  { title: 'Version Upgrade', detail: 'Meng-upgrade versi database sambil memeriksa compatibility, deprecated feature, extension, dan kebutuhan aplikasi.', tags: ['Old Version → New Version'] },
  { title: 'Schema Migration', detail: 'Memindahkan atau merestrukturisasi tabel, relationship, index, constraint, dan aturan data agar sesuai dengan schema tujuan.', tags: ['Schema Mapping', 'Relationship'] },
  { title: 'Data Consolidation', detail: 'Menggabungkan beberapa sumber data menjadi environment yang lebih terpusat dengan aturan cleansing dan deduplikasi.', tags: ['Multi-Source', 'Centralized Data'] },
  { title: 'Application-Database Migration', detail: 'Memindahkan database sekaligus menyesuaikan connection, query, ORM mapping, dan dependency aplikasi yang menggunakannya.', tags: ['Compatibility', 'Replatforming'] }
];

const problems = [
  { title: 'Risiko Data Tidak Sesuai', description: 'Column, datatype, relation, encoding, atau format dapat berbeda antara source dan destination.', icon: 'data' },
  { title: 'Aplikasi Tidak Kompatibel', description: 'Connection, query, ORM mapping, atau dependency aplikasi dapat terpengaruh setelah database berubah.', icon: 'app' },
  { title: 'Data Tidak Konsisten', description: 'Jumlah maupun isi data source dan destination perlu dibandingkan setelah proses migration.', icon: 'check' },
  { title: 'Downtime Mengganggu Operasional', description: 'Migration yang tidak direncanakan dapat menghentikan layanan dan menghambat proses bisnis.', icon: 'clock' },
  { title: 'Database Legacy', description: 'Struktur lama mungkin tidak lagi sesuai dengan kebutuhan aplikasi atau environment baru.', icon: 'legacy' }
];

const validationItems = [
  { title: 'Row Count', description: 'Membandingkan jumlah record pada source dan destination.' },
  { title: 'Data Integrity', description: 'Memeriksa relationship antar tabel dan referential integrity.' },
  { title: 'Data Type', description: 'Memastikan datatype sesuai dengan schema tujuan.' },
  { title: 'Missing Data', description: 'Mencari data yang hilang, terpotong, atau gagal di-import.' },
  { title: 'Constraints', description: 'Memvalidasi primary key, foreign key, unique constraint, dan aturan relevan.' },
  { title: 'Application Test', description: 'Memastikan aplikasi dapat membaca dan menulis data sesuai kebutuhan.' },
  { title: 'Business Validation', description: 'Memastikan data penting tetap dapat digunakan oleh tim operasional.' }
];

const securityItems = [
  { title: 'Access Control', description: 'Membatasi siapa yang dapat mengakses source, destination, dan proses migration.' },
  { title: 'Secure Connection', description: 'Menggunakan koneksi aman sesuai kemampuan dan kebijakan environment.' },
  { title: 'Credential Handling', description: 'Mengelola credential secara aman tanpa mengekspos secret di source code atau log.' },
  { title: 'Backup Protection', description: 'Melindungi backup berdasarkan sensitivitas data dan kebutuhan retention.' },
  { title: 'Validation & Logging', description: 'Mencatat proses, hasil validasi, dan issue sesuai kebutuhan project.' }
];

const processData = [
  { num: '01', label: 'ASSESS', title: 'Assess', description: 'Memahami source, destination, ukuran data, schema, dependency aplikasi, kebutuhan downtime, dan constraints operasional.', focus: 'DISCOVERY' },
  { num: '02', label: 'PLAN', title: 'Plan', description: 'Menentukan migration strategy, backup strategy, migration window, rollback plan, dan validation approach.', focus: 'STRATEGY' },
  { num: '03', label: 'BACKUP', title: 'Backup', description: 'Menyiapkan salinan data dan memastikan backup dapat digunakan sesuai skenario recovery yang disepakati.', focus: 'RECOVERY READINESS' },
  { num: '04', label: 'MAP', title: 'Map', description: 'Memetakan table, column, datatype, relationship, index, constraint, dan kebutuhan transformation.', focus: 'SCHEMA MAPPING' },
  { num: '05', label: 'MIGRATE', title: 'Migrate', description: 'Memindahkan struktur dan data ke environment tujuan menggunakan metode yang sesuai kondisi database.', focus: 'DATA TRANSFER' },
  { num: '06', label: 'VALIDATE', title: 'Validate', description: 'Memeriksa completeness, consistency, integrity, schema compatibility, dan application compatibility.', focus: 'QUALITY CONTROL' },
  { num: '07', label: 'CUTOVER', title: 'Cutover', description: 'Mengalihkan aplikasi ke database baru sesuai migration plan dan checklist operasional.', focus: 'GO-LIVE' },
  { num: '08', label: 'MONITOR', title: 'Monitor', description: 'Memantau environment setelah migration dan menangani issue yang muncul pada fase awal.', focus: 'STABILIZATION' }
];

const whyChooseData = [
  { id: '01', title: 'Structured Migration', description: 'Setiap migration dimulai dari assessment dan planning, bukan langsung memindahkan data.', label: 'STRUCTURED' },
  { id: '02', title: 'Data-Aware', description: 'Schema, relationship, datatype, transformation, dan integrity menjadi bagian dari perencanaan.', label: 'DATA-AWARE' },
  { id: '03', title: 'Application-Aware', description: 'Database dipahami bersama aplikasi, query, connection, dan dependency yang menggunakannya.', label: 'COMPATIBILITY' },
  { id: '04', title: 'Validation Focused', description: 'Data divalidasi berdasarkan migration scope dan criteria yang disepakati.', label: 'VALIDATION' },
  { id: '05', title: 'Risk Conscious', description: 'Backup, rollback, downtime, dan failure scenario dipertimbangkan sejak awal.', label: 'RISK-AWARE' },
  { id: '06', title: 'End-to-End', description: 'Assessment, planning, migration, testing, cutover, dan support berada dalam satu alur kerja.', label: 'END-TO-END' }
];

const faqData = [
  { id: '01', question: 'Apa itu migrasi database?', answer: 'Migrasi database adalah proses memindahkan data dan database environment dari environment lama ke environment baru dengan assessment, mapping, migration, validation, dan cutover yang terencana.' },
  { id: '02', question: 'Apa bedanya migrasi database dengan backup?', answer: 'Backup menyalin data untuk kebutuhan recovery. Migration memindahkan atau menyesuaikan data ke environment tujuan agar dapat digunakan di sana.' },
  { id: '03', question: 'Apa bedanya migrasi database dengan integrasi sistem?', answer: 'Migrasi memindahkan data dari satu environment ke environment lain. Integrasi sistem membuat dua sistem tetap terhubung dan bertukar data. Lihat juga layanan Jasa Integrasi Sistem Entercraft.' , hasLink: true, linkText: 'Lihat Jasa Integrasi Sistem →', linkUrl: '/jasa-integrasi-sistem/' },
  { id: '04', question: 'Database apa saja yang dapat dimigrasikan?', answer: 'Engine dan pendekatan ditentukan setelah melihat source, destination, ukuran data, schema, akses, dan kebutuhan aplikasi. Assessment diperlukan sebelum menentukan scope.' },
  { id: '05', question: 'Apakah bisa migrasi MySQL ke PostgreSQL?', answer: 'Bisa menjadi salah satu skenario yang kami bantu. Karena perbedaan datatype, query, function, dan constraint, pendekatan final ditentukan setelah assessment compatibility.' },
  { id: '06', question: 'Apakah bisa migrasi database ke cloud?', answer: 'Bisa untuk skenario yang sesuai, misalnya on-premise ke cloud atau cloud ke cloud. Provider, konfigurasi, keamanan, dan network perlu dievaluasi lebih dulu.' },
  { id: '07', question: 'Apakah aplikasi perlu diubah ketika database dipindahkan?', answer: 'Tergantung perubahan engine, schema, connection, query, ORM, dan dependency. Application compatibility selalu menjadi bagian dari validation dan testing.' },
  { id: '08', question: 'Apakah migrasi database membutuhkan downtime?', answer: 'Tidak selalu sama. Pilihannya dapat berupa offline migration, staged migration, atau pendekatan low-downtime jika architecture memungkinkan dan sesuai kebutuhan operasional.' },
  { id: '09', question: 'Bagaimana cara mengurangi risiko kehilangan data?', answer: 'Risiko diminimalkan melalui assessment, backup yang sesuai, mapping, migration rehearsal bila relevan, validation criteria, monitoring, dan rollback approach.' },
  { id: '10', question: 'Bagaimana proses backup sebelum migration?', answer: 'Backup strategy disusun berdasarkan engine, ukuran data, environment, retention, akses, dan recovery requirement. Backup kemudian diperiksa agar dapat digunakan sesuai rencana.' },
  { id: '11', question: 'Bagaimana memastikan data hasil migration tetap valid?', answer: 'Validasi dapat mencakup row count, integrity, datatype, missing data, constraint, application test, dan business validation sesuai scope yang disepakati.' },
  { id: '12', question: 'Bagaimana jika terjadi error saat migration?', answer: 'Issue ditangani berdasarkan failure scenario yang sudah direncanakan. Tim dapat melakukan troubleshooting, recovery, retry, atau rollback sesuai kondisi dan keputusan cutover.' },
  { id: '13', question: 'Apakah ada rollback plan?', answer: 'Rollback plan dapat disiapkan sebelum cutover. Bentuknya bergantung pada architecture, metode migration, backup, application dependency, dan toleransi downtime.' },
  { id: '14', question: 'Apakah bisa menggabungkan beberapa database?', answer: 'Database consolidation dapat dilakukan bila struktur, ownership data, mapping, deduplikasi, dan aturan sumber data telah dipahami melalui assessment.' },
  { id: '15', question: 'Berapa lama proses migrasi database?', answer: 'Timeline bergantung pada ukuran data, kompleksitas schema, jumlah dependency, metode migration, kebutuhan testing, dan migration window. Estimasi diberikan setelah scope dipahami.' },
  { id: '16', question: 'Berapa biaya jasa migrasi database?', answer: 'Biaya ditentukan oleh engine, volume data, kompleksitas transformation, kebutuhan downtime, testing, security, dan support. Konsultasi diperlukan untuk menyusun estimasi yang realistis.' }
];

const icon = (name: string) => {
  const paths: Record<string, string> = {
    data: 'M12 2v20M2 12h20M5 5l14 14M19 5L5 19',
    app: 'M5 2h14a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V4a2 2 0 012-2zM8 6h8M8 18h8',
    check: 'M4 12l5 5L20 6',
    clock: 'M12 8v4l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
    legacy: 'M3 7l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 17l9 4 9-4'
  };
  return paths[name] ?? paths.data;
};
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title="Jasa Migrasi Database Profesional untuk Bisnis | Entercraft" description="Jasa Migrasi Database untuk memindahkan data ke server, platform, atau database baru dengan mapping, validation, backup, dan cutover terstruktur." />
  </head>
  <body>
    <Navbar />
    <main>
      <section class="migration-hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-wrap">
          <!-- Left side: Copywriting -->
          <div class="hero-copy reveal">
            <span class="eyebrow"><span class="eyebrow-dot"></span> JASA MIGRASI DATABASE</span>
            <h1>Jasa Migrasi Database untuk Memindahkan Data dengan <span>Proses yang Terstruktur</span></h1>
            <p>Bantu bisnis memindahkan database ke server, platform, atau struktur baru dengan proses mapping, migration, validation, dan cutover yang direncanakan untuk meminimalkan risiko kehilangan data dan gangguan operasional.</p>
            <div class="hero-actions">
              <a href="/contact/" class="btn-primary">Konsultasikan Migrasi Database</a>
              <a href="#proses-migrasi" class="btn-secondary">Lihat Proses Migrasi</a>
            </div>
          </div>

          <!-- Right side: Visual Database Migration Flow -->
          <div class="migration-visual reveal" aria-label="Alur migrasi dari database lama ke database baru" style="transition-delay: 500ms;">
            <div class="migration-flow">
              
              <!-- Source Database Card -->
              <div class="flow-layer source-layer">
                <div class="flow-card">
                  <div class="card-icon red">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                      <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path>
                    </svg>
                  </div>
                  <div class="card-text">
                    <span class="layer-name">Source (Old Database)</span>
                    <span class="layer-detail">Legacy MySQL / Old Server</span>
                  </div>
                </div>
              </div>

              <div class="flow-arrow"><span class="arrow-dot animate-flow"></span></div>

              <!-- Processing / Conversion Core Card -->
              <div class="flow-layer core-layer">
                <div class="flow-card highlight">
                  <div class="card-icon blue">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
                      <circle cx="12" cy="12" r="4"/>
                    </svg>
                  </div>
                  <div class="card-text">
                    <span class="layer-name">Migration Pipeline</span>
                    <span class="layer-detail">Schema Mapping & Data Conversion</span>
                  </div>
                </div>
              </div>

              <div class="flow-arrow"><span class="arrow-dot animate-flow delay-1"></span></div>

              <!-- Split Process Column (Validation & Cutover) -->
              <div class="flow-split">
                
                <!-- Validation Node -->
                <div class="split-side">
                  <div class="flow-card mini">
                    <div class="card-icon gold">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                    <div class="card-text">
                      <span class="layer-name small">Data Validation</span>
                      <span class="layer-detail small">Row & Integrity Check</span>
                    </div>
                  </div>
                </div>

                <!-- Cutover Node -->
                <div class="split-side">
                  <div class="flow-card mini">
                    <div class="card-icon cyan">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                      </svg>
                    </div>
                    <div class="card-text">
                      <span class="layer-name small">Cutover Readiness</span>
                      <span class="layer-detail small">Live App Replatforming</span>
                    </div>
                  </div>
                </div>

              </div>

              <div class="flow-arrow"><span class="arrow-dot animate-flow delay-2"></span></div>

              <!-- Target Database Card -->
              <div class="flow-layer target-layer">
                <div class="flow-card target-highlight">
                  <div class="card-icon emerald">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                      <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path>
                    </svg>
                  </div>
                  <div class="card-text">
                    <span class="layer-name">Target (New Database)</span>
                    <span class="layer-detail">PostgreSQL / Cloud Target</span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>

      <section class="section problem-section" id="risiko-migrasi">
        <div class="container">
          <header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> RISK AWARENESS</span><h2>Migrasi Database Bukan Sekadar Memindahkan Data</h2><p>Perubahan database dapat memengaruhi struktur data, aplikasi, integrasi, dan operasional. Karena itu migration perlu direncanakan dari awal.</p></header>
          <div class="problem-grid">
            {problems.map((problem, index) => <article class="risk-card reveal" style={`transition-delay: ${index * 70}ms`}><div class="risk-icon"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={icon(problem.icon)} /></svg></div><span class="card-index">0{index + 1}</span><h3>{problem.title}</h3><p>{problem.description}</p></article>)}
          </div>
        </div>
      </section>

      <section class="section stages-section">
        <div class="container">
          <header class="section-heading left-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION STORY</span><h2>Dari Database Lama ke Environment Baru dengan Proses yang Terstruktur</h2><p>Setiap fase memiliki tujuan dan checkpoint agar keputusan migration dapat dipahami oleh business owner maupun technical evaluator.</p></header>
          <div class="stages-grid">
            <article class="stage-card before reveal" style="transition-delay: 100ms;"><span class="stage-label">BEFORE</span><h3>Legacy Environment</h3><div class="stage-stack"><strong>Legacy Database</strong><span>↓</span><strong>Old Server</strong><span>↓</span><strong>Old Application</strong></div><ul><li>Existing schema</li><li>Existing dependencies</li></ul></article>
            <article class="stage-card during reveal" style="transition-delay: 200ms;"><span class="stage-label">MIGRATION</span><h3>Controlled Process</h3><div class="mini-process">{['Assessment', 'Backup', 'Schema Mapping', 'Transformation', 'Migration', 'Validation', 'Testing', 'Cutover'].map((step, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{step}</span>)}</div></article>
            <article class="stage-card after reveal" style="transition-delay: 300ms;"><span class="stage-label">AFTER</span><h3>Updated Environment</h3><div class="stage-stack"><strong>New Database</strong><span>↓</span><strong>Application</strong><span>↓</span><strong>Business Operations</strong></div><ul><li>Validated data</li><li>Monitoring enabled</li></ul></article>
          </div>
        </div>
      </section>

      <section class="section types-section" id="jenis-migrasi">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION SCOPE</span><h2>Jenis Migrasi Database yang Dapat Kami Bantu</h2><p>Pendekatan dan scope ditentukan setelah assessment kondisi source dan destination.</p></header><div class="types-grid">{migrationTypes.map((item, index) => <article class="info-card reveal" style={`transition-delay: ${index * 60}ms`}><span class="card-index">0{index + 1}</span><h3>{item.title}</h3><p>{item.detail}</p><div class="tag-row">{item.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div></div>
      </section>

      <section class="section mapping-section">
        <div class="container split-layout"><div class="reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> SCHEMA MAPPING</span><h2>Data Tidak Selalu Bisa Dipindahkan 1:1</h2><p>Struktur data pada source dan destination dapat berbeda. Migration dapat membutuhkan mapping, transformation, cleansing, dan penyesuaian relationship agar data sesuai dengan schema tujuan.</p><div class="mapping-note">Migration memindahkan data dengan konteks, bukan hanya menyalin file.</div></div><div class="mapping-visual reveal" style="transition-delay: 200ms;"><div class="schema-box"><span>SOURCE</span><code>customer_name<br />phone<br />company<br />created_at</code></div><div class="mapping-bridge"><b>MAP</b><span>TRANSFORM</span><span>VALIDATE</span></div><div class="schema-box target"><span>DESTINATION</span><code>name<br />contact_number<br />organization<br />registered_date</code></div><div class="relation-chain"><span>customers</span><b>↕</b><span>orders</span><b>↕</b><span>payments</span></div></div></div>
      </section>

      <section class="section process-section" id="proses-migrasi">
        <div class="container"><header class="section-heading left-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> CONTROLLED WORKFLOW</span><h2>Bagaimana Proses Migrasi Database Dilakukan?</h2><p>Assess → Plan → Backup → Map → Migrate → Validate → Cutover → Monitor.</p></header><div class="process-strip">{processData.map((step, index) => <article class="process-card reveal" style={`transition-delay: ${index * 50}ms`}><span>{step.num}</span><small>{step.label}</small><h3>{step.title}</h3><p>{step.description}</p></article>)}</div></div>
      </section>

      <section class="section validation-section" id="validasi-data">
        <div class="container split-layout"><div class="reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> DATA INTEGRITY</span><h2>Bagaimana Memastikan Data Hasil Migrasi Tetap Valid?</h2><p>Data divalidasi berdasarkan migration scope dan validation criteria yang disepakati, bukan berdasarkan klaim bahwa semua kondisi selalu identik.</p><div class="validation-stamp">VALIDATION<br /><strong>CHECKPOINT</strong></div></div><div class="check-grid">{validationItems.map((item, index) => <article class="reveal" style={`transition-delay: ${index * 60}ms`}><span>✓</span><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div></div>
      </section>

      <section class="section backup-section">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> RECOVERY PLANNING</span><h2>Siapkan Backup dan Rollback Plan Sebelum Cutover</h2><p>Strategi backup dan rollback bergantung pada database engine, environment, data size, application architecture, dan toleransi downtime.</p></header><div class="backup-flow reveal" style="transition-delay: 200ms;"><div><b>BACKUP</b><small>Salinan data</small></div><i>↓</i><div><b>MIGRATION</b><small>Transfer terencana</small></div><i>↓</i><div><b>VALIDATION</b><small>Checkpoint</small></div><i>↓</i><div><b>CUTOVER</b><small>Alih aplikasi</small></div><i>↓</i><div class="rollback"><b>IF ISSUE</b><small>Rollback / Recovery</small></div></div><div class="clarification reveal" style="transition-delay: 300ms;"><strong>Backup ≠ Migration</strong><span>Backup menyiapkan recovery. Migration membuat data dapat digunakan di environment tujuan.</span></div></div>
      </section>

      <section class="section operations-section">
        <div class="container"><header class="section-heading left-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> OPERATIONAL CONTINUITY</span><h2>Migrasi Disesuaikan dengan Kebutuhan Operasional</h2><p>Metode migration dipilih berdasarkan kondisi sistem dan tolerance terhadap downtime.</p></header><div class="three-grid"><article class="approach-card reveal" style="transition-delay: 100ms;"><span>01</span><h3>Offline Migration</h3><p>Service dihentikan sementara untuk proses migration. Cocok bila downtime dapat dijadwalkan.</p></article><article class="approach-card featured reveal" style="transition-delay: 200ms;"><span>02</span><h3>Staged Migration</h3><p>Sebagian data dipindahkan lebih dulu, kemudian dilakukan synchronization dan cutover.</p></article><article class="approach-card reveal" style="transition-delay: 300ms;"><span>03</span><h3>Low-Downtime Approach</h3><p>Digunakan ketika kebutuhan operasional membutuhkan downtime minimal dan architecture memungkinkan.</p></article></div></div>
      </section>

      <section class="section compatibility-section">
        <div class="container split-layout"><div class="reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> APPLICATION AWARE</span><h2>Database Berubah, Aplikasi Tetap Harus Berjalan</h2><p>Database migration perlu mempertimbangkan aplikasi yang menggunakan database tersebut agar perubahan environment tidak memutus operasional.</p></div><div class="compat-visual reveal" style="transition-delay: 200ms;"><div class="compat-node">APPLICATION</div><span>↓</span><div class="compat-node">CONNECTION</div><span>↓</span><div class="compat-node accent">NEW DATABASE</div><span>↓</span><div class="compat-node">QUERY / TRANSACTION</div></div></div><div class="container compatibility-list reveal" style="transition-delay: 300ms;">{['Connection string', 'Credentials', 'Schema & datatype', 'SQL compatibility', 'ORM mapping', 'Indexes', 'Stored procedures bila relevan', 'API dependencies'].map(item => <span>✓ {item}</span>)}</div>
      </section>

      <section class="section architecture-section">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> MIGRATION ARCHITECTURE</span><h2>Bangun Jalur Migrasi yang Terstruktur</h2></header><div class="architecture-flow reveal" style="transition-delay: 200ms;">{['SOURCE DB', 'BACKUP', 'MAPPING / TRANSFORM', 'TARGET DB', 'VALIDATION', 'APPLICATION'].map((item, index) => <div class="architecture-step"><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong>{index < 5 && <i>↓</i>}</div>)}</div></div>
      </section>

      <section class="section security-section">
        <div class="container"><header class="section-heading left-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> SECURITY CONSIDERATIONS</span><h2>Data Tetap Menjadi Prioritas Selama Proses Migrasi</h2><p>Kontrol akses and handling data ditentukan sesuai sensitivitas serta kebutuhan environment project.</p></header><div class="security-grid">{securityItems.map((item, index) => <article class="reveal" style={`transition-delay: ${index * 80}ms`}><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div>
      </section>

      <section class="section compare-section" id="migrasi-vs-integrasi">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> CLARIFY THE DIFFERENCE</span><h2>Migrasi Database vs Integrasi Sistem: Apa Bedanya?</h2></header><div class="compare-grid"><article class="reveal" style="transition-delay: 100ms;"><span class="eyebrow">DATABASE MIGRATION</span><h3>Memindahkan data dan database environment dari A ke B.</h3><p>MySQL → PostgreSQL<br />On-Premise → Cloud<br />Old Server → New Server</p></article><article class="reveal" style="transition-delay: 200ms;"><span class="eyebrow">SYSTEM INTEGRATION</span><h3>Membuat dua sistem tetap terhubung dan bertukar data.</h3><p>CRM ↔ ERP<br />Website ↔ CRM<br />Payment ↔ Order System</p><a href="/jasa-integrasi-sistem/">Pelajari Jasa Integrasi Sistem →</a></article></div><div class="difference-line reveal" style="transition-delay: 300ms;">Migrasi memindahkan data. Integrasi membuat sistem tetap terhubung.</div></div>
      </section>

      <section class="section stack-section">
        <div class="container split-layout"><div class="reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> TECHNOLOGY & METHODS</span><h2>Teknologi Database yang Digunakan Sesuai Kebutuhan</h2><p>Engine dan metode dipilih berdasarkan kondisi database, target environment, data size, compatibility, serta kemampuan maintenance.</p></div><div class="stack-panel reveal" style="transition-delay: 200ms;"><div><b>DATABASE ENGINES</b><span>MySQL</span><span>PostgreSQL</span><span>MariaDB</span><span>SQL Server</span><span>SQLite</span></div><div><b>MIGRATION METHODS</b><span>SQL & scripts</span><span>ETL</span><span>Dump & restore</span><span>Replication / synchronization</span></div></div></div>
      </section>

      <section class="section usecase-section">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> USE CASES</span><h2>Contoh Kebutuhan Migrasi Database</h2></header><div class="three-grid">{[ { id: '01', t: 'Legacy Database Upgrade', d: 'Database lama dipindahkan ke environment yang lebih baru.' }, { id: '02', t: 'Server Migration', d: 'Database dipindahkan dari server lama ke server baru.' }, { id: '03', t: 'Cloud Migration', d: 'Database dipindahkan ke environment cloud sesuai assessment.' }, { id: '04', t: 'Database Consolidation', d: 'Beberapa database digabung ke environment yang lebih terpusat.' }, { id: '05', t: 'Application Replatforming', d: 'Database dipindahkan bersamaan dengan penyesuaian application environment.' } ].map((item, index) => <article class="usecase-card reveal" style={`transition-delay: ${index * 70}ms`}><b>{item.id}</b><h3>{item.t}</h3><p>{item.d}</p></article>)}</div></div>
      </section>

      <section class="section impact-section">
        <div class="container"><header class="section-heading left-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> BUSINESS IMPACT</span><h2>Migrasi Database Harus Memberikan Dampak yang Terukur bagi Operasional</h2></header><div class="impact-grid"><article class="reveal" style="transition-delay: 50ms;"><span>01</span><h3>Reduce Migration Risk</h3><p>Proses disusun berdasarkan kondisi source dan destination.</p></article><article class="reveal" style="transition-delay: 100ms;"><span>02</span><h3>Protect Data Integrity</h3><p>Data divalidasi setelah migration sesuai criteria.</p></article><article class="reveal" style="transition-delay: 150ms;"><span>03</span><h3>Minimize Disruption</h3><p>Strategy disesuaikan dengan kebutuhan downtime.</p></article><article class="reveal" style="transition-delay: 200ms;"><span>04</span><h3>Maintain Compatibility</h3><p>Perubahan database dipertimbangkan bersama aplikasi.</p></article><article class="reveal" style="transition-delay: 250ms;"><span>05</span><h3>Prepare for Growth</h3><p>Environment baru dapat menjadi fondasi pengembangan berikutnya.</p></article></div></div>
      </section>

      <section class="section portfolio-section">
        <div class="container"><header class="section-heading reveal"><span class="eyebrow"><span class="eyebrow-dot"></span> TECHNICAL EXAMPLE</span><h2>Migration Concept yang Menjelaskan Alur Nyata</h2><p>Visual ini adalah contoh teknis, bukan case study fiktif. Detail project, outcome, dan destination ditentukan berdasarkan kondisi klien.</p></header><div class="concept-flow reveal" style="transition-delay: 200ms;"><span><small>SOURCE</small>MySQL</span><i>↓</i><span><small>SCHEMA MAPPING</small>Data Transformation</span><i>↓</i><span><small>VALIDATION</small>Integrity Check</span><i>↓</i><span class="target"><small>DESTINATION</small>PostgreSQL</span></div></div>
      </section>

      <WhyChoose eyebrow="MENGAPA ENTERCRAFT" titleHtml="Mengapa Memilih Entercraft<br/>untuk Migrasi Database?" intro="Kami menggabungkan perhatian pada data, aplikasi, dan operasional agar migration dapat dijalankan dengan keputusan yang lebih terukur." valueProps={whyChooseData} />
      <HowWeWork eyebrow="MIGRATION METHOD" titleHtml="Move Data<br/>Without Losing Control" intro="Alur kerja kami menjaga agar assessment, backup, mapping, validation, cutover, dan monitoring memiliki checkpoint yang jelas." stepsData={processData} />
      <Faq eyebrow="FAQ JASA MIGRASI DATABASE" titleHtml="Frequently Asked Questions" intro="Jawaban realistis untuk pertanyaan bisnis dan teknis seputar database migration service." faqData={faqData} />
      <FinalCta eyebrow="MULAI DENGAN ASSESSMENT" titleHtml="Rencanakan Migrasi Database Anda<br/>dengan Lebih Terstruktur" intro="Ceritakan database yang sedang digunakan, target environment, ukuran data, kebutuhan downtime, dan kendala yang Anda hadapi. Kami akan membantu menentukan pendekatan migrasi yang sesuai." />
    </main>
    <Footer />

    <!-- Scroll Observer Script for Premium Entry Animations -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, { threshold: 0.05 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      });
    </script>
  </body>
</html>

<style>
