const faqData = [
  {
    id: "01",
    question: "Apa itu AI Chatbot?",
    answer: "AI Chatbot adalah asisten virtual yang didukung oleh kecerdasan buatan (seperti NLP dan LLM) untuk memahami percakapan natural dan merespons pertanyaan berdasarkan knowledge base bisnis."
  },
  {
    id: "02",
    question: "Apa bedanya AI Chatbot dengan chatbot biasa?",
    answer: "Chatbot biasa bekerja dengan aturan kaku (rule-based) dan hanya mengerti kata kunci tertentu. AI Chatbot dapat memahami bahasa natural, konteks percakapan, intensi pengguna, dan memberikan respons yang dinamis serta relevan tanpa template kaku."
  },
  {
    id: "03",
    question: "Apakah AI Chatbot bisa menggunakan data perusahaan?",
    answer: "Ya, kami membangun chatbot yang diintegrasikan dengan sumber data bisnis Anda (knowledge base), sehingga jawaban yang diberikan sesuai dengan informasi spesifik perusahaan Anda, bukan pengetahuan umum."
  },
  {
    id: "04",
    question: "Apakah chatbot bisa membaca dokumen atau PDF?",
    answer: "Tentu. Kami dapat melatih dan menghubungkan chatbot dengan berbagai format dokumen seperti PDF, SOP, katalog produk, atau halaman website agar chatbot bisa menarik informasi dari sana."
  },
  {
    id: "05",
    question: "Apakah AI Chatbot bisa menjawab pertanyaan tentang produk?",
    answer: "Bisa. Dengan menghubungkan chatbot ke katalog atau spesifikasi produk Anda, chatbot mampu menjelaskan fitur, perbedaan produk, hingga informasi harga kepada customer."
  },
  {
    id: "06",
    question: "Apakah chatbot dapat terhubung dengan CRM?",
    answer: "Ya, chatbot dapat diintegrasikan dengan sistem CRM yang Anda gunakan. Saat chatbot mengumpulkan data lead atau kualifikasi pelanggan, informasi tersebut akan langsung masuk ke dalam CRM."
  },
  {
    id: "07",
    question: "Apakah AI Chatbot bisa digunakan di WhatsApp?",
    answer: "Tentu, chatbot dapat dihubungkan ke WhatsApp Business API, website perusahaan, portal pelanggan, atau platform komunikasi internal."
  },
  {
    id: "08",
    question: "Apakah chatbot dapat meneruskan percakapan ke human agent?",
    answer: "Sangat bisa. Kami menerapkan fitur 'Human Handover'. Saat chatbot tidak bisa menjawab pertanyaan kompleks, atau pelanggan meminta berbicara dengan manusia, percakapan akan otomatis dialihkan ke tim Anda (sales/CS)."
  },
  {
    id: "09",
    question: "Apakah AI Chatbot dapat digunakan untuk internal perusahaan?",
    answer: "Tentu. Selain untuk customer, AI Chatbot sangat efektif digunakan secara internal (misalnya HR assistant atau Support IT) agar karyawan mudah mencari SOP, kebijakan, atau panduan kerja."
  },
  {
    id: "10",
    question: "Berapa lama proses pembuatan AI Chatbot?",
    answer: "Waktu pembuatan bervariasi tergantung pada kompleksitas data dan integrasi sistem. Secara umum, dari tahap discovery hingga pengujian dan deployment bisa memakan waktu mulai dari beberapa minggu."
  },
  {
    id: "11",
    question: "Berapa biaya jasa AI Chatbot?",
    answer: "Biaya bergantung pada cakupan (scope) pekerjaan, volume data knowledge base, channel yang digunakan, dan kompleksitas integrasi. Silakan hubungi kami untuk mendapatkan konsultasi dan estimasi biaya."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`Jasa AI Chatbot untuk Bisnis | ${SITE_TITLE}`} 
      description="Jasa AI Chatbot untuk membantu bisnis menjawab pertanyaan, mengelola lead, menyediakan informasi, dan menghubungkan chatbot dengan sistem bisnis." 
    />
  </head>
  <body>
    <Navbar />
    
    <main>
      <Hero />
      <Problem />
      <Capability />
      <DemoConversation />
      <UseCases />
      <KnowledgeBase />
      <KnowledgeExample />
      <Integration />
      <HumanHandover />
      <BusinessBenefits />
      <Channels />
      
      <WhyChoose 
        eyebrow="MENGAPA KAMI"
        titleHtml="Mengapa Memilih Entercraft<br/>untuk AI Chatbot?"
        intro="Kami memastikan AI Chatbot memberikan manfaat nyata dengan pendekatan yang berpusat pada pemahaman bisnis Anda."
        valueProps={whyChooseData}
      />
      
      <HowWeWork 
        eyebrow="WORKFLOW KAMI"
        titleHtml="Langkah Implementasi<br/>AI Chatbot"
        intro="Proses sistematis dari perencanaan hingga peluncuran agar chatbot Anda berfungsi optimal dan relevan."
        stepsData={howWeWorkData}
      />
      
      <Industries 
        industriesData={industriesData}
      />
      
      <Faq 
        eyebrow="FAQ AI CHATBOT"
        titleHtml="Frequently Asked Questions"
        intro="Temukan jawaban tentang bagaimana AI Chatbot kami dapat membantu efisiensi bisnis Anda."
        faqData={faqData}
      />
      
      <FinalCta 
        eyebrow="MULAI SEKARANG"
        titleHtml="Bangun AI Chatbot yang<br/>Memahami Bisnis Anda"
        intro="Ceritakan pertanyaan atau proses yang ingin Anda otomatisasi. Kami akan membantu menentukan knowledge, workflow, integrasi, dan channel yang sesuai dengan kebutuhan bisnis Anda."
        primaryText="Konsultasikan AI Chatbot Anda"
        primaryHref="/contact/"
        secondaryText="Hubungi Entercraft"
        secondaryHref="/contact/"
      />
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
    overflow-x: hidden;
  }
</style>
