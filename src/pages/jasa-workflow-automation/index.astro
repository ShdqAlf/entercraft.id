const faqData = [
  {
    id: "01",
    question: "Apa itu Workflow Automation?",
    answer: "Workflow Automation adalah penggunaan perangkat lunak untuk menjalankan tugas dan proses bisnis secara berurutan dan otomatis, menghubungkan sistem, data, dan orang (melalui approval/notifikasi) agar proses berjalan lebih cepat dan terstruktur."
  },
  {
    id: "02",
    question: "Apa bedanya Workflow Automation dengan AI Automation?",
    answer: "Workflow Automation berfokus pada logika pasti (jika X maka lakukan Y) untuk memindahkan data dan mengarahkan proses operasional. Sedangkan AI Automation menggunakan Kecerdasan Buatan untuk memproses data tak terstruktur, membuat keputusan prediktif, atau menganalisis teks kompleks."
  },
  {
    id: "03",
    question: "Proses bisnis apa saja yang bisa diotomatisasi?",
    answer: "Hampir semua proses yang repetitif dan berbasis aturan baku dapat diotomatisasi. Contohnya: entri data antar sistem, alur approval dokumen, pemrosesan pesanan, kualifikasi lead, dan pembuatan laporan (reporting)."
  },
  {
    id: "04",
    question: "Apakah Workflow Automation harus menggunakan AI?",
    answer: "Tidak. Sebagian besar proses inti operasional dapat berjalan sepenuhnya berbasis aturan baku (rule-based). AI hanya ditambahkan jika alur kerja memerlukan pemahaman konteks, seperti membaca dokumen atau mengekstraksi sentimen pengguna."
  },
  {
    id: "05",
    question: "Apakah workflow dapat terhubung dengan software yang sudah digunakan?",
    answer: "Sangat bisa. Kami merancang otomasi untuk mengintegrasikan perangkat lunak yang sudah Anda miliki (seperti CRM, ERP, atau Google Sheets) melalui API atau metode webhooks."
  },
  {
    id: "06",
    question: "Apakah workflow bisa memiliki approval bertingkat?",
    answer: "Bisa. Kami sering menerapkan alur persetujuan majemuk (misalnya: Supervisor -> Manager -> Finance) di mana proses baru akan berlanjut setelah semua pihak menyetujui, dan notifikasi akan dikirim jika ditolak."
  },
  {
    id: "07",
    question: "Bagaimana jika workflow menemukan kondisi yang tidak sesuai?",
    answer: "Kami merancang 'Exception Handling' (penanganan pengecualian). Jika sistem mendeteksi error atau data tidak standar, alur otomatis akan dihentikan sementara dan sistem akan memberitahu staf (human review) untuk melakukan penyesuaian manual."
  },
  {
    id: "08",
    question: "Apakah workflow dapat mengirim notifikasi otomatis?",
    answer: "Ya, pada setiap tahapan penting, sistem dapat memicu notifikasi yang dapat dikirimkan melalui email, WhatsApp, Slack, atau platform internal lainnya."
  },
  {
    id: "09",
    question: "Apakah workflow dapat terhubung dengan database?",
    answer: "Tentu. Workflow dapat dirancang untuk membaca data dari database SQL/NoSQL Anda, serta menulis atau memperbarui (update) data kembali setelah tahapan proses selesai."
  },
  {
    id: "10",
    question: "Apakah workflow bisa dikembangkan ketika bisnis bertambah besar?",
    answer: "Ya. Arsitektur yang kami buat sangat modular (scalable). Anda bisa menambahkan percabangan baru, integrasi perangkat lunak baru, atau menambah tingkat persetujuan kapan saja bisnis membutuhkannya."
  },
  {
    id: "11",
    question: "Berapa lama proses implementasi Workflow Automation?",
    answer: "Bergantung pada jumlah sistem yang harus dihubungkan dan kompleksitas alur kerja. Untuk alur sederhana biasanya memakan waktu beberapa minggu, sementara untuk integrasi skala enterprise bisa memerlukan waktu lebih lama."
  },
  {
    id: "12",
    question: "Berapa biaya jasa Workflow Automation?",
    answer: "Biaya dihitung berdasarkan kompleksitas proses (jumlah nodes/langkah), kerumitan integrasi API, dan seberapa besar pengujian yang diperlukan. Silakan konsultasi dengan tim kami untuk mendapatkan estimasi yang tepat."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title={`Jasa Workflow Automation untuk Bisnis | ${SITE_TITLE}`} 
      description="Jasa Workflow Automation untuk membantu bisnis mengotomatisasi proses kerja, approval, integrasi sistem, notifikasi, dan workflow operasional." 
    />
  </head>
  <body>
    <Navbar />
    
    <main>
      <Hero />
      <Problem />
      <BeforeAfter />
      <WhatCanBeAutomated />
      <DepartmentUseCases />
      <HowItWorks />
      <ApprovalAutomation />
      <MultiSystemIntegration />
      <AIinWorkflow />
      <ExceptionHandling />
      <BusinessBenefits />
      
      <WhyChoose 
        eyebrow="MENGAPA KAMI"
        titleHtml="Mengapa Memilih Entercraft<br/>untuk Workflow Automation?"
        intro="Pendekatan kami menitikberatkan pada perbaikan proses bisnis, menjamin solusi otomasi berjalan selaras dengan kebutuhan perusahaan, bukan sekadar gaya teknis."
        valueProps={whyChooseData}
      />
      
      <HowWeWork 
        eyebrow="WORKFLOW KAMI"
        titleHtml="Langkah Implementasi<br/>Otomatisasi Proses"
        intro="Metodologi kami dirancang untuk meminimalkan risiko operasional, memastikan sistem lama dan baru bekerja beriringan secara transparan."
        stepsData={howWeWorkData}
      />
      
      <Industries 
        industriesData={industriesData}
      />
      
      <Faq 
        eyebrow="FAQ WORKFLOW AUTOMATION"
        titleHtml="Frequently Asked Questions"
        intro="Cari tahu selengkapnya mengenai bagaimana otomatisasi terstruktur dapat menyederhanakan operasional Anda yang repetitif."
        faqData={faqData}
      />
      
      <FinalCta 
        eyebrow="MULAI SEKARANG"
        titleHtml="Ubah Proses Manual Menjadi<br/>Workflow yang Lebih Efisien"
        intro="Ceritakan proses bisnis yang masih melibatkan banyak input manual, approval, follow-up, atau perpindahan data. Kami akan membantu memetakan bagian yang dapat diotomatisasi."
        primaryText="Konsultasikan Workflow Anda"
        primaryHref="/contact/"
        secondaryText="Hubungi Entercraft"
        secondaryHref="/contact/"
      />
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
    overflow-x: hidden;
  }
</style>
