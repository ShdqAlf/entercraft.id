const faqData = [
  {
    id: "01",
    question: "Apa itu WhatsApp Automation?",
    answer: "WhatsApp Automation adalah penggunaan teknologi untuk mengelola percakapan WhatsApp secara otomatis, menghubungkannya dengan sistem bisnis lain, dan menjalankan alur kerja (workflow) tanpa memerlukan intervensi manual pada setiap pesan."
  },
  {
    id: "02",
    question: "Apa saja proses bisnis yang bisa diotomatisasi melalui WhatsApp?",
    answer: "Berbagai proses seperti customer service (menjawab FAQ), lead qualification, pengingat jadwal (booking & reminder), notifikasi pesanan, hingga alur kerja internal seperti persetujuan dokumen dapat diotomatisasi."
  },
  {
    id: "03",
    question: "Apakah WhatsApp Automation bisa digunakan untuk follow-up lead?",
    answer: "Tentu. Automation dapat diatur untuk mengirimkan pesan follow-up otomatis kepada lead yang belum merespons dalam periode waktu tertentu, membantu menjaga komunikasi secara konsisten."
  },
  {
    id: "04",
    question: "Apakah WhatsApp Automation dapat terhubung dengan CRM?",
    answer: "Ya, kami dapat menghubungkan WhatsApp dengan berbagai sistem CRM sehingga setiap interaksi, data lead, dan riwayat percakapan otomatis tercatat dalam sistem yang Anda gunakan."
  },
  {
    id: "05",
    question: "Apakah WhatsApp Automation bisa menggunakan AI?",
    answer: "Bisa. AI dapat diintegrasikan untuk memahami maksud (intent) dari pesan pelanggan, mengekstrak data penting, dan memberikan respons yang lebih natural, bukan sekadar balasan statis."
  },
  {
    id: "06",
    question: "Apakah WhatsApp Automation hanya untuk customer service?",
    answer: "Tidak. Selain customer service, automation ini sangat berguna untuk sales (lead handling, follow-up), operasional (notifikasi internal), marketing, dan berbagai fungsi bisnis lainnya."
  },
  {
    id: "07",
    question: "Apakah automation bisa terhubung dengan database atau sistem internal?",
    answer: "Tentu, WhatsApp dapat dihubungkan ke sistem internal Anda melalui API, sehingga data dari WhatsApp langsung masuk ke database, Google Sheets, ERP, atau aplikasi internal lainnya."
  },
  {
    id: "08",
    question: "Apakah WhatsApp Automation dapat menggunakan nomor WhatsApp bisnis yang sudah digunakan?",
    answer: "Biasanya kami merekomendasikan penggunaan WhatsApp Business API. Nomor bisnis Anda yang sudah ada dapat ditingkatkan menjadi nomor API, namun setelah beralih, pengelolaannya akan melalui platform API dan tidak lagi melalui aplikasi WhatsApp biasa di handphone."
  },
  {
    id: "09",
    question: "Berapa lama proses implementasi WhatsApp Automation?",
    answer: "Waktu implementasi sangat bergantung pada kompleksitas alur kerja. Pembuatan alur dasar bisa memakan waktu beberapa minggu, sementara integrasi penuh dengan AI dan sistem internal bisa membutuhkan waktu lebih lama."
  },
  {
    id: "10",
    question: "Berapa biaya jasa WhatsApp Automation?",
    answer: "Biaya bergantung pada skala proyek, fitur yang dibutuhkan, dan tingkat integrasi. Kami menyediakan konsultasi awal untuk memahami kebutuhan Anda sebelum merancang proposal dan estimasi biaya yang sesuai."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Jasa WhatsApp Automation untuk Bisnis | ${SITE_TITLE}`} description="Jasa WhatsApp Automation untuk membantu bisnis mengotomatiskan komunikasi, follow-up, customer service, dan workflow bisnis." />
  </head>
  <body>
    <Navbar />
    
    <main>
      <Hero />
      <Problem />
      <Solution />
      <WhatCanBeAutomated />
      <BeforeAfter />
      <UseCases />
      <AIPowered />
      <Integration />
      <BusinessBenefits />
      
      <WhyChoose 
        eyebrow="MENGAPA KAMI"
        titleHtml="Mengapa Memilih Entercraft<br/>untuk WhatsApp Automation?"
        intro="Kami bukan hanya technology provider. Kami adalah digital partner yang memahami masalah operasional bisnis Anda dan menghadirkan solusi otomasi yang terukur."
        valueProps={whyChooseData}
      />
      
      <HowWeWork 
        eyebrow="WORKFLOW KAMI"
        titleHtml="Bagaimana Kami Merancang<br/>Otomasi untuk Anda?"
        intro="Langkah sistematis untuk memastikan transisi operasional yang mulus dari manual ke otomatis, tanpa mengganggu produktivitas harian Anda."
        stepsData={howWeWorkData}
      />
      
      <Industries 
        industriesData={industriesData}
      />
      
      <Faq 
        eyebrow="FAQ WHATSAPP AUTOMATION"
        titleHtml="Frequently Asked Questions"
        intro="Temukan jawaban atas kekhawatiran umum sebelum Anda mulai beralih ke alur kerja otomatis bersama Entercraft.id."
        faqData={faqData}
      />
      
      <FinalCta 
        eyebrow="MULAI SEKARANG"
        titleHtml="Otomatiskan Proses Bisnis<br/>Anda melalui WhatsApp"
        intro="Ceritakan bagaimana bisnis Anda menggunakan WhatsApp saat ini. Kami akan membantu mengidentifikasi workflow yang dapat diotomatisasi dan diintegrasikan dengan sistem bisnis Anda."
      />
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 100%;
    overflow-x: hidden;
  }
</style>
