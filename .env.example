# ==========================================
# SERVER-SIDE VARIABLES (PRIVATE & SECURE)
# Tidak terekspos ke browser pengunjung
# ==========================================

# URL Webhook n8n untuk menerima data lead
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/entercraft-contact

# (Opsional) Token Header Secret jika Webhook n8n memvalidasi header X-Webhook-Secret
# N8N_WEBHOOK_SECRET=your-secret-token-here

# Secret Key Cloudflare Turnstile (dari Cloudflare Dashboard)
# Gunakan '1x0000000000000000000000000000000AA' untuk testing/development lokal (selalu lolos)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ==========================================
# CLIENT-SIDE VARIABLES (PUBLIC)
# Dibutuhkan oleh browser untuk menampilkan widget
# ==========================================

# Site Key Cloudflare Turnstile (Public)
# Gunakan '1x00000000000000000000AA' untuk testing/development lokal (selalu lolos)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
